# Admin deployment environment template.
# Copy this file to .env.prod or .env.test, then fill values.

SERVER_HOST=149.71.241.52
SERVER_USER=root
SERVER_PORT=2222
SERVER_DEPLOY_ROOT=/data/tg-admin

DEPLOY_DOMAIN=admin.telegramdownloadmedia.com
# 后端业务 API 根地址；build 时注入前端（VITE_API_BASE_URL），admin 直连后端，nginx 不再反代 /api/。
ADMIN_API_BASE_URL=https://tg-download-api.telegramdownloadmedia.com
REMOTE_NGINX_CONF=/usr/local/nginx/vhost/tg-admin.conf
NGINX_BIN=/usr/local/nginx/sbin/nginx

INSTALL_NGINX_CONF=1
SKIP_PUBLIC_VERIFY=0
SKIP_API_VERIFY=0

# Optional overrides:
# PUBLIC_VERIFY_URL=https://admin.telegramdownloadmedia.com/
# ADMIN_CAPTCHA_URL=https://tg-download-api.telegramdownloadmedia.com/api/admin/auth/captcha
