# 仅填写字面值，不使用变量引用或命令替换；此文件同时由 shell 和 Node 读取。
SERVER_HOST=8.216.50.123
SERVER_USER=root
SERVER_PORT=22
SSH_IDENTITY_FILE=
SERVER_DEPLOY_ROOT=/data/mapexporter-admin
DEPLOY_DOMAIN=admin9527.mapexporter.app
ADMIN_API_BASE_URL=https://api.mapexporter.app
REMOTE_NGINX_CONF=/usr/local/nginx/vhost/mapexporter-admin.conf
NGINX_BIN=/usr/local/sbin/nginx
NGINX_MAIN_CONF=/usr/local/nginx/conf/nginx.conf
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# 填写服务器上实际存在且覆盖 Admin 域名的证书路径，生产发布前必须填写。
TLS_CERTIFICATE=
TLS_CERTIFICATE_KEY=
INSTALL_NGINX_CONF=1
SKIP_PUBLIC_VERIFY=0
SKIP_API_VERIFY=0
