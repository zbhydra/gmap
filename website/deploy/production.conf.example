# 仅填写字面值，不使用变量引用或命令替换；此文件同时由 shell 和 Node 读取。
PUBLIC_SITE_URL=https://mapexporter.app
PUBLIC_API_BASE_URL=https://api.mapexporter.app
PUBLIC_SHARED_COOKIE_DOMAIN=mapexporter.app
PUBLIC_GOOGLE_CLIENT_ID=
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_ALI_SLS_PROJECT=
PUBLIC_ALI_SLS_HOST=
PUBLIC_ALI_SLS_ENDPOINT=
PUBLIC_ALI_SLS_LOGSTORE=
PUBLIC_ALI_SLS_TOPIC=mark-log
PUBLIC_ALI_SLS_ENABLED=false
EXTENSION_GOOGLE_OAUTH_CLIENT_ID=

DEPLOY_SERVER_HOST=8.216.50.123
DEPLOY_SERVER_PORT=22
DEPLOY_SERVER_USER=root
DEPLOY_SSH_IDENTITY_FILE=
DEPLOY_SERVER_ROOT=/data/mapexporter-web
DEPLOY_NGINX_REMOTE_CONF=/usr/local/nginx/vhost/mapexporter.conf
DEPLOY_NGINX_BIN=/usr/local/sbin/nginx
DEPLOY_NGINX_MAIN_CONF=/usr/local/nginx/conf/nginx.conf
DEPLOY_HTTP_PORT=80
DEPLOY_HTTPS_PORT=443
DEPLOY_API_UPSTREAM=http://127.0.0.1:9600
# 填写服务器上实际存在且覆盖官网域名的证书路径，生产发布前必须填写。
DEPLOY_TLS_CERTIFICATE=
DEPLOY_TLS_CERTIFICATE_KEY=
INDEXNOW_KEY=
