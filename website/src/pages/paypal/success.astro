---
/**
 * PayPal 支付回跳成功页（noindex）。
 *
 * SSR 渲染产品线中立的等待态文案；确认态由 paypal-return 轮询订单状态后
 * 按订单 product_class 切换订阅 / Credits 文案（载荷经 JSON script 注入）。
 */
import Layout from '../../layouts/Layout.astro'
import { getContent } from '../../i18n/content'

const t = getContent('en-US')
const copy = t.pages.account.paypalReturn
const copyJson = JSON.stringify(copy)
---

<Layout
  locale="en-US"
  title={`${copy.waitingTitle} | MapsGrab`}
  description={copy.waitingMessage}
  includeSoftwareApplicationSchema={false}
  robots="noindex, nofollow, noarchive"
>
  <div class="paypal-return-page" data-payment-return data-payment-return-state="waiting" data-paypal-return-page data-paypal-return-status="success">
    <section class="paypal-return-card" aria-live="polite">
      <img src="/payment-icons/paypal-monogram.png" alt="" aria-hidden="true" width="32" height="32" />
      <p class="kicker paypal-return-eyebrow">{copy.providerLabel}</p>
      <h1 data-paypal-return-title>{copy.waitingTitle}</h1>
      <p data-paypal-return-message>{copy.waitingMessage}</p>
    </section>
  </div>
  <script is:inline type="application/json" data-paypal-return-copy set:html={copyJson} />
</Layout>

<script>
  import { initPayPalReturnPage } from '../../components/credit-purchase/paypal-return'

  const root = document.querySelector<HTMLElement>('[data-paypal-return-page]')
  if (root) {
    initPayPalReturnPage({
      status: 'success',
      orderNo: root.dataset.paypalOrderNo || null
    })
  }
</script>

<style>
  .paypal-return-page {
    display: grid;
    min-height: 68vh;
    place-items: center;
    padding: calc(var(--nav-h) + var(--s-32)) 24px var(--s-20);
    background: var(--bg);
  }

  .paypal-return-card {
    width: min(620px, 100%);
    padding: var(--s-8);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    text-align: center;
  }

  .paypal-return-eyebrow {
    margin: 0 0 12px;
  }

  .paypal-return-card img {
    display: block;
    margin: 0 auto 10px;
  }

  [data-payment-return-state='confirmed'] .paypal-return-card {
    border-color: var(--ok);
  }

  [data-payment-return-state='failed'] .paypal-return-card {
    border-color: var(--bad);
  }

  .paypal-return-card h1 {
    margin: 0;
    color: var(--text);
    font-size: clamp(34px, 5vw, 54px);
    letter-spacing: -0.05em;
  }

  .paypal-return-card p:last-child {
    margin: 16px 0 0;
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.6;
  }

  @media (max-width: 560px) {
    .paypal-return-card {
      padding: var(--s-8) 20px;
    }

    .paypal-return-card h1 {
      font-size: var(--fs-h2);
    }
  }
</style>
