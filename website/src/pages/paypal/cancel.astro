---
import Layout from '../../layouts/Layout.astro'
import { getContent } from '../../i18n/content'

const t = getContent('en-US')
const copy = t.pages.account.paypalReturn
---

<Layout
  locale="en-US"
  title={`${copy.canceledTitle} | ${t.site.name}`}
  description={copy.canceledMetaDescription}
  includeSoftwareApplicationSchema={false}
  robots="noindex, nofollow, noarchive"
>
  <main class="paypal-return-page" data-paypal-return-page data-paypal-return-status="cancel">
    <section class="paypal-return-card">
      <p class="paypal-return-eyebrow">{copy.providerLabel}</p>
      <h1>{copy.canceledTitle}</h1>
      <p>{copy.canceledMessage}</p>
    </section>
  </main>
</Layout>

<script>
  import { initPayPalReturnPage } from '../../components/credit-purchase/paypal-return'

  const root = document.querySelector<HTMLElement>('[data-paypal-return-page]')
  if (root) {
    initPayPalReturnPage({
      status: 'cancel',
      orderNo: root.dataset.paypalOrderNo || null
    })
  }
</script>

<style>
  .paypal-return-page {
    display: grid;
    min-height: 68vh;
    place-items: center;
    padding: var(--space-24) 24px var(--space-16);
    background: var(--bg);
  }

  .paypal-return-card {
    width: min(620px, 100%);
    padding: var(--space-8);
    border: 1px solid var(--border);
    border-radius: var(--rounded-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    text-align: center;
  }

  .paypal-return-eyebrow {
    margin: 0 0 12px;
    color: var(--warn);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .paypal-return-card h1 {
    margin: 0;
    color: var(--text);
    font-size: clamp(34px, 5vw, 54px);
    letter-spacing: -0.05em;
  }

  .paypal-return-card p:last-child {
    margin: 16px 0 0;
    color: var(--text-2);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.6;
  }
</style>
