---
/**
 * 浏览器插件统一登录页。
 *
 * 流程：检查 website token → 未登录时打开公共登录弹窗 → 登录完成后通知插件换取
 * extension token → 收到插件确认后展示成功态、返回按钮和 10 秒倒计时。
 */
import AuthModal from '../components/auth/AuthModal.astro'
import Layout from '../layouts/Layout.astro'
import { content } from '../i18n/content'

const accountCopy = content['en-US'].pages.account
const authCopy = {
  sendingCode: accountCopy.auth.sendingCode,
  sendCodeSuccess: accountCopy.auth.sendCodeSuccess,
  continueWithGoogle: accountCopy.auth.continueWithGoogle,
  googleLoading: accountCopy.auth.googleLoading,
  enterEmailFirst: accountCopy.auth.enterEmailFirst,
  enterEmailAndCode: accountCopy.auth.enterEmailAndCode,
  sendCodeFailed: accountCopy.auth.sendCodeFailed,
  googleSignInFailed: accountCopy.auth.googleSignInFailed,
  googleClientMissing: accountCopy.auth.googleClientMissing,
  signInFailed: accountCopy.auth.signInFailed
}
---

<Layout
  locale="en-US"
  title="Extension Sign In | TG Downloader"
  description="Sign in to TG Downloader and sync your website session with the browser extension."
  includeSoftwareApplicationSchema={false}
  robots="noindex, nofollow, noarchive"
  includeAlternateLanguageLinks={false}
  includeLanguageSwitcher={false}
>
  <main class="extension-login-page" data-extension-login>
    <section class="extension-login-panel" aria-labelledby="extension-login-title">
      <div class="extension-login-heading">
        <p class="extension-login-eyebrow">Browser Extension</p>
        <h1 id="extension-login-title">Sign in to TG Downloader</h1>
      </div>

      <div class="extension-login-status" data-extension-login-status>
        <p class="extension-login-state" data-extension-login-state>Checking Session</p>
        <h2 data-extension-login-status-title>Checking website session...</h2>
        <p data-extension-login-status-text>
          Keep this window open while TG Downloader verifies your sign-in.
        </p>
        <p class="extension-login-email" data-extension-login-email hidden></p>
        <div class="extension-login-actions">
          <button
            type="button"
            class="extension-login-secondary"
            data-extension-login-retry
            hidden
          >
            Try again
          </button>
          <button type="button" class="extension-login-primary" data-extension-login-return hidden>
            Return to Telegram
          </button>
        </div>
      </div>
    </section>

    <script
      is:inline
      type="application/json"
      data-extension-login-auth-copy
      set:html={JSON.stringify(authCopy)}
    />
    <AuthModal copy={accountCopy} idPrefix="extension-login" />
  </main>
</Layout>

<script>
  import {
    DEFAULT_PUBLIC_GOOGLE_CLIENT_ID,
    EXTENSION_TOKEN_EXCHANGED_MESSAGE_TYPE,
    cancelGoogleRedirectPrompt,
    clearGoogleRedirectResult,
    clearStoredAccessToken,
    exchangeGoogleLoginCode,
    getCurrentUser,
    getStoredAccessToken,
    isEmailVerificationRequiredResponse,
    logGoogleAuthStage,
    loginWithEmailCode,
    notifyWebAuthChanged,
    readGoogleRedirectResult,
    renderGoogleRedirectButton,
    requestExtensionLoginReturn,
    requestGoogleRedirectPrompt,
    sendEmailCode,
    type GoogleLoginResponse,
    type GoogleRedirectPromptOptions,
    type HomepageUserInfo
  } from '../scripts/homepage/auth'
  import { isHomepageAuthFailure, type RequestContext } from '../scripts/homepage/api'
  import { ensureDeviceId } from '../scripts/homepage/device'
  import { createSendCodeCooldown } from '../scripts/homepage/sendCodeCooldown'
  import { showSiteToast } from '../scripts/site/toast'

  interface ExtensionLoginElements {
    /** 页面根节点。 */
    root: HTMLElement
    /** 已登录、同步中、错误状态区。 */
    statusPanel: HTMLElement
    /** 状态 eyebrow。 */
    state: HTMLElement
    /** 状态标题。 */
    statusTitle: HTMLElement
    /** 状态正文。 */
    statusText: HTMLElement
    /** 已登录邮箱。 */
    statusEmail: HTMLElement
    /** 重试或打开登录弹窗按钮。 */
    retryButton: HTMLButtonElement
    /** 登录成功后返回 Telegram 的按钮。 */
    returnButton: HTMLButtonElement
    /** 公共登录弹窗。 */
    authModal: HTMLElement
    /** 公共登录弹窗关闭按钮列表。 */
    authCloseButtons: HTMLButtonElement[]
    /** 公共登录弹窗错误文案。 */
    authError: HTMLElement
    /** 公共登录邮箱表单。 */
    authForm: HTMLFormElement
    /** 公共登录邮箱验证码区域。 */
    emailCodeArea: HTMLElement
    /** 公共登录邮箱继续按钮。 */
    emailContinueButton: HTMLButtonElement
    /** 公共登录邮箱入口容器。 */
    emailEntry: HTMLElement
    /** 公共登录邮箱入口按钮。 */
    emailEntryButton: HTMLButtonElement
    /** 公共登录 Google 按钮容器。 */
    googleLoginButton: HTMLElement
    /** 公共登录邮箱输入框。 */
    loginEmail: HTMLInputElement
    /** 公共登录验证码输入框。 */
    loginCode: HTMLInputElement
    /** 公共登录验证码发送按钮。 */
    sendCodeButton: HTMLButtonElement
    /** 公共登录验证码状态。 */
    sendCodeStatus: HTMLElement
    /** 公共登录提交按钮。 */
    loginSubmit: HTMLButtonElement
  }

  interface ExtensionLoginAuthCopy {
    /** 发送验证码中。 */
    sendingCode: string
    /** 验证码发送成功。 */
    sendCodeSuccess: string
    /** Google 按钮文案。 */
    continueWithGoogle: string
    /** Google 跳转中文案。 */
    googleLoading: string
    /** 邮箱必填错误。 */
    enterEmailFirst: string
    /** 邮箱和验证码必填错误。 */
    enterEmailAndCode: string
    /** 发送验证码失败。 */
    sendCodeFailed: string
    /** Google 登录失败。 */
    googleSignInFailed: string
    /** Google Client ID 缺失。 */
    googleClientMissing: string
    /** 邮箱登录失败。 */
    signInFailed: string
  }

  interface ExtensionTokenExchangeMessage {
    /** 插件 token 交换确认消息类型。 */
    type: typeof EXTENSION_TOKEN_EXCHANGED_MESSAGE_TYPE
    /** 是否已成功保存插件登录态。 */
    ok: boolean
    /** 失败时的可排查错误。 */
    message?: string
  }

  interface ExtensionTokenExchangeCandidate {
    /** 页面消息类型。 */
    type?: string
    /** token 交换是否成功。 */
    ok?: boolean
    /** 失败详情。 */
    message?: string
  }

  type PageMessageValue =
    | string
    | number
    | boolean
    | null
    | PageMessageRecord
    | readonly PageMessageValue[]

  interface PageMessageRecord {
    /** 页面消息字段。 */
    readonly [key: string]: PageMessageValue
  }

  const root = document.querySelector<HTMLElement>('[data-extension-login]')

  if (root) {
    void initExtensionLogin(root)
  }

  function queryElement<T extends HTMLElement>(rootElement: HTMLElement, selector: string): T {
    const element = rootElement.querySelector<T>(selector)
    if (!element) {
      throw new Error(`[extension-login] Missing page element: ${selector}`)
    }
    return element
  }

  function getElements(rootElement: HTMLElement): ExtensionLoginElements {
    return {
      root: rootElement,
      statusPanel: queryElement(rootElement, '[data-extension-login-status]'),
      state: queryElement(rootElement, '[data-extension-login-state]'),
      statusTitle: queryElement(rootElement, '[data-extension-login-status-title]'),
      statusText: queryElement(rootElement, '[data-extension-login-status-text]'),
      statusEmail: queryElement(rootElement, '[data-extension-login-email]'),
      retryButton: queryElement(rootElement, '[data-extension-login-retry]'),
      returnButton: queryElement(rootElement, '[data-extension-login-return]'),
      authModal: queryElement(rootElement, '[data-download-auth-modal]'),
      authCloseButtons: Array.from(
        rootElement.querySelectorAll<HTMLButtonElement>('[data-download-auth-close]')
      ),
      authError: queryElement(rootElement, '[data-download-auth-error]'),
      authForm: queryElement(rootElement, '[data-download-auth-form]'),
      emailCodeArea: queryElement(rootElement, '[data-download-email-code-area]'),
      emailContinueButton: queryElement(rootElement, '[data-download-continue-email]'),
      emailEntry: queryElement(rootElement, '[data-download-email-entry]'),
      emailEntryButton: queryElement(rootElement, '[data-download-email-entry-button]'),
      googleLoginButton: queryElement(rootElement, '[data-download-google-login]'),
      loginEmail: queryElement(rootElement, '[data-download-login-email]'),
      loginCode: queryElement(rootElement, '[data-download-login-code]'),
      sendCodeButton: queryElement(rootElement, '[data-download-send-code]'),
      sendCodeStatus: queryElement(rootElement, '[data-download-send-code-status]'),
      loginSubmit: queryElement(rootElement, '[data-download-login-submit]')
    }
  }

  function getAuthCopy(rootElement: HTMLElement): ExtensionLoginAuthCopy {
    const element = rootElement.querySelector<HTMLScriptElement>('[data-extension-login-auth-copy]')
    if (!element?.textContent) {
      throw new Error('[extension-login] Missing auth copy payload.')
    }
    return JSON.parse(element.textContent) as ExtensionLoginAuthCopy
  }

  function getGoogleClientId(): string {
    return import.meta.env.PUBLIC_GOOGLE_CLIENT_ID?.trim() || DEFAULT_PUBLIC_GOOGLE_CLIENT_ID
  }

  function formatError(prefix: string, error: Error | string): string {
    const message = error instanceof Error ? error.message : error
    return `${prefix}: ${message}`
  }

  function setHidden(element: HTMLElement, hidden: boolean): void {
    element.hidden = hidden
  }

  function setMessage(element: HTMLElement, message: string): void {
    element.textContent = message
    element.hidden = message.length === 0
  }

  function setStatusActions(
    elements: ExtensionLoginElements,
    options: {
      retry: boolean
      retryLabel?: string
      returnTelegram: boolean
    }
  ): void {
    elements.retryButton.hidden = !options.retry
    if (options.retryLabel) {
      elements.retryButton.textContent = options.retryLabel
    }
    elements.returnButton.hidden = !options.returnTelegram
  }

  function renderChecking(elements: ExtensionLoginElements, title: string, text: string): void {
    elements.statusPanel.dataset.status = 'pending'
    elements.state.textContent = 'Checking Session'
    elements.statusTitle.textContent = title
    elements.statusText.textContent = text
    elements.statusEmail.hidden = true
    setStatusActions(elements, { retry: false, returnTelegram: false })
  }

  function renderLoginRequired(elements: ExtensionLoginElements): void {
    elements.statusPanel.dataset.status = 'pending'
    elements.state.textContent = 'Sign In Required'
    elements.statusTitle.textContent = 'Sign in to continue'
    elements.statusText.textContent = 'Use the same TG Downloader login window as the website.'
    elements.statusEmail.hidden = true
    setStatusActions(elements, {
      retry: true,
      retryLabel: 'Sign in',
      returnTelegram: false
    })
  }

  function renderSynced(
    elements: ExtensionLoginElements,
    user: HomepageUserInfo,
    secondsRemaining: number
  ): void {
    elements.statusPanel.dataset.status = 'success'
    elements.state.textContent = 'Signed In'
    elements.statusTitle.textContent = 'Login successful'
    elements.statusText.textContent = `Extension token is ready. Click Return to Telegram, or this page will return automatically in ${secondsRemaining} seconds.`
    elements.statusEmail.textContent = user.email
    elements.statusEmail.hidden = false
    elements.returnButton.disabled = false
    elements.returnButton.textContent = `Return to Telegram (${secondsRemaining}s)`
    setStatusActions(elements, {
      retry: false,
      returnTelegram: true
    })
  }

  function renderVerificationError(elements: ExtensionLoginElements, message: string): void {
    elements.statusPanel.dataset.status = 'error'
    elements.state.textContent = 'Verification Failed'
    elements.statusTitle.textContent = 'Could not finish extension login'
    elements.statusText.textContent = message
    elements.statusEmail.hidden = true
    setStatusActions(elements, {
      retry: true,
      retryLabel: 'Try again',
      returnTelegram: false
    })
    showSiteToast(message, { type: 'error' })
  }

  function resetAuthModalToGoogleFirst(elements: ExtensionLoginElements): void {
    setMessage(elements.authError, '')
    setHidden(elements.authForm, true)
    setHidden(elements.emailEntry, false)
    setHidden(elements.emailCodeArea, true)
    setHidden(elements.loginSubmit, true)
    setHidden(elements.emailContinueButton, false)
    elements.sendCodeStatus.textContent = ''
  }

  function openEmailAuthForm(elements: ExtensionLoginElements): void {
    setHidden(elements.authForm, false)
    setHidden(elements.emailEntry, true)
    elements.loginEmail.focus()
  }

  function openCodeArea(elements: ExtensionLoginElements): void {
    setHidden(elements.authForm, false)
    setHidden(elements.emailEntry, true)
    setHidden(elements.emailCodeArea, false)
    setHidden(elements.loginSubmit, false)
    setHidden(elements.emailContinueButton, true)
  }

  function parseExtensionTokenExchangeMessage(
    event: MessageEvent<PageMessageValue>
  ): ExtensionTokenExchangeMessage | null {
    if (event.origin !== window.location.origin || event.source !== window) {
      return null
    }

    if (typeof event.data !== 'object' || event.data === null || Array.isArray(event.data)) {
      return null
    }

    const data = event.data as ExtensionTokenExchangeCandidate
    if (data.type !== EXTENSION_TOKEN_EXCHANGED_MESSAGE_TYPE || typeof data.ok !== 'boolean') {
      return null
    }

    return {
      type: EXTENSION_TOKEN_EXCHANGED_MESSAGE_TYPE,
      ok: data.ok,
      ...(typeof data.message === 'string' ? { message: data.message } : {})
    }
  }

  async function initExtensionLogin(rootElement: HTMLElement): Promise<void> {
    const elements = getElements(rootElement)
    const copy = getAuthCopy(rootElement)
    const sendCodeCooldown = createSendCodeCooldown(
      elements.sendCodeButton,
      elements.sendCodeButton.textContent?.trim() || 'Send again'
    )
    let deviceId = ''
    let token = getStoredAccessToken()
    let googleRedirectButtonRendered = false
    let returnCountdownTimer: number | null = null
    let returnRequested = false

    const stopReturnCountdown = (): void => {
      if (returnCountdownTimer === null) {
        return
      }
      window.clearInterval(returnCountdownTimer)
      returnCountdownTimer = null
    }

    const closeAuthModal = (): void => {
      cancelGoogleRedirectPrompt('Extension login auth modal closed.')
      setHidden(elements.authModal, true)
    }

    const ensureGoogleRedirectButtonRendered = (): void => {
      if (googleRedirectButtonRendered) {
        return
      }

      const clientId = getGoogleClientId()
      if (!clientId) {
        logGoogleAuthStage('error', 'extension_login_google_client_id_missing')
        setMessage(elements.authError, copy.googleClientMissing)
        return
      }

      try {
        renderGoogleRedirectButton(elements.googleLoginButton, clientId, {
          source: 'extension_login_google_button',
          label: copy.continueWithGoogle,
          loadingLabel: copy.googleLoading
        })
        googleRedirectButtonRendered = true
      } catch (error) {
        console.error(error)
        setMessage(elements.authError, error instanceof Error ? error.message : copy.googleSignInFailed)
      }
    }

    const buildRequestContext = (nextToken: string | null = token): RequestContext => ({
      deviceId,
      token: nextToken
    })

    const waitForExtensionTokenExchange = (): Promise<void> =>
      new Promise((resolve, reject) => {
        const retryIntervalMs = 800
        const timeoutId = window.setTimeout(() => {
          window.clearInterval(retryIntervalId)
          window.removeEventListener('message', handleMessage)
          reject(new Error('Extension did not confirm token exchange within 15 seconds.'))
        }, 15_000)
        const retryIntervalId = window.setInterval(() => {
          logGoogleAuthStage('info', 'extension_login_token_exchange_retry')
          notifyWebAuthChanged()
        }, retryIntervalMs)

        function finish(error?: Error): void {
          window.clearTimeout(timeoutId)
          window.clearInterval(retryIntervalId)
          window.removeEventListener('message', handleMessage)
          if (error) {
            reject(error)
            return
          }
          resolve()
        }

        function handleMessage(event: MessageEvent): void {
          const message = parseExtensionTokenExchangeMessage(event)
          if (!message) {
            return
          }
          if (!message.ok) {
            finish(
              new Error(
                message.message || 'Extension rejected the website token exchange request.'
              )
            )
            return
          }
          finish()
        }

        window.addEventListener('message', handleMessage)
        logGoogleAuthStage('info', 'extension_login_token_exchange_request')
        notifyWebAuthChanged()
      })

    const completeLoginWithToken = async (nextToken: string): Promise<void> => {
      token = nextToken
      closeAuthModal()
      renderChecking(
        elements,
        'Syncing extension token...',
        'TG Downloader is exchanging your website session for an extension token.'
      )

      let user: HomepageUserInfo
      try {
        user = await getCurrentUser(buildRequestContext(nextToken))
      } catch (error) {
        console.error(error)
        if (error instanceof Error && isHomepageAuthFailure(error)) {
          clearStoredAccessToken()
          token = null
          openAuthModal()
          return
        }
        renderVerificationError(
          elements,
          formatError(
            'Website token verification failed',
            error instanceof Error ? error : String(error)
          )
        )
        return
      }

      try {
        await waitForExtensionTokenExchange()
        startReturnCountdown(user)
      } catch (error) {
        console.error(error)
        renderVerificationError(
          elements,
          formatError(
            'Extension token exchange failed',
            error instanceof Error ? error : String(error)
          )
        )
      }
    }

    const requestReturnToTelegram = (): void => {
      if (returnRequested) {
        return
      }
      returnRequested = true
      stopReturnCountdown()
      elements.returnButton.disabled = true
      elements.returnButton.textContent = 'Returning...'
      requestExtensionLoginReturn()
      window.setTimeout(() => {
        window.close()
      }, 120)
    }

    const startReturnCountdown = (user: HomepageUserInfo): void => {
      stopReturnCountdown()
      returnRequested = false
      let secondsRemaining = 10
      renderSynced(elements, user, secondsRemaining)

      returnCountdownTimer = window.setInterval(() => {
        secondsRemaining -= 1
        if (secondsRemaining <= 0) {
          requestReturnToTelegram()
          return
        }
        renderSynced(elements, user, secondsRemaining)
      }, 1000)
    }

    const runGoogleLogin = async (options: GoogleRedirectPromptOptions = {}): Promise<void> => {
      const clientId = getGoogleClientId()
      if (!clientId) {
        setMessage(elements.authError, copy.googleClientMissing)
        return
      }

      try {
        await requestGoogleRedirectPrompt(clientId, buildRequestContext(token), {
          ...options,
          onCredentialLogin: handleGoogleCredentialLogin
        })
      } catch (error) {
        if (!options.silentFailure) {
          console.error(error)
          setMessage(elements.authError, error instanceof Error ? error.message : copy.googleSignInFailed)
        }
      }
    }

    const openAuthModal = (): void => {
      stopReturnCountdown()
      returnRequested = false
      renderLoginRequired(elements)
      resetAuthModalToGoogleFirst(elements)
      setHidden(elements.authModal, false)
      ensureGoogleRedirectButtonRendered()
      void runGoogleLogin({ silentFailure: true, source: 'extension_login_auto_prompt' })
    }

    const handleGoogleCredentialLogin = async (
      response: GoogleLoginResponse,
      credentialSource: string
    ): Promise<void> => {
      logGoogleAuthStage('info', 'extension_login_google_one_tap_backend_response', {
        credentialSource,
        requiresEmailVerification: isEmailVerificationRequiredResponse(response)
      })

      if (isEmailVerificationRequiredResponse(response)) {
        openAuthModal()
        openEmailAuthForm(elements)
        elements.loginEmail.value = response.email
        elements.loginCode.value = ''
        elements.sendCodeStatus.textContent = copy.sendCodeSuccess
        openCodeArea(elements)
        sendCodeCooldown.start()
        return
      }

      await completeLoginWithToken(response.access_token)
    }

    const validateStoredToken = async (): Promise<void> => {
      stopReturnCountdown()
      token = getStoredAccessToken()
      if (!token) {
        openAuthModal()
        return
      }

      renderChecking(
        elements,
        'Checking website session...',
        'TG Downloader is verifying the website token stored in this browser.'
      )

      try {
        await completeLoginWithToken(token)
      } catch (error) {
        console.error(error)
        renderVerificationError(
          elements,
          formatError(
            'GET /api/client/auth/me failed while checking the extension login page',
            error instanceof Error ? error : String(error)
          )
        )
      }
    }

    const handleGoogleRedirect = async (): Promise<boolean> => {
      const result = readGoogleRedirectResult()
      if (!result) {
        return false
      }

      clearGoogleRedirectResult()
      if (result.emailVerificationEmail) {
        openAuthModal()
        openEmailAuthForm(elements)
        elements.loginEmail.value = result.emailVerificationEmail
        elements.loginCode.value = ''
        elements.sendCodeStatus.textContent = copy.sendCodeSuccess
        openCodeArea(elements)
        sendCodeCooldown.start()
        return true
      }

      if (result.error || !result.code) {
        openAuthModal()
        setMessage(
          elements.authError,
          formatError('Google sign-in failed', result.error || 'missing google_login_code')
        )
        return true
      }

      renderChecking(
        elements,
        'Finishing Google sign-in...',
        'TG Downloader is exchanging the Google sign-in result for a website session.'
      )

      try {
        const response = await exchangeGoogleLoginCode(result.code, buildRequestContext(token))
        await completeLoginWithToken(response.access_token)
      } catch (error) {
        console.error(error)
        if (error instanceof Error && isHomepageAuthFailure(error)) {
          clearStoredAccessToken()
          token = null
        }
        openAuthModal()
        setMessage(
          elements.authError,
          formatError(
            'Google sign-in could not complete',
            error instanceof Error ? error : String(error)
          )
        )
      }

      return true
    }

    const handleSendCode = async (): Promise<void> => {
      const email = elements.loginEmail.value.trim()
      if (!email) {
        setMessage(elements.authError, copy.enterEmailFirst)
        return
      }

      setMessage(elements.authError, '')
      elements.sendCodeButton.disabled = true
      elements.emailContinueButton.disabled = true
      elements.sendCodeStatus.textContent = copy.sendingCode

      try {
        await sendEmailCode(email, buildRequestContext(token))
        elements.sendCodeStatus.textContent = copy.sendCodeSuccess
        openCodeArea(elements)
        sendCodeCooldown.start()
      } catch (error) {
        console.error(error)
        setMessage(elements.authError, error instanceof Error ? error.message : copy.sendCodeFailed)
        elements.sendCodeStatus.textContent = ''
        sendCodeCooldown.reset()
      } finally {
        if (!sendCodeCooldown.isActive()) {
          elements.sendCodeButton.disabled = false
        }
        elements.emailContinueButton.disabled = false
      }
    }

    const handleEmailLogin = async (): Promise<void> => {
      const email = elements.loginEmail.value.trim()
      const code = elements.loginCode.value.trim()
      if (!email || !code) {
        setMessage(elements.authError, copy.enterEmailAndCode)
        return
      }

      setMessage(elements.authError, '')
      elements.loginSubmit.disabled = true

      try {
        const response = await loginWithEmailCode(email, code, buildRequestContext(token))
        await completeLoginWithToken(response.access_token)
      } catch (error) {
        console.error(error)
        if (error instanceof Error && isHomepageAuthFailure(error)) {
          clearStoredAccessToken()
          token = null
        }
        setMessage(elements.authError, error instanceof Error ? error.message : copy.signInFailed)
      } finally {
        elements.loginSubmit.disabled = false
      }
    }

    elements.retryButton.addEventListener('click', () => {
      if (!token) {
        openAuthModal()
        return
      }
      void validateStoredToken()
    })
    elements.returnButton.addEventListener('click', requestReturnToTelegram)
    elements.authCloseButtons.forEach(button => {
      button.addEventListener('click', () => {
        closeAuthModal()
        renderLoginRequired(elements)
      })
    })
    elements.emailEntryButton.addEventListener('click', () => {
      cancelGoogleRedirectPrompt('Email code login selected in extension login page.')
      openEmailAuthForm(elements)
    })
    elements.emailContinueButton.addEventListener('click', () => {
      void handleSendCode()
    })
    elements.sendCodeButton.addEventListener('click', () => {
      void handleSendCode()
    })
    elements.authForm.addEventListener('submit', event => {
      event.preventDefault()
      void handleEmailLogin()
    })

    renderChecking(
      elements,
      'Preparing sign-in...',
      'TG Downloader is preparing the website session check.'
    )
    deviceId = await ensureDeviceId()

    const handledRedirect = await handleGoogleRedirect()
    if (!handledRedirect) {
      await validateStoredToken()
    }
  }
</script>

