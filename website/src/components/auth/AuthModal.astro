---
import type { AccountContent } from '../../i18n/schema'

const { copy, skinClass = '', idPrefix = 'download' } = Astro.props as {
  copy: AccountContent
  skinClass?: string
  idPrefix?: string
}
const authModalClass = ['download-auth-modal', skinClass].filter(Boolean).join(' ')
const titleId = `${idPrefix}-auth-title`
---

<div class={authModalClass} data-download-auth-modal hidden>
  <button
    type="button"
    class="download-auth-backdrop"
    data-download-auth-close
    aria-label={copy.auth.closeLabel ?? 'Close'}
  ></button>

  <div class="download-auth-dialog" role="dialog" aria-modal="true" aria-labelledby={titleId}>
    <div class="download-auth-heading">
      <p class="download-auth-eyebrow">{copy.auth.eyebrow}</p>
      <h2 id={titleId}>{copy.auth.modalTitle ?? copy.auth.title}</h2>
      {copy.auth.modalDescription && <p>{copy.auth.modalDescription}</p>}
    </div>

    <button
      type="button"
      class="download-auth-close"
      data-download-auth-close
      aria-label={copy.auth.closeLabel ?? 'Close'}
    >
      <span aria-hidden="true">×</span>
    </button>

    <div
      class="download-google-button"
      data-download-google-login
      aria-label={copy.auth.continueWithGoogle}
    ></div>

    <form class="download-auth-form" data-download-auth-form hidden>
      <label class="download-field">
        <span class="download-field-label">{copy.auth.emailLabel}</span>
        <input
          type="email"
          autocomplete="email"
          class="download-input"
          placeholder={copy.auth.emailPlaceholder}
          data-download-login-email
        />
      </label>

      <button
        type="button"
        class="download-secondary-button download-continue-email-button"
        data-download-continue-email
      >
        {copy.auth.continueWithEmail}
      </button>

      <div class="download-email-code-area" data-download-email-code-area hidden>
        <label class="download-field">
          <span class="download-field-label">{copy.auth.codeLabel}</span>
          <div class="download-code-row">
            <input
              type="text"
              inputmode="numeric"
              autocomplete="one-time-code"
              class="download-input download-code-input"
              placeholder={copy.auth.codePlaceholder}
              data-download-login-code
            />
            <button
              type="button"
              class="download-secondary-button download-send-code-button"
              data-download-send-code
            >
              {copy.auth.sendAgain}
            </button>
          </div>
        </label>

        <button type="submit" class="download-primary-button" data-download-login-submit hidden>
          {copy.auth.signIn}
        </button>
      </div>

      <p
        class="download-inline-status"
        data-download-send-code-status
        role="status"
        aria-live="polite"
      ></p>
    </form>

    <div class="download-auth-footer" data-download-email-entry>
      <span>{copy.auth.or}</span>
      <button type="button" class="download-email-link" data-download-email-entry-button>
        {copy.auth.continueWithEmail}
      </button>
    </div>
    <p class="download-auth-terms">
      {copy.auth.termsNotice}
      {' '}
      <a href="/terms">{copy.auth.termsLink}</a>
      <span aria-hidden="true"> · </span>
      <a href="/privacy">{copy.auth.privacyLink}</a>
    </p>
    <p class="download-inline-error" data-download-auth-error role="alert" hidden></p>
  </div>
</div>

<style is:global>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .download-field {
    display: grid;
    gap: var(--space-2);
  }

  .download-auth-heading {
    display: grid;
    gap: var(--space-2);
    margin-bottom: 22px;
    padding-right: var(--space-16);
  }

  .download-auth-heading h2 {
    margin: 0;
    color: var(--text);
    font-size: 24px;
    line-height: 1.08;
  }

  .download-auth-heading p {
    margin: 0;
    max-width: 34ch;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.6;
  }

  .download-auth-eyebrow {
    width: max-content;
    padding: 6px var(--space-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--rounded-full);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    color: var(--primary) !important;
    font-size: 11px !important;
    font-weight: 800;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .download-auth-form,
  .download-email-code-area {
    display: grid;
    gap: 16px;
  }

  .download-code-row {
    display: flex;
    align-items: stretch;
    gap: 12px;
  }

  .download-field-label {
    color: var(--text-2);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .download-input {
    width: 100%;
    min-height: 58px;
    padding: 0 20px;
    border: 1px solid var(--border-strong);
    border-radius: var(--rounded-sm);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    color: var(--text);
    font-size: 16px;
  }

  .download-input:focus {
    outline: 3px solid var(--ring);
    border-color: var(--border-strong);
    background: var(--surface);
  }

  .download-code-input {
    min-width: 0;
  }

  .download-primary-button,
  .download-secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 58px;
    padding: 0 22px;
    border-radius: var(--rounded-full);
    font-size: 15px;
    font-weight: 800;
    transition: all var(--transition-normal);
  }

  .download-primary-button {
    color: var(--primary-fg);
    background: var(--primary);
    box-shadow: var(--shadow-card);
  }

  .download-primary-button:hover {
    transform: translateY(-1px);
  }

  .download-secondary-button {
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-card);
  }

  .download-secondary-button:hover {
    border-color: var(--border-strong);
    color: var(--primary);
  }

  .download-continue-email-button {
    color: var(--primary-fg);
    background: var(--primary);
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card);
  }

  .download-continue-email-button:hover {
    color: var(--primary-fg);
    border-color: var(--primary);
    transform: translateY(-1px);
    box-shadow: var(--shadow-card);
  }

  .download-google-button {
    width: 100%;
    min-height: 54px;
    margin-bottom: var(--space-4);
    display: grid;
  }

  .google-oauth-button {
    width: 100%;
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 0 var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--rounded-full);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    color: var(--text);
    font-size: 15px;
    font-weight: 800;
    transition:
      transform var(--transition-normal),
      border-color var(--transition-normal),
      box-shadow var(--transition-normal);
  }

  .google-oauth-button:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-card);
    transform: translateY(-1px);
  }

  .google-oauth-button:disabled {
    cursor: wait;
    opacity: 0.72;
    transform: none;
  }

  .google-oauth-button-icon {
    width: 20px;
    height: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    line-height: 0;
  }

  .download-primary-button:disabled,
  .download-secondary-button:disabled {
    cursor: not-allowed;
    opacity: 0.64;
    transform: none;
  }

  .download-send-code-button {
    min-height: 54px;
    padding: 0 var(--space-4);
    white-space: nowrap;
    flex-shrink: 0;
    width: auto;
  }

  .download-inline-status,
  .download-inline-error,
  .download-auth-terms {
    min-height: 20px;
    font-size: 13px;
  }

  .download-inline-status {
    color: var(--text-2);
  }

  .download-inline-error {
    color: var(--bad);
  }

  .download-auth-terms {
    margin: 0;
    color: var(--text-2);
    line-height: 1.5;
  }

  .download-auth-terms a {
    color: var(--text);
    font-weight: 700;
  }

  .download-auth-footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: 13px;
    line-height: 1.5;
  }

  .download-email-link {
    min-height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--primary);
    cursor: pointer;
    font: inherit;
    font-weight: 800;
  }

  .download-email-link:hover {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .download-auth-modal[hidden],
  .download-auth-form[hidden],
  .download-auth-footer[hidden],
  .download-email-code-area[hidden],
  .download-primary-button[hidden],
  .download-continue-email-button[hidden] {
    display: none;
  }

  .download-auth-modal {
    position: fixed;
    inset: 0;
    z-index: 130;
    display: grid;
    place-items: center;
    padding: 20px;
  }

  .download-auth-backdrop {
    position: absolute;
    inset: 0;
    background: var(--overlay);
  }

  .download-auth-dialog {
    position: relative;
    width: min(520px, 100%);
    padding: var(--space-8) var(--space-6) 24px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--rounded-lg);
    background: var(--surface);
    box-shadow: var(--shadow-modal);
  }

  .download-auth-close {
    width: 40px;
    height: 40px;
    position: absolute;
    top: 18px;
    right: 18px;
    border-radius: var(--rounded-full);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    color: var(--text);
    font-size: 24px;
    line-height: 1;
    box-shadow: var(--shadow-card);
  }

  @media (max-width: 720px) {
    .download-auth-modal {
      padding: 14px;
    }

    .download-auth-dialog {
      padding: var(--space-8) var(--space-4) 20px;
      border-radius: var(--rounded-lg);
    }

    .download-auth-heading h2 {
      font-size: 24px;
    }

    .download-primary-button,
    .download-secondary-button,
    .download-google-button {
      width: 100%;
    }

    .download-code-row {
      flex-wrap: wrap;
    }

    .download-send-code-button {
      width: 100%;
    }
  }
</style>
