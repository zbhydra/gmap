---
/**
 * 站级登录弹窗装配（全站唯一一份，由 Layout 渲染）。
 *
 * 复用 AuthModal 的 HTML/CSS 和 homepage auth runtime；外层只注入站级
 * controller 所需的精简文案 payload。导航登录、Pricing 待购与 Dashboard
 * 工作区共用同一个弹窗实例和会话。
 */
import AuthModal from './AuthModal.astro'
import type { AccountContent } from '../../i18n/schema'

const { copy } = Astro.props as {
  copy: AccountContent
}
const authCopy = {
  sendingCode: copy.auth.sendingCode,
  sendCodeSuccess: copy.auth.sendCodeSuccess,
  continueWithGoogle: copy.auth.continueWithGoogle,
  googleLoading: copy.auth.googleLoading,
  enterEmailFirst: copy.auth.enterEmailFirst,
  enterEmailAndCode: copy.auth.enterEmailAndCode,
  sendCodeFailed: copy.auth.sendCodeFailed,
  googleSignInFailed: copy.auth.googleSignInFailed,
  googleClientMissing: copy.auth.googleClientMissing,
  signInFailed: copy.auth.signInFailed
}
---

<div data-site-auth-root>
  <script
    is:inline
    type="application/json"
    data-site-auth-copy
    set:html={JSON.stringify(authCopy)}
  />
  <AuthModal copy={copy} />
</div>

<script>
  import { mountSiteAuthController } from './site-auth-controller'

  // Layout 是本组件的唯一装配点；客户端脚本只在浏览器执行。
  const root = document.querySelector<HTMLElement>('[data-site-auth-root]')
  if (root) {
    mountSiteAuthController(root)
  }
</script>
