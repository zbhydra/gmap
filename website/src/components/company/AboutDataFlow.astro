---
/**
 * About「How data moves」（设计稿 about.html ④，恒暗主题岛）：Maps 页面 → 浏览器（本地）→ 后端四类用途。
 *
 * 内容与隐私政策口径一致；设计稿里的可选 Drive / HubSpot 节点按 013 A10 不展示。
 * 连线由 about-wires.ts 按节点位置绘制，光点方向即数据方向（下发 / 往返 / 上报）；
 * ≤1080px 纵向堆叠，节点之间改为短竖线 + 下落光点。
 */
import type { AboutPageContent } from '../../company/companyContent'
import type { Locale } from '../../i18n/content'
import { localePaths } from '../../i18n/ui'
import AccentHeading from '../product/AccentHeading.astro'
import Icon from '../site/Icon.astro'
import './about-wires.css'

interface Props {
  locale: Locale
  dataFlow: AboutPageContent['dataFlow']
}

const { locale, dataFlow } = Astro.props
const { source, browser, backend, never } = dataFlow
const prefix = localePaths[locale] ? `/${localePaths[locale]}` : ''
const BROWSER_ICONS = ['settings', 'table', 'layers'] as const
/** 与 backend.lanes 同序：in = 后端下发、out = 浏览器上报、both = 往返。 */
const LANES = [
  { icon: 'settings', color: '--accent', direction: 'in' },
  { icon: 'user', color: '--primary', direction: 'both' },
  { icon: 'at', color: '--cyan', direction: 'both' },
  { icon: 'chart', color: '--star', direction: 'out' }
] as const
const MAP_PINS = [
  { x: 24, y: 38, delay: 0 },
  { x: 62, y: 30, delay: 0.5 },
  { x: 46, y: 70, delay: 1 },
  { x: 80, y: 64, delay: 1.5 }
]
---

<section class="section about-data scheme-dark has-deco" id="data" data-inview>
  <div class="deco" aria-hidden="true">
    <div class="bg-grid about-data-grid"></div>
    <div class="about-data-glow"></div>
    <div class="noise"></div>
  </div>
  <div class="container">
    <header class="section-head" data-stagger="80">
      <span class="kicker" data-reveal>{dataFlow.kicker}</span>
      <h2 class="h2" data-split><AccentHeading title={dataFlow.title} accentClass="text-grad" /></h2>
      <p class="lead" data-reveal>{dataFlow.lead}</p>
    </header>

    <div class="flow" data-flow data-reveal="rise">
      <svg class="wires" data-wires data-reveal="fade" data-reveal-delay="350" aria-hidden="true"></svg>

      <div class="flow-col flow-source">
        <span class="flow-label mono">{source.label}</span>
        <div class="flow-card flow-maps" data-node="maps">
          <span class="mini-map" aria-hidden="true">
            <i class="mm-road mm-road--h"></i><i class="mm-road mm-road--v"></i><i class="mm-water"></i>
            {MAP_PINS.map(pin => <i class="mm-pin" style={`--x: ${pin.x}%; --y: ${pin.y}%; --d: ${pin.delay}s`}></i>)}
          </span>
          <b>{source.title}</b>
          <span>{source.text}</span>
        </div>
      </div>

      <div class="flow-col flow-local">
        <span class="flow-label mono">{browser.label}</span>
        <div class="flow-card flow-browser" data-node="browser">
          <span class="fb-bar"><span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="fb-url mono">{browser.storage}</span></span>
          <ul class="fb-list" role="list">
            {browser.rows.map((row, index) => <li><Icon name={BROWSER_ICONS[index]} />{row}</li>)}
          </ul>
          <span class="badge badge--ok fb-badge"><Icon name="lock" />{browser.badge}</span>
        </div>
      </div>

      <div class="flow-col flow-server">
        <span class="flow-label mono">{backend.label}</span>
        <ul class="flow-card flow-lanes" role="list" data-node="backend">
          {backend.lanes.map((lane, index) => (
            <li data-lane={LANES[index].direction} style={`--lc: var(${LANES[index].color})`}>
              <span class="lane-icon"><Icon name={LANES[index].icon} /></span>
              <span><b>{lane.title}</b><small>{lane.text}</small></span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="never" data-reveal>
      <span class="never-label mono">{never.label}</span>
      <ul class="never-list" role="list">
        {never.items.map(item => <li><Icon name="x" />{item}</li>)}
      </ul>
    </div>

    <p class="flow-note" data-reveal>
      {dataFlow.note}
      <a class="link-arrow" href={`${prefix}/privacy/`} data-cta="about-data-privacy">{dataFlow.noteLink}<Icon name="arrow-right" /></a>
    </p>
  </div>
</section>

<script>
  import { boxIn, setupWires, type Wire, type WirePulse } from './about-wires'

  // Maps → 浏览器；浏览器 → 后端四类用途（data-lane：in 下发 / out 上报 / both 往返，光点颜色取该用途的 --lc）
  const flow = document.querySelector<HTMLElement>('[data-flow]')
  const node = (key: string) => flow?.querySelector<HTMLElement>(`[data-node="${key}"]`)
  const [maps, browser, backend] = [node('maps'), node('browser'), node('backend')]
  if (flow && maps && browser && backend) {
    setupWires(flow, () => {
      const source = boxIn(maps, flow)
      const local = boxIn(browser, flow)
      const server = boxIn(backend, flow)
      const out = [local.x + local.w, local.y + local.h / 2] as const
      const wires: Wire[] = [
        {
          from: [source.x + source.w, source.y + source.h / 2],
          to: [local.x, local.y + local.h / 2],
          pulses: [{ color: 'var(--cyan)', delay: 0, duration: 3 }]
        }
      ]
      backend.querySelectorAll<HTMLElement>('[data-lane]').forEach((lane, index) => {
        const box = boxIn(lane, flow)
        const color = lane.style.getPropertyValue('--lc')
        const pulses: WirePulse[] = []
        if (lane.dataset.lane !== 'in') pulses.push({ color, delay: 0.5 + index * 0.4, duration: 3.2 })
        if (lane.dataset.lane !== 'out') pulses.push({ color, reverse: true, delay: 1.8 + index * 0.4, duration: 3.2 })
        wires.push({ from: out, to: [server.x, box.y + box.h / 2], pulses })
      })
      return { wires, dots: [...wires.map(wire => wire.to), wires[0].from, out] }
    })
  }
</script>

<style>
  .about-data {
    overflow: hidden;
  }

  .about-data-grid {
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 58%, var(--mask-solid) 20%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 60% at 50% 58%, var(--mask-solid) 20%, transparent 75%);
  }

  .about-data-glow {
    position: absolute;
    top: 58%;
    left: 50%;
    width: min(1100px, 90vw);
    height: 70%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--primary) 22%, transparent), transparent);
    translate: -50% -50%;
  }

  .flow {
    position: relative;
    display: grid;
    grid-template-areas: 'source local server';
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1fr) minmax(0, 1.12fr);
    align-items: center;
    gap: 40px clamp(64px, 7.5vw, 96px);
    margin-top: clamp(48px, 6vw, 80px);
  }

  .flow-source {
    grid-area: source;
  }

  .flow-local {
    grid-area: local;
  }

  .flow-server {
    grid-area: server;
  }

  .flow-col {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 10px;
  }

  .flow-label {
    color: var(--text-2);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .flow-card {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow-md), var(--hairline-hl);
  }

  .flow-maps {
    display: grid;
    gap: 6px;
    padding: 12px 12px 16px;
  }

  .flow-maps b {
    padding: 8px 4px 0;
    color: var(--text);
    font-size: 15px;
    font-weight: 650;
  }

  .flow-maps > span:last-child {
    padding: 0 4px;
    color: var(--text-2);
    font-size: 13px;
    line-height: 1.5;
  }

  .mini-map {
    position: relative;
    display: block;
    height: 112px;
    overflow: hidden;
    border-radius: var(--r-sm);
    background: var(--map-land);
  }

  .mm-road {
    position: absolute;
    background: var(--map-road);
    box-shadow: 0 0 0 1px var(--map-road-casing);
  }

  .mm-road--h {
    top: 58%;
    right: 0;
    left: 0;
    height: 6px;
  }

  .mm-road--v {
    top: 0;
    bottom: 0;
    left: 36%;
    width: 6px;
  }

  .mm-water {
    position: absolute;
    top: -34px;
    right: -26px;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--map-water);
  }

  /* 迷你地图 pin：缩小的水滴 pin，上下轻跳 */
  .mm-pin {
    position: absolute;
    top: var(--y);
    left: var(--x);
    width: 16px;
    height: 18px;
    translate: -50% -100%;
    animation: float-y 3s var(--ease-in-out) infinite;
    animation-delay: var(--d, 0s);
  }

  .mm-pin::before {
    position: absolute;
    top: 0;
    left: 1px;
    width: 14px;
    height: 14px;
    border-radius: 50% 50% 50% 0;
    background: var(--pin);
    box-shadow: var(--shadow-pin);
    transform: rotate(-45deg);
    content: '';
  }

  .mm-pin::after {
    position: absolute;
    top: 4px;
    left: 5px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--pin-dot);
    content: '';
  }

  .flow-browser {
    overflow: hidden;
  }

  .fb-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
  }

  .fb-bar .win-dots i {
    width: 9px;
    height: 9px;
  }

  .fb-url {
    overflow: hidden;
    color: var(--text-2);
    font-size: 10.5px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .fb-list {
    display: grid;
    gap: 6px;
    padding: 12px;
    list-style: none;
  }

  .fb-list li {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 10px;
    border-radius: var(--r-xs);
    background: var(--surface-2);
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
  }

  .fb-list :global(.icon) {
    width: 15px;
    height: 15px;
    color: var(--primary-text);
  }

  .fb-badge {
    margin: 0 12px 12px;
  }

  .fb-badge :global(.icon) {
    width: 12px;
    height: 12px;
  }

  .flow-lanes {
    display: grid;
    padding: 6px;
    list-style: none;
  }

  .flow-lanes li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 10px;
  }

  .flow-lanes li + li {
    border-top: 1px solid var(--border);
  }

  .lane-icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    flex-shrink: 0;
    border-radius: var(--r-sm);
    background: color-mix(in srgb, var(--lc) 16%, transparent);
    color: var(--lc);
  }

  .lane-icon :global(.icon) {
    width: 16px;
    height: 16px;
  }

  .flow-lanes b {
    display: block;
    color: var(--text);
    font-size: 14px;
    font-weight: 650;
  }

  .flow-lanes small {
    display: block;
    margin-top: 2px;
    color: var(--text-3);
    font-size: 12px;
    line-height: 1.45;
  }

  .never {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: clamp(40px, 5vw, 64px);
    padding: 18px 22px;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: color-mix(in srgb, var(--surface) 65%, transparent);
  }

  .never-label {
    padding: 4px 10px;
    border-radius: var(--r-xs);
    background: var(--bad-soft);
    color: var(--bad);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .never-list {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    gap: 8px 22px;
    padding: 0;
    list-style: none;
  }

  .never-list li {
    display: inline-flex;
    align-items: flex-start;
    gap: 8px;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.5;
  }

  .never-list :global(.icon) {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--bad);
    stroke-width: 2.2;
  }

  .flow-note {
    margin-top: 22px;
    color: var(--text-3);
    font-size: 13.5px;
    text-align: center;
  }

  .flow-note .link-arrow {
    margin-left: 8px;
    font-size: 13.5px;
  }

  @media (max-width: 1080px) {
    /* 纵向堆叠，连线改为节点之间的短竖线 + 下落光点 */
    .flow {
      grid-template-areas: 'source' 'local' 'server';
      grid-template-columns: minmax(0, 1fr);
      max-width: 560px;
      margin-inline: auto;
      row-gap: 64px;
    }

    .flow .wires {
      display: none;
    }

    .flow-local::before,
    .flow-server::before {
      position: absolute;
      top: -54px;
      left: 50%;
      width: 2px;
      height: 44px;
      background: color-mix(in srgb, var(--text) 18%, transparent);
      translate: -50% 0;
      content: '';
    }

    .flow-local::after,
    .flow-server::after {
      position: absolute;
      top: -54px;
      left: 50%;
      width: 6px;
      height: 12px;
      border-radius: var(--r-2xs);
      background: var(--cyan);
      box-shadow: 0 0 10px var(--cyan);
      translate: -50% 0;
      animation: flow-drop 3s var(--ease-in-out) infinite;
      content: '';
    }
  }

  @keyframes flow-drop {
    0% {
      opacity: 0;
      transform: translateY(0);
    }

    20%,
    80% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translateY(32px);
    }
  }

  @media (max-width: 640px) {
    .never {
      flex-direction: column;
      align-items: flex-start;
    }

    .never-list {
      flex-direction: column;
      gap: 10px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-local::after,
    .flow-server::after {
      display: none;
    }
  }
</style>
