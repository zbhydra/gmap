---
/**
 * Pricing 页面 DOM 壳（三产品类别 tab 版）。
 *
 * Online / Extension / API 三条产品类别各一个 tab；SSR 静态渲染全部档位卡，
 * 付费卡购买按钮由 pricing-page-controller.ts 接支付配置后启用。tab 切换与
 * 升级资格派生在 controller 内完成；账户摘要、退出与渠道管理已迁 Dashboard
 * 订阅页，本页只负责套餐比较、购买与升级（匿名购买在原页打开 Layout 装配的
 * 站级登录弹窗）。支付流程交给公共 OrderCheckoutModal，避免本页维护第二套
 * 支付弹窗和订单轮询。
 */
import OrderCheckoutModal from '../order-checkout/OrderCheckoutModal.astro'
import type { AccountContent, PricingPageContent, PricingTabId } from '../../i18n/schema'

interface Props {
  copy: PricingPageContent
  accountCopy: AccountContent
  faqLabel: string
  /** 各 tab Free 卡引导落地页路径（键为 PricingTabId）。 */
  freeCtaPaths: Record<PricingTabId, string>
}

const { copy, accountCopy, faqLabel, freeCtaPaths } = Astro.props as Props
const tabIds: PricingTabId[] = ['online', 'extension', 'api']
---

<section
  class="pricing-page"
  data-pricing-page
>
  {/* popupBlocked 单键复用：checkout 支付窗口被拦截时共用 AccountContent 的文案 */}
  <script
    is:inline
    type="application/json"
    data-pricing-copy
    set:html={JSON.stringify({ ...copy, popupBlocked: accountCopy.creditPurchase.popupBlocked })}
  />

  <div class="container pricing-container">
    <header class="pricing-hero">
      <p class="pricing-hero-eyebrow">{copy.hero.eyebrow}</p>
      <h1 class="pricing-hero-title" data-pricing-hero-title>{copy.hero.title}</h1>
      <p class="pricing-hero-description" data-pricing-hero-description>{copy.hero.description}</p>
    </header>

    <section class="pricing-plans" aria-labelledby="pricing-plans-title">
      <h2 id="pricing-plans-title" class="visually-hidden">{copy.hero.title}</h2>

      <div class="pricing-tabs" role="tablist" aria-label={copy.hero.eyebrow}>
        {
          tabIds.map((tabId, index) => (
            <button
              type="button"
              class="pricing-tab"
              role="tab"
              id={`pricing-tab-${tabId}`}
              data-pricing-tab={tabId}
              aria-selected={index === 0 ? 'true' : 'false'}
              aria-controls={`pricing-panel-${tabId}`}
            >
              {copy.tabLabels[tabId]}
            </button>
          ))
        }
      </div>

      {
        tabIds.map((tabId, index) => {
          const tab = copy.tabs[tabId]
          return (
            <div
              class="pricing-panel"
              role="tabpanel"
              id={`pricing-panel-${tabId}`}
              data-pricing-panel={tabId}
              aria-labelledby={`pricing-tab-${tabId}`}
              hidden={index !== 0}
            >
              <header class="pricing-panel-header">
                <p class="eyebrow">{tab.eyebrow}</p>
                <h3>{tab.title}</h3>
                <p class="section-description">{tab.description}</p>
              </header>
              <div class="plans-grid">
                {tab.cards.map(card => (
                  <article
                    class:list={['plan-card', { 'plan-card-featured': card.featured }]}
                    data-plan-card={card.productId ?? card.id}
                  >
                    {card.featured && <p class="plan-badge">{copy.popularLabel}</p>}
                    <h4 class="plan-name">{card.name}</h4>
                    <p class="plan-tagline">{card.tagline}</p>
                    <p class="plan-price-row">
                      <span class="plan-price">{card.price}</span>
                      <span class="plan-period">{card.periodLabel}</span>
                    </p>
                    <p class="plan-quota">{card.quota}</p>
                    {card.status === 'free' || !card.productId ? (
                      <a
                        class="plan-button plan-button-secondary"
                        href={freeCtaPaths[tabId]}
                        data-cta={`pricing-free-${tabId}`}
                      >
                        {card.ctaLabel}
                      </a>
                    ) : (
                      <button
                        type="button"
                        class="plan-button plan-button-primary"
                        data-pricing-buy={card.productId}
                        data-ga-event="upgrade_cta_click"
                        data-ga-source="pricing"
                        data-ga-location="plan_card"
                        data-ga-plan={card.productId}
                        disabled
                      >
                        {card.ctaLabel}
                      </button>
                    )}
                    <p class="pricing-inline-error" data-plan-error={card.productId ?? card.id} hidden />
                    <ul class="plan-features">
                      {card.features.map(feature => (
                        <li>
                          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M4.5 12.5 9.8 17.8 19.5 6.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
                          </svg>
                          <span>{feature}</span>
                        </li>
                      ))}
                    </ul>
                  </article>
                ))}
              </div>
              <p class="plan-quota-note">{tab.quotaNote}</p>
            </div>
          )
        })
      }

      <p class="pricing-inline-status" data-pricing-plans-status>{copy.plans.loading}</p>
    </section>

    <section class="pricing-faq" data-pricing-faq aria-labelledby="pricing-faq-title">
      <header class="section-header">
        <p class="eyebrow">{faqLabel}</p>
        <h2 id="pricing-faq-title">{copy.faq.title}</h2>
        {copy.faq.description && <p class="section-description">{copy.faq.description}</p>}
      </header>
      <div class="pricing-faq-list">
        {copy.faq.items.map(item => (
          <details class="pricing-faq-item" data-pricing-faq-item>
            <summary class="pricing-faq-question">
              <span>{item.question}</span>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M6 9.5 12 15.5 18 9.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </summary>
            <p class="pricing-faq-answer">{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </div>

  <OrderCheckoutModal copy={accountCopy} />
</section>

<script>
  import './pricing-page-controller'
</script>

<style>
  .pricing-page {
    padding: clamp(28px, 4vw, var(--space-10)) 0 var(--space-8);
  }

  .pricing-container {
    display: grid;
    gap: var(--space-10);
  }

  .pricing-container,
  .pricing-plans,
  .plans-grid,
  .plan-card {
    min-width: 0;
  }

  /* ---------- Hero ---------- */
  .pricing-hero {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  .pricing-hero-eyebrow {
    color: var(--text-3);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .pricing-hero-title {
    max-width: 720px;
    font-size: clamp(32px, 5vw, 44px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-wrap: balance;
  }

  .pricing-hero-description {
    max-width: 620px;
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.65;
    text-wrap: balance;
  }

  .section-header {
    display: grid;
    justify-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  .section-header .eyebrow {
    color: var(--text-3);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .section-header h2 {
    font-size: clamp(24px, 3.4vw, 32px);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .section-description {
    max-width: 620px;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.65;
  }

  /* ---------- 产品类别 Tab ---------- */
  .pricing-plans {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    width: 100%;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .pricing-tabs {
    display: inline-flex;
    gap: var(--space-1);
    padding: 4px;
    border: 1px solid var(--border);
    border-radius: var(--rounded-full);
    background: var(--surface-2);
  }

  .pricing-tab {
    min-height: 40px;
    padding: 0 var(--space-6);
    border-radius: var(--rounded-full);
    color: var(--text-2);
    font-size: 14px;
    font-weight: 800;
    transition: background var(--transition-fast), color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .pricing-tab:hover {
    color: var(--text);
  }

  .pricing-tab[aria-selected='true'] {
    background: var(--primary);
    color: var(--primary-fg);
    box-shadow: var(--shadow-card);
  }

  .pricing-tab:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .pricing-panel {
    display: grid;
    justify-items: center;
    gap: var(--space-6);
    width: 100%;
    min-width: 0;
  }

  .pricing-panel-header {
    display: grid;
    justify-items: center;
    gap: var(--space-2);
    text-align: center;
  }

  .pricing-panel-header .eyebrow {
    color: var(--text-3);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .pricing-panel-header h3 {
    font-size: clamp(20px, 2.6vw, 26px);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .plans-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
    align-items: stretch;
    width: 100%;
  }

  .plan-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--rounded-md);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .plan-card-featured {
    border: 2px solid var(--primary);
    box-shadow: var(--shadow-pop);
  }

  .plan-badge {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 14px;
    border-radius: var(--rounded-full);
    background: var(--primary);
    color: var(--primary-fg);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 18px;
    white-space: nowrap;
  }

  .plan-name {
    font-size: 16px;
    font-weight: 800;
    line-height: 1.3;
  }

  .plan-tagline {
    color: var(--text-2);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .plan-price-row {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .plan-price {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .plan-period {
    color: var(--text-3);
    font-size: 13px;
    font-weight: 600;
  }

  .plan-quota {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--rounded-sm);
    background: var(--surface-2);
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 600;
  }

  .plan-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 var(--space-4);
    border-radius: var(--rounded-full);
    font-size: 14px;
    font-weight: 700;
    transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .plan-button-primary {
    color: var(--primary-fg);
    background: var(--primary);
  }

  .plan-button-primary:hover:not(:disabled) {
    background: var(--primary-hover);
  }

  .plan-button-primary:disabled {
    cursor: not-allowed;
    color: var(--text-3);
    background: var(--surface-2);
  }

  .plan-button-secondary {
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border-strong);
  }

  .plan-button-secondary:hover {
    background: var(--surface-2);
  }

  .plan-button:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .plan-features {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .plan-features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    color: var(--text-2);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .plan-features svg {
    width: 16px;
    height: 16px;
    margin-top: var(--space-1);
    stroke: var(--primary);
    stroke-width: 2.4;
    flex: 0 0 auto;
  }

  .plan-quota-note {
    max-width: 620px;
    color: var(--text-3);
    font-size: 13px;
    line-height: 1.6;
    text-align: center;
  }

  /* ---------- 状态与错误 ---------- */
  .pricing-inline-status {
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.6;
    text-align: center;
  }

  .pricing-inline-status[data-pricing-plans-status]:empty {
    display: none;
  }

  .pricing-inline-error {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--bad);
    border-radius: var(--rounded-sm);
    background: var(--bad-soft);
    color: var(--bad);
    font-size: 13px;
    font-weight: 700;
    line-height: 1.5;
  }

  /* ---------- FAQ ---------- */
  .pricing-faq {
    display: grid;
    justify-items: center;
    gap: var(--space-8);
    max-width: 720px;
    margin-inline: auto;
    width: 100%;
  }

  .pricing-faq-list {
    display: grid;
    gap: var(--space-3);
    width: 100%;
  }

  .pricing-faq-item {
    border: 1px solid var(--border);
    border-radius: var(--rounded-md);
    background: var(--surface);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .pricing-faq-item[open] {
    border-color: var(--primary);
    box-shadow: var(--shadow-card);
  }

  .pricing-faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    cursor: pointer;
    color: var(--text);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.5;
    list-style: none;
  }

  .pricing-faq-question::-webkit-details-marker {
    display: none;
  }

  .pricing-faq-question svg {
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    stroke: var(--text-3);
    stroke-width: 2;
    transition: transform var(--transition-fast);
  }

  .pricing-faq-item[open] .pricing-faq-question svg {
    transform: rotate(180deg);
    stroke: var(--primary);
  }

  .pricing-faq-answer {
    padding: 0 var(--space-6) var(--space-4);
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.7;
  }

  @media (max-width: 960px) {
    .plans-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .pricing-tabs {
      width: 100%;
      justify-content: stretch;
    }

    .pricing-tab {
      flex: 1 1 0;
      padding: 0 var(--space-2);
    }
  }
</style>
