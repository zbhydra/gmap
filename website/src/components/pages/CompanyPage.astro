---
/**
 * Shared renderer for the localized About and Contact pages.
 *
 * Route locale -> typed company copy -> visible semantic content and dates ->
 * page-level JSON-LD -> the global Layout shell.
 */
import { COMPANY_PAGES_DATE_MODIFIED_ISO, COMPANY_PAGES_PUBLISHED_DATE, getCompanyContent } from '../../company/companyContent'
import { type Locale } from '../../i18n/content'
import { localePaths } from '../../i18n/ui'
import { DEVELOPER_EMAIL } from '../../lib/contact'
import Layout from '../../layouts/Layout.astro'

/** Company information page variants supported by this renderer. */
export type CompanyPageKind = 'about' | 'contact'

interface Props {
  /** Current locale selected by the static route. */
  locale?: Locale
  /** Semantic page kind and content selection key. */
  pageKind: CompanyPageKind
}

const { locale = 'en-US', pageKind } = Astro.props as Props
const companyContent = getCompanyContent(locale)
const page = companyContent[pageKind]
// locale 前缀（en-US 为空）；后续语言走 [lang]/ 路由时链接自动带上前缀。
const localePrefix = localePaths[locale] ? `/${localePaths[locale]}` : ''
const aboutPath = `${localePrefix}/about/`
const contactPath = `${localePrefix}/contact/`
const privacyPath = `${localePrefix}/privacy/`
const termsPath = `${localePrefix}/terms/`
const extensionPath = `${localePrefix}/extension/`
const pageUrl = new URL(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`, Astro.site).href
const organizationId = new URL('/#organization', Astro.site).href
const contactPointId = new URL('/#support', Astro.site).href
// 支持邮箱为占位常量（src/lib/contact.ts）；域名正式确定后统一核对。
const primaryHref = pageKind === 'about' ? contactPath : `mailto:${DEVELOPER_EMAIL}?subject=MapsGrab%20support%20request`
const primaryLabel = pageKind === 'about' ? companyContent.about.contactLabel : companyContent.contact.emailLabel
const companyPageSchema = {
  '@context': 'https://schema.org',
  '@type': pageKind === 'about' ? 'AboutPage' : 'ContactPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: page.title,
  description: page.seoDescription,
  inLanguage: locale,
  datePublished: COMPANY_PAGES_PUBLISHED_DATE,
  dateModified: COMPANY_PAGES_DATE_MODIFIED_ISO,
  author: {
    '@id': organizationId
  },
  publisher: {
    '@id': organizationId
  },
  mainEntity: {
    '@id': pageKind === 'about' ? organizationId : contactPointId
  }
}
---

<Layout
  locale={locale}
  title={page.seoTitle}
  description={page.seoDescription}
  includeSoftwareApplicationSchema={false}
  structuredData={[companyPageSchema]}
>
  <article class="company-page" data-company-page={pageKind}>
    <header class="company-hero">
      <div class="container company-hero-content">
        <p class="company-eyebrow">{page.eyebrow}</p>
        <h1>{page.title}</h1>
        <p class="company-intro">{page.intro}</p>
        <p class="company-date">
          {page.updatedLabel}
          <time datetime={COMPANY_PAGES_DATE_MODIFIED_ISO}>{page.updatedAt}</time>
        </p>
        <div class="company-actions" aria-label={page.eyebrow}>
          <a
            class="company-primary-link"
            href={primaryHref}
            data-ga-event="internal_workflow_click"
            data-ga-source="contact"
            data-ga-target="email"
            data-cta={`${pageKind}-primary`}
          >{primaryLabel}</a>
          {pageKind === 'about' && (
            <a
              class="company-secondary-link"
              href={extensionPath}
              data-cta="about-extension"
            >
              {companyContent.about.extensionLabel}
            </a>
          )}
          {pageKind === 'contact' && (
            <span class="company-email">{DEVELOPER_EMAIL}</span>
          )}
        </div>
      </div>
    </header>

    <div class="company-sections">
      {page.sections.map((section, index) => (
        <section class="company-section" aria-labelledby={`${pageKind}-section-${index}`}>
          <div class="container company-section-layout">
            <h2 id={`${pageKind}-section-${index}`}>{section.title}</h2>
            <div class="company-section-copy">
              {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
              {section.items && (
                <ul>
                  {section.items.map(item => <li>{item}</li>)}
                </ul>
              )}
            </div>
          </div>
        </section>
      ))}
    </div>

    <nav class="company-related" aria-label={companyContent.footerGroupLabel}>
      <div class="container company-related-links">
        {pageKind === 'about' ? (
          <a href={contactPath}>{companyContent.about.contactLabel}</a>
        ) : (
          <a href={aboutPath}>{companyContent.contact.aboutLabel}</a>
        )}
        <a href={privacyPath}>{page.privacyLabel}</a>
        <a href={termsPath}>{page.termsLabel}</a>
      </div>
    </nav>
  </article>
</Layout>

<style>
  .company-page {
    color: var(--text);
  }

  .company-hero {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .company-hero-content {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .company-eyebrow {
    margin: 0 0 var(--space-4);
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 820px;
    margin: 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(32px, 4.2vw, 48px);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .company-intro {
    max-width: 760px;
    margin: var(--space-6) 0 0;
    color: var(--text-2);
    font-size: 17px;
    line-height: 1.7;
  }

  .company-date {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: var(--space-4) 0 0;
    color: var(--text-3);
    font-size: 13px;
    line-height: 20px;
  }

  .company-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .company-primary-link,
  .company-secondary-link {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-6);
    border-radius: var(--rounded-full);
    font-size: 15px;
    font-weight: 600;
    line-height: 20px;
    text-decoration: none;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .company-primary-link {
    border: 1px solid var(--primary);
    background: var(--primary);
    color: var(--primary-fg);
  }

  .company-primary-link:hover {
    border-color: var(--primary-hover);
    background: var(--primary-hover);
  }

  .company-secondary-link {
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--text);
  }

  .company-secondary-link:hover {
    background: var(--surface-2);
    color: var(--text);
  }

  .company-primary-link:focus-visible,
  .company-secondary-link:focus-visible,
  .company-related a:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .company-email {
    overflow-wrap: anywhere;
    color: var(--text-2);
    font-size: 15px;
  }

  .company-section {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .company-section:nth-child(even) {
    background: var(--surface);
  }

  .company-section-layout {
    display: grid;
    grid-template-columns: minmax(220px, 0.7fr) minmax(0, 1.3fr);
    gap: var(--space-16);
    padding-top: var(--space-10);
    padding-bottom: var(--space-10);
  }

  .company-section h2 {
    margin: 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 32px;
    letter-spacing: -0.015em;
  }

  .company-section-copy {
    min-width: 0;
  }

  .company-section-copy p {
    margin: 0;
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.7;
  }

  .company-section-copy p + p {
    margin-top: var(--space-4);
  }

  .company-section-copy ul {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .company-section-copy li {
    position: relative;
    padding-left: 22px;
    color: var(--text-2);
    font-size: 15px;
    line-height: 24px;
  }

  .company-section-copy li::before {
    position: absolute;
    top: 9px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: var(--rounded-full);
    background: var(--primary);
    content: '';
  }

  .company-related {
    background: var(--surface-2);
  }

  .company-related-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-8);
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  .company-related a {
    color: var(--link);
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    text-decoration: none;
  }

  .company-related a:hover {
    color: var(--primary-hover);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 960px) {
    .company-hero-content {
      padding-top: var(--space-10);
      padding-bottom: var(--space-10);
    }

    .company-section-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
      padding-top: var(--space-8);
      padding-bottom: var(--space-8);
    }
  }

  @media (max-width: 480px) {
    .company-primary-link,
    .company-secondary-link {
      width: 100%;
    }

    .company-email {
      width: 100%;
    }
  }
</style>
