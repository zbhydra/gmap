---
/**
 * 公司页（/about、/contact，设计稿 about.html；其中 #contact 区即 /contact 的模板）。
 *
 * About：首屏地球 → What we build → Principles → How data moves（暗色岛）→ Status → 收尾 CTA（与首页同源）。
 * Contact：联系区单独成页，只给邮箱（复制 / mailto），不做表单提交。
 * JSON-LD 为 AboutPage / ContactPage：发布与审校日期取 companyContent 常量，主体指向 Organization / ContactPoint。
 */
import { COMPANY_PAGES_DATE_MODIFIED_ISO, COMPANY_PAGES_PUBLISHED_DATE, getCompanyContent } from '../../company/companyContent'
import { getContent, type Locale } from '../../i18n/content'
import { localePaths } from '../../i18n/ui'
import Layout from '../../layouts/Layout.astro'
import AboutBuild from '../company/AboutBuild.astro'
import AboutDataFlow from '../company/AboutDataFlow.astro'
import AboutHero from '../company/AboutHero.astro'
import AboutPrinciples from '../company/AboutPrinciples.astro'
import AboutStatus from '../company/AboutStatus.astro'
import ContactSection from '../company/ContactSection.astro'
import ProductCta from '../product/ProductCta.astro'
import CapabilityAction from '../site/CapabilityAction.astro'
import Icon from '../site/Icon.astro'
import { headingText } from '../tools/tool-catalog'

/** 本渲染器支持的公司页。 */
export type CompanyPageKind = 'about' | 'contact'

interface Props {
  /** 当前语言路由。 */
  locale?: Locale
  /** 渲染哪一页。 */
  pageKind: CompanyPageKind
}

const { locale = 'en-US', pageKind } = Astro.props
const company = getCompanyContent(locale)
const page = company[pageKind]
const homeCta = getContent(locale).pages.home.cta
const prefix = localePaths[locale] ? `/${localePaths[locale]}` : ''
// CTA 归因：站内链接带 utm（canonical 只取 pathname，不受 query 影响），事件侧用 data-cta。
const installHref = `${prefix}/extension/?utm_source=website&utm_medium=about-cta&utm_campaign=install#install`
const pageUrl = new URL(Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`, Astro.site).href
const organizationId = new URL('/#organization', Astro.site).href
const contactPointId = new URL('/#support', Astro.site).href
const pageTitle = headingText(pageKind === 'about' ? company.about.hero.title : company.contact.title)
const companyPageSchema = {
  '@context': 'https://schema.org',
  '@type': pageKind === 'about' ? 'AboutPage' : 'ContactPage',
  '@id': `${pageUrl}#webpage`,
  url: pageUrl,
  name: pageTitle,
  description: page.seoDescription,
  inLanguage: locale,
  datePublished: COMPANY_PAGES_PUBLISHED_DATE,
  dateModified: COMPANY_PAGES_DATE_MODIFIED_ISO,
  author: {
    '@id': organizationId
  },
  publisher: {
    '@id': organizationId
  },
  mainEntity: {
    '@id': pageKind === 'about' ? organizationId : contactPointId
  }
}
---

<Layout
  locale={locale}
  title={page.seoTitle}
  description={page.seoDescription}
  includeSoftwareApplicationSchema={false}
  structuredData={[companyPageSchema]}
  preloadAccentFont
>
  {pageKind === 'about' ? (
    <>
      <AboutHero locale={locale} hero={company.about.hero} />
      <AboutBuild locale={locale} build={company.about.build} />
      <AboutPrinciples locale={locale} principles={company.about.principles} />
      <AboutDataFlow locale={locale} dataFlow={company.about.dataFlow} />
      <AboutStatus locale={locale} status={company.about.status} />
      <ProductCta cta={{ ...homeCta, primary: homeCta.install, secondary: homeCta.online }}>
        <CapabilityAction
          capability="extensionInstall"
          locale={locale}
          href={installHref}
          class="btn btn-primary btn-lg"
          data-cta="about-cta-install"
          data-magnetic="0.22"
        >
          <Icon name="puzzle" />{homeCta.install}
        </CapabilityAction>
        <a class="btn btn-secondary btn-lg" href={`${prefix}/online-scraper/`} data-cta="about-cta-online">{homeCta.online}</a>
      </ProductCta>
    </>
  ) : (
    <ContactSection locale={locale} contact={company.contact} relatedLabel={company.footerGroupLabel} />
  )}
</Layout>
