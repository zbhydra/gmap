---
/**
 * API 落地页（W4）：/google-maps-scraper-api、/google-maps-reviews-scraper-api、/google-maps-photos-api 共用一套版式，
 * variant 决定首屏、代码台、能力、参考区、FAQ 与 CTA；端点卡、fid 串联、要点与方案区三页共用。
 *
 * 事实按 014 合同（docs/feat/014.Maps云端/tech-API与MCP.md）：REST 前缀 /api/external/maps，用户 API Key 以
 * Authorization: Bearer 传入，响应为 {code, data, msg} 信封；Photos 仅承诺有效部分交付。
 * 获取 Key 与套餐 CTA 走能力表灰化：Search / Reviews 与 API 套餐绑 scraperApi，Photos 页的获取 Key 绑 photosApi。
 * 代码台打字与串联动画由 scripts/pages/api-page.ts 驱动；无 JS 时代码与示例完整可读。
 */
import { Code } from 'astro:components'
import Layout from '../../layouts/Layout.astro'
import { getContent, type Locale } from '../../i18n/content'
import type { ProductCtaMessage, ProductFaqMessage } from '../../i18n/schema'
import { localePaths } from '../../i18n/ui'
import { capabilities, type Capability } from '../../lib/capabilities'
import CapabilityAction from '../site/CapabilityAction.astro'
import Icon from '../site/Icon.astro'
import SoonBadge from '../site/SoonBadge.astro'
import SplitWords from '../site/SplitWords.astro'
import CodeText from '../api/CodeText.astro'
import JsonLine from '../api/JsonLine.astro'
import { API_BASE_URL } from '../api/endpoints'
import AccentHeading from '../product/AccentHeading.astro'
import ProductCta from '../product/ProductCta.astro'
import ProductFaq from '../product/ProductFaq.astro'
import { faqPageSchema } from '../product/faq-schema'

type Variant = 'search' | 'reviews' | 'photos'

interface Props {
  variant: Variant
  locale?: Locale
}

const { variant, locale = 'en-US' } = Astro.props
const t = getContent(locale)
const shared = t.pages.apiPage
const variantContent = { search: t.pages.scraperApi, reviews: t.pages.reviewsApi, photos: t.pages.photosApi }
const page = variantContent[variant]
const prefix = localePaths[locale] ? `/${localePaths[locale]}` : ''

/** 三个变体的路由、图标、端点与参数（取自 014 合同）。 */
const VARIANTS: ReadonlyArray<{
  key: Variant
  path: string
  icon: string
  endpoint: string
  params: readonly string[]
  capability: Capability
}> = [
  { key: 'search', path: 'google-maps-scraper-api/', icon: 'database', endpoint: '/search', params: ['q', 'page', 'hl', 'll', 'extra'], capability: 'scraperApi' },
  { key: 'reviews', path: 'google-maps-reviews-scraper-api/', icon: 'review', endpoint: '/reviews', params: ['fid', 'cursor', 'sort_by', 'hl'], capability: 'scraperApi' },
  { key: 'photos', path: 'google-maps-photos-api/', icon: 'image', endpoint: '/photos', params: ['fid', 'max_results'], capability: 'photosApi' }
]
const current = VARIANTS.find(item => item.key === variant)
if (!current) throw new Error(`[api-page] Unknown variant: ${variant}`)
const pageId = current.path.replace(/\/$/, '')
const keyCapability = current.capability
const keyHref = `${prefix}/dashboard/api/`
const pricingHref = (medium: string) =>
  `${prefix}/pricing/?product_kind=maps_api&utm_source=website&utm_medium=${pageId}-${medium}&utm_campaign=pricing`

// 方案卡逐字取自 pricing.ts 的 API tab；首屏勾选行的 {quota} 用免费档额度。
const apiPlans = t.pages.pricing.tabs.api
const freePlan = apiPlans.cards.find(card => card.status === 'free')
if (!freePlan) throw new Error('[api-page] pricing.ts API tab has no free plan card for the {quota} hero line.')
const heroMeta = page.hero.meta.map(item => item.replace('{quota}', freePlan.quota))

/* ---------------------------------------------------------------------------
   代码台样例：URL 取部署配置。
   --------------------------------------------------------------------------- */
const LANGS = ['curl', 'python', 'node'] as const
type Lang = (typeof LANGS)[number]
const CODE_LANG: Record<Lang, 'bash' | 'python' | 'javascript'> = { curl: 'bash', python: 'python', node: 'javascript' }
const SAMPLE_FID = '0x54950a2291f60bf1:0xbeb4a5f2c3d1e0ab'

interface RequestSpec {
  path: '/search' | '/reviews' | '/photos'
  body: Record<Lang, string>
  result: { python: string; node: string }
  setup?: { python: string; node: string }
}

function requestSamples(spec: RequestSpec): Record<Lang, string> {
  const url = `${API_BASE_URL}${spec.path}`
  return {
    curl: [
      `curl ${url} \\`,
      '  -H "Authorization: Bearer $MAPSGRAB_API_KEY" \\',
      '  -H "Content-Type: application/json" \\',
      `  -d '${spec.body.curl}'`
    ].join('\n'),
    python: [
      'import os',
      'import requests',
      '',
      ...(spec.setup ? [spec.setup.python, ''] : []),
      'resp = requests.post(',
      `    "${url}",`,
      '    headers={"Authorization": f"Bearer {os.environ[\'MAPSGRAB_API_KEY\']}"},',
      `    json=${spec.body.python},`,
      ')',
      'body = resp.json()',
      'if body["code"] != 10000:',
      '    raise RuntimeError(body["msg"])',
      spec.result.python
    ].join('\n'),
    node: [
      ...(spec.setup ? [spec.setup.node, ''] : []),
      `const res = await fetch("${url}", {`,
      '  method: "POST",',
      '  headers: {',
      '    Authorization: `Bearer ${process.env.MAPSGRAB_API_KEY}`,',
      '    "Content-Type": "application/json",',
      '  },',
      `  body: JSON.stringify(${spec.body.node}),`,
      '});',
      'const { code, data, msg } = await res.json();',
      'if (code !== 10000) throw new Error(msg);',
      spec.result.node
    ].join('\n')
  }
}

const CONSOLE: Record<Variant, { path: string; request: Record<Lang, string>; response: string }> = {
  search: {
    path: '/search',
    request: requestSamples({
      path: '/search',
      body: {
        curl: '{"q": "coffee shop in Portland, OR", "extra": true}',
        python: '{"q": "coffee shop in Portland, OR", "extra": True}',
        node: '{ q: "coffee shop in Portland, OR", extra: true }'
      },
      result: { python: 'places = body["data"]["places"]', node: 'const { places } = data;' }
    }),
    response: [
      '{',
      '  "code": 10000,',
      '  "data": {',
      '    "places": [',
      '      {',
      '        "name": "Ember & Oak Coffee",',
      `        "fid": "${SAMPLE_FID}",`,
      '        "categories": ["Coffee shop", "Espresso bar"],',
      '        "full_address": "3021 SE Division St, Portland, OR 97202",',
      '        "phone": "(503) 555-0142",',
      '        "website": "emberandoak.coffee/",',
      '        "average_rating": 4.7,',
      '        "review_count": 1284,',
      '        "latitude": 45.504912,',
      '        "longitude": -122.635377,',
      '        "place_id": "ChIJ8Qv2kSIKlVQRq-DRw_KltL4",',
      '        "emails": ["hello@emberandoak.coffee"],',
      '        "medias": {"instagram": "https://www.instagram.com/emberandoak"},',
      '        …',
      '      },',
      '      …',
      '    ],',
      '    "partial": false,',
      '    "warnings": []',
      '  },',
      '  "msg": ""',
      '}'
    ].join('\n')
  },
  reviews: {
    path: '/reviews',
    request: requestSamples({
      path: '/reviews',
      body: {
        curl: `{"fid": "${SAMPLE_FID}", "sort_by": 2}`,
        python: '{"fid": FID, "sort_by": 2}',
        node: '{ fid, sort_by: 2 }'
      },
      setup: { python: `FID = "${SAMPLE_FID}"`, node: `const fid = "${SAMPLE_FID}";` },
      result: { python: 'reviews = body["data"]["reviews"]', node: 'const { reviews, next_cursor } = data;' }
    }),
    response: [
      '{',
      '  "code": 10000,',
      '  "data": {',
      '    "reviews": [',
      '      {',
      '        "review_id": "ChdDSUhNMG9nS0VJQ0FnSUR3…",',
      '        "author_name": "Maya R.",',
      '        "author_is_local_guide": true,',
      '        "rating": 5,',
      '        "text": "Best cortado on Division. Friendly crew.",',
      '        "language": "en",',
      '        "published_at_ms": 1790553600000,',
      '        "relative_date": "2 weeks ago",',
      '        "images": ["https://lh5.googleusercontent.com/p/AF1QipN…"],',
      '        "owner_response": "Thanks Maya — see you soon!",',
      '        "owner_response_at_ms": 1790640000000,',
      '        …',
      '      },',
      '      …',
      '    ],',
      '    "next_cursor": "CAESBkVnSUlDZw…"',
      '  },',
      '  "msg": ""',
      '}'
    ].join('\n')
  },
  photos: {
    path: '/photos',
    request: requestSamples({
      path: '/photos',
      body: {
        curl: `{"fid": "${SAMPLE_FID}", "max_results": 2}`,
        python: '{"fid": FID, "max_results": 2}',
        node: '{ fid, max_results: 2 }'
      },
      setup: { python: `FID = "${SAMPLE_FID}"`, node: `const fid = "${SAMPLE_FID}";` },
      result: {
        python: 'photos = body["data"]["photos"]',
        node: 'const { photos, status, reason } = data;'
      }
    }),
    response: [
      '{',
      '  "code": 10000,',
      '  "data": {',
      '    "photos": [',
      '      {"url": "https://lh5.googleusercontent.com/p/AF1QipM…"},',
      '      {"url": "https://lh5.googleusercontent.com/p/AF1QipO…"}',
      '    ],',
      '    "returned_count": 2,',
      '    "reported_total": 178,',
      '    "status": "partial",',
      '    "reason": "limit_reached"',
      '  },',
      '  "msg": ""',
      '}'
    ].join('\n')
  }
}
const sample = CONSOLE[variant]

/** 串联演示 Search 结果的缩写 fid（与 chain.places 顺序一致，首条即示例商户 SAMPLE_FID）。 */
const CHAIN_FIDS = ['0x5495…e0ab', '0x5495…8f7a', '0x5495…3a5c']
/** 串联演示 Photos 步骤的占位图块色调（插画，取品牌原色）。 */
const PHOTO_TONES = ['--amber-400', '--coral-400', '--cyan-500', '--green-400', '--blue-400', '--violet-400']
const reference = page.reference

// FAQ 与收尾 CTA：标题、问答与导语按页，kicker、侧栏导语、按钮与说明是 API / MCP 共用文案。
const faq: ProductFaqMessage = { ...shared.faq, kicker: t.common.faqLabel, title: page.faq.title, items: page.faq.items }
const cta: ProductCtaMessage = { ...shared.cta, title: page.cta.title, lead: page.cta.lead, primary: shared.primaryCta, secondary: shared.pricingCta }
---

<Layout
  locale={locale}
  title={page.seo.title}
  description={page.seo.description}
  includeSoftwareApplicationSchema={false}
  structuredData={[faqPageSchema(faq.items)]}
  preloadAccentFont
>
  <div class="api-page" data-api-page={pageId}>
    <!-- ① Hero：端点切换 + 标题 + 代码台（请求打字 → 响应逐行流入） -->
    <section class="page-hero api-hero has-deco" data-inview>
      <div class="deco" aria-hidden="true">
        <div class="aurora"><i></i><i></i><i></i></div>
        <div class="bg-contours"></div>
        <div class="bg-grid"></div>
        <div class="noise"></div>
      </div>

      <div class="container page-hero-grid">
        <div class="page-hero-copy">
          <nav class="seg api-switch" aria-label={shared.switchLabel} data-enter>
            {VARIANTS.map(item => (
              <a
                class:list={['seg-btn', { 'is-unavailable': !capabilities[item.capability] }]}
                href={`${prefix}/${item.path}`}
                aria-current={item.key === variant ? 'page' : undefined}
                data-cta={`${pageId}-switch-${item.key}`}
              >
                <Icon name={item.icon} />{shared.switchItems[item.key]}{!capabilities[item.capability] && <SoonBadge locale={locale} />}
              </a>
            ))}
          </nav>

          <h1 class="h1 api-title" data-split="static" style="--split-delay: 90ms">
            <SplitWords parts={[page.hero.title.lead, { text: page.hero.title.accent, class: 'accent text-grad' }, page.hero.title.tail]} />
          </h1>

          <p class="lead" data-enter style="--enter-delay: 180ms">{page.hero.lead}</p>

          <div class="page-hero-actions" data-enter style="--enter-delay: 270ms">
            <CapabilityAction capability={keyCapability} locale={locale} href={keyHref} class="btn btn-primary btn-lg" data-magnetic="0.22" data-cta={`${pageId}-hero-api-dashboard`}>
              <Icon name="key" />{shared.primaryCta}
            </CapabilityAction>
            <a class="btn btn-secondary btn-lg" href={pricingHref('hero')} data-cta={`${pageId}-hero-pricing`}>{shared.pricingCta}</a>
          </div>

          <div class="page-hero-meta" data-enter style="--enter-delay: 360ms">
            {heroMeta.map(item => <span><Icon name="check" />{item}</span>)}
          </div>
        </div>

        <div class="page-hero-visual api-stage" data-reveal="right" data-reveal-onload="520">
          <div
            class="api-console codewin"
            role="region"
            aria-label={shared.console.label}
            data-tabs
            data-api-console
            data-status-ready={shared.console.ready}
            data-status-composing={shared.console.composing}
            data-status-sending={shared.console.sending}
            data-status-done={shared.console.done}
          >
            <div class="codewin-bar">
              <div class="win-dots" aria-hidden="true"><i></i><i></i><i></i></div>
              <span class="api-endpoint"><b>POST</b>{sample.path}</span>
              <div class="codewin-tabs" role="tablist" aria-label={shared.console.langLabel}>
                {LANGS.map((lang, index) => (
                  <button
                    class="codewin-tab"
                    type="button"
                    role="tab"
                    id={`api-lang-${lang}`}
                    aria-controls={`api-request-${lang}`}
                    aria-selected={index === 0 ? 'true' : 'false'}
                    data-tab={lang}
                  >
                    {shared.console.langs[lang]}
                  </button>
                ))}
              </div>
              <button class="codewin-copy" type="button" aria-label={shared.console.copy} data-copy={sample.request.curl} data-api-copy>
                <Icon name="copy" class="icon--sm" />
              </button>
            </div>
            <div class="api-req">
              {LANGS.map((lang, index) => (
                <div class="api-req-panel" role="tabpanel" id={`api-request-${lang}`} aria-labelledby={`api-lang-${lang}`} hidden={index !== 0} data-api-request>
                  <Code code={sample.request[lang]} lang={CODE_LANG[lang]} theme="css-variables" />
                </div>
              ))}
            </div>
            <div class="codewin-label api-status is-ok" data-api-status>
              <span class="api-status-dot" aria-hidden="true"></span>
              <span class="api-status-text" data-api-status-text>{shared.console.done}</span>
              <button class="api-replay" type="button" aria-label={shared.console.replay} data-api-replay hidden>
                <Icon name="refresh" class="icon--sm" />
              </button>
            </div>
            <div class="api-res" role="region" aria-label={shared.console.response} data-waiting={shared.console.waiting} data-api-response>
              <Code code={sample.response} lang="json" theme="css-variables" />
            </div>
          </div>

          <div class="float-chip api-fc api-fc--a floaty" style="--float-t: 7s" data-parallax="0.05" aria-hidden="true">
            <span class="icon-tile icon-tile--ok"><Icon name="table" /></span>
            <span><small>{page.hero.chips[0].label}</small>{page.hero.chips[0].value}</span>
          </div>
          <div class="float-chip api-fc api-fc--b floaty" style="--float-t: 8s; --float-d: -3s" data-parallax="-0.05" aria-hidden="true">
            <span class="icon-tile"><Icon name="layers" /></span>
            <span><small>{page.hero.chips[1].label}</small>{page.hero.chips[1].value}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ② 端点卡（互链）+ MCP 横幅 -->
    <section class="section" id="endpoints">
      <div class="container">
        <header class="section-head" data-stagger="80">
          <span class="kicker" data-reveal>{shared.endpoints.kicker}</span>
          <h2 class="h2" data-split><AccentHeading title={shared.endpoints.title} /></h2>
          <p class="lead" data-reveal><CodeText text={shared.endpoints.lead} /></p>
        </header>

        <div class="api-ep-grid" data-stagger="90" data-spotlight-group>
          {VARIANTS.map(item => (
            <a
              class:list={['api-ep card card-link card--lift', { 'is-current': item.key === variant, 'is-unavailable': !capabilities[item.capability] }]}
              href={`${prefix}/${item.path}`}
              data-spotlight
              data-reveal
              data-cta={`${pageId}-endpoint-${item.key}`}
            >
              <div class="api-ep-top">
                <span class="icon-tile icon-tile--brand"><Icon name={item.icon} /></span>
                {item.key === variant && <span class="badge">{shared.endpoints.here}</span>}
                {!capabilities[item.capability] && <SoonBadge locale={locale} />}
              </div>
              <code class="api-ep-path"><b>POST</b>{item.endpoint}</code>
              <h3>{variantContent[item.key].endpoint.name}</h3>
              <p><CodeText text={variantContent[item.key].endpoint.description} /></p>
              {item.params.length > 0 && (
                <div class="api-ep-params" role="list" aria-label={shared.endpoints.paramsLabel}>
                  {item.params.map(param => <span role="listitem">{param}</span>)}
                </div>
              )}
              <span class="link-arrow">{variantContent[item.key].endpoint.link}<Icon name="arrow-right" /></span>
            </a>
          ))}
        </div>

        <a class="api-mcp card card-link" href={`${prefix}/google-maps-scraper-mcp/`} data-reveal data-cta={`${pageId}-mcp-banner`}>
          <span class="icon-tile icon-tile--ai"><Icon name="bot" /></span>
          <span class="api-mcp-text">
            <b>{shared.endpoints.mcp.title}{!capabilities.mcp && <SoonBadge locale={locale} />}</b>
            <span>{shared.endpoints.mcp.description}</span>
          </span>
          <span class="link-arrow api-mcp-go">{shared.endpoints.mcp.link}<Icon name="arrow-right" /></span>
        </a>
      </div>
    </section>

    <!-- ③ 能力清单（按变体） -->
    <section class="section band" id="capabilities">
      <div class="container">
        <header class="section-head" data-stagger="80">
          <span class="kicker" data-reveal>{page.endpoint.name}</span>
          <h2 class="h2" data-split><AccentHeading title={page.caps.title} /></h2>
          <p class="lead" data-reveal>{page.caps.lead}</p>
        </header>
        <div class="feature-grid" data-stagger="70" data-spotlight-group>
          {page.caps.items.map(item => (
            <article class="feature card card--lift" data-spotlight data-reveal>
              <span class="icon-tile"><Icon name={item.icon} /></span>
              <h3>{item.title}</h3>
              <p><CodeText text={item.description} /></p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ④ fid 串联（恒暗主题岛）：Search → Reviews / Photos -->
    <section class="section api-chain scheme-dark has-deco" id="chain" data-inview>
      <div class="deco" aria-hidden="true">
        <div class="bg-grid api-chain-grid"></div>
        <div class="api-chain-glow"></div>
        <div class="noise"></div>
      </div>
      <div class="container">
        <header class="section-head" data-stagger="80">
          <span class="kicker" data-reveal>{shared.chain.kicker}</span>
          <h2 class="h2" data-split><AccentHeading title={shared.chain.title} accentClass="text-grad" /></h2>
          <p class="lead" data-reveal><CodeText text={shared.chain.lead} /></p>
        </header>

        <div class="chain" role="img" aria-label={shared.chain.label} data-chain>
          <article class="chain-step" data-reveal>
            <header class="chain-head">
              <span class="chain-num">01</span>
              <code class="chain-ep"><b>POST</b>/search</code>
            </header>
            <div class="chain-req"><JsonLine source={'{"q": "coffee shop in Portland, OR"}'} /></div>
            <ul class="chain-list" role="list">
              {shared.chain.places.map((place, index) => (
                <li class:list={['chain-place', { 'is-picked': index === 0 }]} style={`--i: ${index}`}>
                  <span class="chain-pin"></span>
                  <span class="chain-name">{place.name}<small><Icon name="star" class="icon--fill" />{place.meta}</small></span>
                  <code class="chain-fid">{CHAIN_FIDS[index]}</code>
                </li>
              ))}
            </ul>
          </article>

          <div class="chain-link chain-link--a">
            <span class="chain-track"></span>
            <span class="chain-rail"><span class="chain-token">fid</span></span>
          </div>

          <article class="chain-step" data-reveal>
            <header class="chain-head">
              <span class="chain-num">02</span>
              <code class="chain-ep"><b>POST</b>/reviews</code>
            </header>
            <div class="chain-req">
              <span class="tok-punc">{'{'}</span><span class="tok-key">"fid"</span><span class="tok-punc">:</span> <span class="tok-str chain-slot">"<span>0x5495…e0ab</span>"</span><span class="tok-punc">,</span> <span class="tok-key">"sort_by"</span><span class="tok-punc">:</span> <span class="tok-num">2</span><span class="tok-punc">{'}'}</span>
            </div>
            <ul class="chain-list" role="list">
              {shared.chain.reviews.map((review, index) => (
                <li class="chain-review" style={`--i: ${index}`}>
                  <span class="chain-stars">{'★'.repeat(review.rating)}<i>{'★'.repeat(5 - review.rating)}</i></span>
                  <p>{review.text}</p>
                  <small>{review.meta}</small>
                  {review.reply && <span class="chain-reply"><Icon name="review" />{review.reply}</span>}
                </li>
              ))}
            </ul>
          </article>

          <div class="chain-link chain-link--b">
            <span class="chain-track"></span>
          </div>

          <article class="chain-step" data-reveal>
            <header class="chain-head">
              <span class="chain-num">03</span>
              <code class="chain-ep"><b>POST</b>/photos</code>
              {!capabilities.photosApi && <SoonBadge locale={locale} />}
            </header>
            <div class="chain-req"><JsonLine source={`{"fid": "${SAMPLE_FID}", "max_results": 6}`} /></div>
            <div class="chain-photos-grid">
              {PHOTO_TONES.map(tone => <i style={`--tone: var(${tone})`}></i>)}
            </div>
            <p class="chain-caption">{shared.chain.photos.note}</p>
          </article>
        </div>
      </div>
    </section>

    <!-- ⑤ 参考：请求参数 + 响应字段 -->
    <section class="section" id="reference">
      <div class="container">
