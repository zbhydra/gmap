---
/**
 * 法务页（/privacy、/terms，设计稿 privacy.html）：紧凑首屏 + 正文（目录、要点速览、小节、覆盖范围提示、下一篇）。
 *
 * 两份文档各有自己的路由，页面只渲染当前文档；文案来自 legal/legalContent.ts。
 * JSON-LD 为 WebPage，dateModified 与正文的最后更新日期同源（updatedAtISO）。
 */
import Layout from '../../layouts/Layout.astro'
import type { Locale } from '../../i18n/content'
import { getLegalContent, type LegalPageKind } from '../../legal/legalContent'
import LegalDocument from '../legal/LegalDocument.astro'
import LegalHero from '../legal/LegalHero.astro'

interface Props {
  /** 当前语言路由。 */
  locale?: Locale
  /** 渲染哪一份法务文档。 */
  pageKind: LegalPageKind
}

const { locale = 'en-US', pageKind } = Astro.props
const content = getLegalContent(locale)
const doc = content[pageKind]
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`
const pageUrl = new URL(pathname, Astro.site).href
const legalSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: pageUrl,
  name: doc.title,
  description: doc.seoDescription,
  dateModified: doc.updatedAtISO,
  publisher: {
    '@type': 'Organization',
    name: 'MapsGrab',
    url: new URL('/', Astro.site).href
  }
}
---

<Layout
  locale={locale}
  title={doc.seoTitle}
  description={doc.seoDescription}
  includeSoftwareApplicationSchema={false}
  structuredData={[legalSchema]}
>
  <LegalHero locale={locale} kind={pageKind} content={content} />
  <LegalDocument locale={locale} kind={pageKind} content={content} pageUrl={pageUrl} />
</Layout>
