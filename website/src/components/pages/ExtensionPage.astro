---
/**
 * 插件产品页（设计稿 extension.html，README §7「插件」①–⑩）：营销与页内安装教程一体。
 *
 * 安装入口（首屏、release zip、Free 卡、收尾 CTA）受 extensionInstall 开关控制，Pro / Business 购买受
 * extensionPurchase 控制；未交付时统一灰化为 Coming soon（lib/capabilities.ts）。方案卡的名称、价格、额度与卖点
 * 逐字取自 pricing.ts 的 extension tab；区块导语与计量说明按插件实际计量口径写在 pages.extension。
 */
import Layout from '../../layouts/Layout.astro'
import { getContent, type Locale } from '../../i18n/content'
import { localePaths } from '../../i18n/ui'
import CapabilityAction from '../site/CapabilityAction.astro'
import Icon from '../site/Icon.astro'
import ExtensionBatch from '../extension/ExtensionBatch.astro'
import ExtensionHero from '../extension/ExtensionHero.astro'
import ExtensionInstall from '../extension/ExtensionInstall.astro'
import ExtensionPrivacy from '../extension/ExtensionPrivacy.astro'
import ExtensionShowcase from '../extension/ExtensionShowcase.astro'
import ExtensionViews from '../extension/ExtensionViews.astro'
import { faqPageSchema } from '../product/faq-schema'
import ProductCta from '../product/ProductCta.astro'
import ProductFacts from '../product/ProductFacts.astro'
import ProductFaq from '../product/ProductFaq.astro'
import ProductSectionHead from '../product/ProductSectionHead.astro'

interface Props {
  locale?: Locale
}

const { locale = 'en-US' } = Astro.props
const t = getContent(locale)
const page = t.pages.extension
const pricing = t.pages.pricing
const plans = pricing.tabs.extension
const prefix = localePaths[locale] ? `/${localePaths[locale]}` : ''
const pricingHref = `${prefix}/pricing/?product_kind=maps_extension`
---

<Layout locale={locale} title={page.seo.title} description={page.seo.description} structuredData={[faqPageSchema(page.faq.items)]} preloadAccentFont>
  <div data-extension-page>
    <ExtensionHero locale={locale} hero={page.hero} version={page.install.notes.version} />

    <ProductFacts locale={locale} caption={page.facts.caption} items={page.facts.items} />

    <ExtensionViews views={page.views} extracting={page.hero.theater.extracting} />

    <ExtensionShowcase locale={locale} features={page.features} />

    <ExtensionBatch batch={page.batch} />

    <ExtensionPrivacy privacy={page.privacy} />

    <ExtensionInstall locale={locale} install={page.install} />

    <section class="section x-plans" id="plans">
      <div class="container">
        <ProductSectionHead head={page.plans.head} />

        <div class="x-plan-grid" data-stagger="100">
          {plans.cards.map(card => (
            <article class:list={['price-card', { 'is-featured': card.featured }]} data-reveal>
              {card.featured && <span class="badge badge--solid price-flag">{pricing.popularLabel}</span>}
              <div>
                <div class="price-name">{card.name}</div>
                <div class="price-tagline">{card.tagline}</div>
              </div>
              <div class="price-amount"><b>{card.price}</b><span class="price-period">{card.periodLabel}</span></div>
              <div class="price-quota"><Icon name="gauge" />{card.quota}</div>
              <ul class="check-list check-list--sm" role="list">
                {card.features.map(feature => <li>{feature}</li>)}
              </ul>
              <CapabilityAction
                capability={card.status === 'free' ? 'extensionInstall' : 'extensionPurchase'}
                locale={locale}
                href={card.status === 'free' ? '#install' : pricingHref}
                class:list={['btn', 'btn-block', card.featured ? 'btn-primary' : 'btn-secondary']}
                data-cta={`extension-plan-${card.id}`}
              >
                {card.ctaLabel}
              </CapabilityAction>
            </article>
          ))}
        </div>

        <p class="x-plan-note" data-reveal>
          {page.plans.note}
          <a class="link-arrow" href={pricingHref} data-cta="extension-plans-compare">{page.plans.compare}<Icon name="arrow-right" /></a>
        </p>
      </div>
    </section>

    <ProductFaq locale={locale} faq={page.faq} />

    <ProductCta cta={page.cta}>
      <CapabilityAction
        capability="extensionInstall"
        locale={locale}
        href="#install"
        class="btn btn-primary btn-lg"
        data-magnetic="0.22"
        data-cta="extension-band-install"
      >
        <Icon name="puzzle" />{page.cta.primary}
      </CapabilityAction>
      <a class="btn btn-secondary btn-lg" href={pricingHref} data-cta="extension-cta-pricing">{page.cta.secondary}</a>
    </ProductCta>
  </div>
</Layout>

<style>
  .x-plan-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
    gap: 20px;
    max-width: 1080px;
    margin: clamp(48px, 5vw, 64px) auto 0;
  }

  .x-plan-note {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 16px;
    max-width: 760px;
    margin: 24px auto 0;
    color: var(--text-3);
    font-size: 14px;
    text-align: center;
  }

  .x-plan-note .link-arrow {
    font-size: 14px;
  }

  @media (max-width: 1080px) {
    .x-plan-grid {
      grid-template-columns: minmax(0, 1fr);
      max-width: 520px;
    }
  }
</style>
