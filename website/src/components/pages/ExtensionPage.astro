---
/**
 * 插件产品页渲染器（W2：营销 + 安装教程一体页，对齐竞品「产品介绍在上、安装教程在下」结构）。
 *
 * 功能口径对齐 013 A5 36 列与 A1/A2/A3/A4/A6/A8 能力；
 * 版本说明段承接 changelog 职能；hero 的 Edge 按钮跳 Edge Add-ons 商店、
 * Chrome 按钮滚动到页内安装教程（Chrome 不上商店，走 zip 直装）。
 * CTA 带 data-cta 归因属性（事件经 W6 GA4 通道上报）。
 * 图文分区（015 D5 图文改造）：hero/showcase/demo 配图走 MediaSlot 占位，
 * 素材产出后仅回填 src，不动结构。
 */
import Layout from '../../layouts/Layout.astro'
import { getContent, type Locale } from '../../i18n/content'
import { localePaths } from '../../i18n/ui'
import { getCompanyContent } from '../../company/companyContent'
import { DEVELOPER_EMAIL } from '../../lib/contact'
import type { ExtensionFeatureIcon } from '../../i18n/schema'
import MediaSlot from '../site/MediaSlot.astro'

interface Props {
  /** 当前 locale 路由。 */
  locale?: Locale
}

const { locale = 'en-US' } = Astro.props as Props
const t = getContent(locale)
const page = t.pages.extension
// locale 前缀（en-US 为空）；后续语言走 [lang]/ 路由时链接自动带上前缀。
const localePrefix = localePaths[locale] ? `/${localePaths[locale]}` : ''
const contactPath = `${localePrefix}/contact/`
const contactLabel = getCompanyContent(locale).contact.navLabel
// 安装教程区页内锚点：hero 的 Chrome 按钮与页底 CTA 滚动到这里（平滑滚动走 Layout 全局）。
const INSTALL_ANCHOR = '#install'
// 商店与 release 资产链接占位：上架/发版后按渠道回填（点击不 404）。
const EDGE_STORE_URL_PLACEHOLDER = '#'
const FIREFOX_STORE_URL_PLACEHOLDER = '#'
const RELEASE_ZIP_URL_PLACEHOLDER = '#'
// 示例数据资产占位：demo CSV 挂到公开 release 资产后回填（点击不 404）。
const DEMO_DATA_URL_PLACEHOLDER = '#'
const sectionId = (title: string) =>
  `feature-${title.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`
// 功能组图标注册表：icon key → 24×24 线性 SVG 内部路径（stroke=currentColor，色由容器 token 供）。
const featureIcons: Record<ExtensionFeatureIcon, string> = {
  business:
    '<path d="M4 9.5 5.5 4.5h13L20 9.5M5 9.5V19a.9.9 0 0 0 .9.9h12.2a.9.9 0 0 0 .9-.9V9.5M4 9.5h16M10 19.5v-5h4v5" />',
  reviews:
    '<path d="m12 3.8 2.5 5.1 5.6.8-4 4 .9 5.6-5-2.7-5 2.7.9-5.6-4-4 5.6-.8L12 3.8Z" />',
  photos:
    '<rect x="3.5" y="5" width="17" height="14" rx="2.5" /><circle cx="9" cy="10" r="1.5" /><path d="m5.5 17 4.5-4.5 3 3 2.5-2.5 3 3" />',
  enrichment:
    '<rect x="3.5" y="5" width="17" height="14" rx="2.5" /><path d="m4 7 8 5.5L20 7" />',
  batch:
    '<path d="M8.5 6h12M8.5 12h12M8.5 18h12M3.5 6h.01M3.5 12h.01M3.5 18h.01" />',
  export: '<path d="M12 4v10.5m0 0 4-4m-4 4-4-4M4.5 15.5v2.5a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-2.5" />'
}
---

<Layout
  locale={locale}
  title={page.seo.title}
  description={page.seo.description}
  includeSoftwareApplicationSchema={true}
>
  <div class="ext-page" data-extension-page>
    <!-- hero（左文右图，对齐竞品 hero 截图位） -->
    <section class="hero" aria-labelledby="ext-hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{page.hero.eyebrow}</p>
          <h1 id="ext-hero-title">{page.hero.title}</h1>
          <p class="hero-description">{page.hero.description}</p>
          <div class="hero-actions">
            <a
              class="btn-primary"
              href={EDGE_STORE_URL_PLACEHOLDER}
              data-cta="extension-hero-edge-install"
              aria-disabled="true"
            >{page.hero.edgeCta}</a>
            <a class="btn-secondary" href={INSTALL_ANCHOR} data-cta="extension-hero-chrome-install">
              {page.hero.chromeCta}
            </a>
          </div>
        </div>
        <MediaSlot variant="browser" ratio="4 / 3" label={page.hero.visualLabel} class="hero-visual" />
      </div>
    </section>

    <!-- 采集→导出成果展示（对齐竞品 Excel 导出大图 + 示例数据下载） -->
    <section class="showcase" aria-labelledby="ext-showcase-title">
      <div class="container">
        <header class="section-header">
          <p class="eyebrow">{page.showcase.eyebrow}</p>
          <h2 id="ext-showcase-title">{page.showcase.title}</h2>
          <p class="section-description">{page.showcase.description}</p>
        </header>
        <div class="showcase-grid">
          <MediaSlot variant="browser" ratio="16 / 10" label={page.showcase.panelLabel} />
          <MediaSlot variant="file" ratio="16 / 10" label={page.showcase.exportLabel} />
        </div>
        <div class="showcase-actions">
          <a
            class="btn-secondary"
            href={DEMO_DATA_URL_PLACEHOLDER}
            data-cta="extension-demo-data"
            aria-disabled="true"
          >{page.showcase.demoCta}</a>
          <p class="showcase-note">{page.showcase.demoNote}</p>
        </div>
      </div>
    </section>

    <!-- 功能清单（A5 36 列能力口径） -->
    <section class="features" aria-labelledby="ext-features-title">
      <div class="container">
        <header class="section-header">
          <p class="eyebrow">{page.features.eyebrow}</p>
          <h2 id="ext-features-title">{page.features.title}</h2>
          <p class="section-description">{page.features.description}</p>
        </header>
        <div class="feature-grid">
          {page.features.groups.map(group => (
            <article class="feature-card" id={sectionId(group.title)}>
              <span class="feature-icon" aria-hidden="true">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={featureIcons[group.icon]}
                />
              </span>
              <h3>{group.title}</h3>
              <p class="feature-description">{group.description}</p>
              <ul>
                {group.items.map(item => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 产品演示视频（素材录制后回填） -->
    <section class="demo" aria-labelledby="ext-demo-title">
      <div class="container demo-inner">
        <header class="section-header">
          <p class="eyebrow">{page.demo.eyebrow}</p>
          <h2 id="ext-demo-title">{page.demo.title}</h2>
          <p class="section-description">{page.demo.description}</p>
        </header>
        <MediaSlot variant="browser" ratio="16 / 9" label={page.demo.videoLabel} />
      </div>
    </section>

    <!-- 版本说明段（承接 changelog 职能） -->
    <section class="versions" aria-labelledby="ext-versions-title">
      <div class="container versions-inner">
        <header class="section-header">
          <p class="eyebrow">{page.versionNotes.eyebrow}</p>
          <h2 id="ext-versions-title">{page.versionNotes.title}</h2>
          <p class="section-description">{page.versionNotes.description}</p>
        </header>
        <ol class="release-list">
          {page.versionNotes.releases.map(release => (
            <li class="release-item" data-release={release.version}>
              <div class="release-head">
                <p class="release-version">{release.version}</p>
                <p class="release-date">{release.date}</p>
              </div>
              <ul>
                {release.changes.map(change => <li>{change}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 安装教程（hero 的 Chrome 按钮与页底 CTA 滚动到 #install） -->
    <section class="install" id="install" aria-labelledby="ext-install-title">
      <div class="container">
        <header class="section-header">
          <p class="eyebrow">{page.install.eyebrow}</p>
          <h2 id="ext-install-title">{page.install.title}</h2>
          <p class="section-description">{page.install.description}</p>
        </header>

        <!-- 直装 zip（release 资产占位） -->
        <div class="zip-card">
          <div class="zip-copy">
            <h3>{page.install.zip.title}</h3>
            <p>{page.install.zip.description}</p>
            <a
              class="btn-primary"
              href={RELEASE_ZIP_URL_PLACEHOLDER}
              data-cta="extension-install-zip"
              aria-describedby="ext-zip-note"
            >{page.install.zip.button}</a>
            <p class="zip-note" id="ext-zip-note">{page.install.zip.note}</p>
          </div>
          <MediaSlot
            variant="file"
            ratio="4 / 3"
            label={page.install.zip.visualLabel}
            class="zip-visual"
          />
        </div>

        <!-- 浏览器渠道：商店占位 + 分浏览器直装步骤 -->
        {page.install.channels.map(channel => (
          <div
            class="channel-card"
            aria-labelledby={`ext-${channel.id}-title`}
            data-channel={channel.id}
          >
            <h3 id={`ext-${channel.id}-title`}>{channel.name}</h3>
            <p class="channel-store">{channel.storeName}</p>
            <p class="channel-status">{channel.storeStatus}</p>
            <a
              class="btn-secondary"
              href={channel.id === 'edge' ? EDGE_STORE_URL_PLACEHOLDER : FIREFOX_STORE_URL_PLACEHOLDER}
              data-cta={`extension-store-${channel.id}`}
              aria-disabled="true"
            >{channel.storeCta}</a>
            <h4>{channel.manualTitle}</h4>
            <ol class="channel-steps">
              {channel.steps.map(step => (
                <li>
                  <p class="step-title">{step.title}</p>
                  {step.details.map(detail => <p>{detail}</p>)}
                  <MediaSlot
                    variant="browser"
                    ratio="16 / 9"
                    label={step.mediaLabel}
                    class="step-visual"
                  />
                </li>
              ))}
            </ol>
          </div>
        ))}

        <!-- 帮助 -->
        <div class="help-card">
          <h3>{page.install.help.title}</h3>
          <p>{page.install.help.description}</p>
          <a
            class="btn-secondary"
            href={`mailto:${DEVELOPER_EMAIL}?subject=MapsGrab%20installation%20help`}
            data-cta="extension-install-help"
          >{page.install.help.contactCta}</a>
          <a class="help-contact-link" href={contactPath} data-cta="extension-help-contact-page">{contactLabel}</a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-band" aria-labelledby="ext-cta-title">
      <div class="container cta-inner">
        <h2 id="ext-cta-title">{page.cta.title}</h2>
        <p>{page.cta.description}</p>
        <a class="btn-primary" href={INSTALL_ANCHOR} data-cta="extension-band-install">
          {page.cta.button}
        </a>
        {page.cta.note && <p class="cta-note">{page.cta.note}</p>}
      </div>
    </section>
  </div>
</Layout>

<style>
  .ext-page {
    padding-top: var(--space-10);
  }

  .eyebrow {
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .section-header h2,
  .hero h1 {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--text);
  }

  .hero h1 {
    max-width: 760px;
    font-size: clamp(32px, 4.2vw, 50px);
    line-height: 1.08;
  }

  .section-header h2 {
    font-size: 32px;
    line-height: 40px;
    letter-spacing: -0.02em;
  }

  .section-description {
    max-width: 680px;
    margin-top: var(--space-3);
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.6;
  }

  /* 按钮样式走 Layout 全局原语 .btn-primary / .btn-secondary（design.md §7） */

  .btn-primary:focus-visible,
  .btn-secondary:focus-visible,
  .help-contact-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  /* hero */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--space-16);
    align-items: center;
    padding: var(--space-10) 0 var(--space-16);
  }

  .hero-visual {
    min-width: 0;
  }

  .hero-description {
    max-width: 680px;
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  /* 成果展示（双图 + 示例数据下载） */
  .showcase {
    padding: var(--space-16) 0;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .showcase-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .showcase-actions .btn-secondary:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .showcase-note {
    color: var(--text-3);
    font-size: 13px;
    line-height: 1.6;
  }

  /* 功能清单 */
  .features {
    padding: var(--space-16) 0;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .feature-card {
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--rounded-md);
    background: var(--bg);
    box-shadow: var(--shadow-card);
    scroll-margin-top: 110px;
  }

  /* 功能组图标位：primary-soft 底 + primary 线性图标（design.md §1 soft 用途） */
  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--rounded-full);
    background: var(--primary-soft);
    color: var(--primary);
  }

  .feature-card h3 {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    line-height: 28px;
    color: var(--text);
  }

  .feature-description {
    margin-top: var(--space-2);
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.6;
  }

  .feature-card ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .feature-card li {
    position: relative;
    padding-left: var(--space-4);
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.55;
  }

  .feature-card li::before {
    position: absolute;
    top: 9px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: var(--rounded-full);
    background: var(--accent);
    content: '';
  }

  /* 版本说明 */
  .versions {
    padding: var(--space-16) 0;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .versions-inner {
    max-width: 800px;
  }

  .release-list {
    display: grid;
    gap: var(--space-6);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .release-item {
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--rounded-md);
    background: var(--bg);
  }

  .release-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }

  .release-version {
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
  }

  .release-date {
    color: var(--text-2);
    font-size: 13px;
  }

  .release-item ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding-left: var(--space-6);
  }

  .release-item li {
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.6;
  }

  /* 产品演示视频 */
  .demo {
    padding: var(--space-16) 0;
  }

  .demo-inner {
    max-width: 800px;
  }

  .demo-inner .media-slot {
    margin-top: var(--space-8);
  }

  /* 安装教程（zip 直装 + 渠道步骤 + 帮助；#install 锚点跳转避开吸顶导航） */
  .install {
    padding: var(--space-16) 0;
    scroll-margin-top: 110px;
  }

  .zip-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
    margin-top: var(--space-8);
    padding: var(--space-8);
    border: 1px solid var(--border);
    border-radius: var(--rounded-md);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .zip-copy > p {
    max-width: 640px;
    margin-top: var(--space-2);
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.6;
  }

  .zip-card h3 {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 32px;
    color: var(--text);
  }

  .zip-card .btn-primary {
    margin-top: var(--space-6);
  }

  .zip-note {
    margin-top: var(--space-3);
    color: var(--text-2);
    font-size: 13px;
    line-height: 1.6;
  }

  .channel-card {
    margin-top: var(--space-6);
    padding: var(--space-8);
    border: 1px solid var(--border);
    border-radius: var(--rounded-md);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .channel-card h3 {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 32px;
    color: var(--text);
  }

  .channel-store {
    margin-top: var(--space-1);
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .channel-status {
    max-width: 640px;
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--warn);
    border-radius: var(--rounded-sm);
    background: var(--warn-soft);
    color: var(--text);
    font-size: 14px;
    line-height: 1.6;
  }

  .channel-card .btn-secondary {
    margin-top: var(--space-4);
  }

  .channel-card h4 {
    margin-top: var(--space-8);
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    line-height: 28px;
    color: var(--text);
  }

  .channel-steps {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: ext-step;
  }

  .channel-steps li {
    counter-increment: ext-step;
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--rounded-sm);
    background: var(--bg);
  }

  .step-title::before {
    content: counter(ext-step) '. ';
    color: var(--primary);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .step-title {
    color: var(--text);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.6;
  }

  .channel-steps li p:not(.step-title) {
    margin-top: var(--space-1);
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.6;
  }

  .step-visual {
    max-width: 520px;
    margin-top: var(--space-4);
  }

  .help-card {
    margin-top: var(--space-6);
    padding: var(--space-8);
    border: 1px solid var(--border);
    border-radius: var(--rounded-md);
    background: var(--surface-2);
    text-align: center;
  }

  .help-card h3 {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 32px;
    color: var(--text);
  }

  .help-card > p {
    max-width: 640px;
    margin: var(--space-2) auto 0;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.6;
  }

  .help-card .btn-secondary {
    margin-top: var(--space-6);
  }

  .help-contact-link {
    display: block;
    margin-top: var(--space-3);
    color: var(--primary-hover);
    font-size: 14px;
    font-weight: 600;
  }

  .help-contact-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* CTA */
  .cta-band {
    padding: var(--space-16) 0 var(--space-24);
  }

