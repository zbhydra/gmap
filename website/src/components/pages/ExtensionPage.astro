---
/**
 * 插件产品页渲染器（W2：功能清单 + 版本说明段 + 安装引导）。
 *
 * 功能口径对齐 013 A5 36 列与 A1/A2/A3/A4/A6/A8 能力；
 * 版本说明段承接 changelog 职能；CTA 带 data-cta 归因属性（事件经 W6 GA4 通道上报）。
 * 图文分区（015 D5 图文改造）：hero/showcase/demo 配图走 MediaSlot 占位，
 * 素材产出后仅回填 src，不动结构。
 */
import Layout from '../../layouts/Layout.astro'
import { getContent, type Locale } from '../../i18n/content'
import { localePaths } from '../../i18n/ui'
import type { ExtensionFeatureIcon } from '../../i18n/schema'
import MediaSlot from '../site/MediaSlot.astro'

interface Props {
  /** 当前 locale 路由。 */
  locale?: Locale
}

const { locale = 'en-US' } = Astro.props as Props
const t = getContent(locale)
const page = t.pages.extension
// locale 前缀（en-US 为空）；后续语言走 [lang]/ 路由时链接自动带上前缀。
const localePrefix = localePaths[locale] ? `/${localePaths[locale]}` : ''
const downloadPath = `${localePrefix}/download/`
const pricingPath = `${localePrefix}/pricing/`
// CTA 归因：站内链接带 utm；事件侧用 data-cta（cta_click 事件经 W6 GA4 通道上报）。
const installHref = `${downloadPath}?utm_source=website&utm_medium=extension-hero&utm_campaign=install`
// 示例数据资产占位：demo CSV 挂到公开 release 资产后回填（同下载页占位口径，点击不 404）。
const DEMO_DATA_URL_PLACEHOLDER = '#'
const sectionId = (title: string) =>
  `feature-${title.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')}`
// 功能组图标注册表：icon key → 24×24 线性 SVG 内部路径（stroke=currentColor，色由容器 token 供）。
const featureIcons: Record<ExtensionFeatureIcon, string> = {
  business:
    '<path d="M4 9.5 5.5 4.5h13L20 9.5M5 9.5V19a.9.9 0 0 0 .9.9h12.2a.9.9 0 0 0 .9-.9V9.5M4 9.5h16M10 19.5v-5h4v5" />',
  reviews:
    '<path d="m12 3.8 2.5 5.1 5.6.8-4 4 .9 5.6-5-2.7-5 2.7.9-5.6-4-4 5.6-.8L12 3.8Z" />',
  photos:
    '<rect x="3.5" y="5" width="17" height="14" rx="2.5" /><circle cx="9" cy="10" r="1.5" /><path d="m5.5 17 4.5-4.5 3 3 2.5-2.5 3 3" />',
  enrichment:
    '<rect x="3.5" y="5" width="17" height="14" rx="2.5" /><path d="m4 7 8 5.5L20 7" />',
  batch:
    '<path d="M8.5 6h12M8.5 12h12M8.5 18h12M3.5 6h.01M3.5 12h.01M3.5 18h.01" />',
  export: '<path d="M12 4v10.5m0 0 4-4m-4 4-4-4M4.5 15.5v2.5a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-2.5" />'
}
---

<Layout
  locale={locale}
  title={page.seo.title}
  description={page.seo.description}
  includeSoftwareApplicationSchema={true}
>
  <div class="ext-page" data-extension-page>
    <!-- hero（左文右图，对齐竞品 hero 截图位） -->
    <section class="hero" aria-labelledby="ext-hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{page.hero.eyebrow}</p>
          <h1 id="ext-hero-title">{page.hero.title}</h1>
          <p class="hero-description">{page.hero.description}</p>
          <div class="hero-actions">
            <a class="btn-primary" href={installHref} data-cta="extension-hero-install">
              {page.hero.primaryCta}
            </a>
            <a
              class="btn-secondary"
              href={`${pricingPath}?utm_source=website&utm_medium=extension-hero&utm_campaign=pricing`}
              data-cta="extension-hero-pricing"
            >{page.hero.secondaryCta}</a>
          </div>
        </div>
        <MediaSlot variant="browser" ratio="4 / 3" label={page.hero.visualLabel} class="hero-visual" />
      </div>
    </section>

    <!-- 采集→导出成果展示（对齐竞品 Excel 导出大图 + 示例数据下载） -->
    <section class="showcase" aria-labelledby="ext-showcase-title">
      <div class="container">
        <header class="section-header">
          <p class="eyebrow">{page.showcase.eyebrow}</p>
          <h2 id="ext-showcase-title">{page.showcase.title}</h2>
          <p class="section-description">{page.showcase.description}</p>
        </header>
        <div class="showcase-grid">
          <MediaSlot variant="browser" ratio="16 / 10" label={page.showcase.panelLabel} />
          <MediaSlot variant="file" ratio="16 / 10" label={page.showcase.exportLabel} />
        </div>
        <div class="showcase-actions">
          <a
            class="btn-secondary"
            href={DEMO_DATA_URL_PLACEHOLDER}
            data-cta="extension-demo-data"
            aria-disabled="true"
          >{page.showcase.demoCta}</a>
          <p class="showcase-note">{page.showcase.demoNote}</p>
        </div>
      </div>
    </section>

    <!-- 功能清单（A5 36 列能力口径） -->
    <section class="features" aria-labelledby="ext-features-title">
      <div class="container">
        <header class="section-header">
          <p class="eyebrow">{page.features.eyebrow}</p>
          <h2 id="ext-features-title">{page.features.title}</h2>
          <p class="section-description">{page.features.description}</p>
        </header>
        <div class="feature-grid">
          {page.features.groups.map(group => (
            <article class="feature-card" id={sectionId(group.title)}>
              <span class="feature-icon" aria-hidden="true">
                <svg
                  width="22"
                  height="22"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={featureIcons[group.icon]}
                />
              </span>
              <h3>{group.title}</h3>
              <p class="feature-description">{group.description}</p>
              <ul>
                {group.items.map(item => <li>{item}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 产品演示视频（素材录制后回填） -->
    <section class="demo" aria-labelledby="ext-demo-title">
      <div class="container demo-inner">
        <header class="section-header">
          <p class="eyebrow">{page.demo.eyebrow}</p>
          <h2 id="ext-demo-title">{page.demo.title}</h2>
          <p class="section-description">{page.demo.description}</p>
        </header>
        <MediaSlot variant="browser" ratio="16 / 9" label={page.demo.videoLabel} />
      </div>
    </section>

    <!-- 版本说明段（承接 changelog 职能） -->
    <section class="versions" aria-labelledby="ext-versions-title">
      <div class="container versions-inner">
        <header class="section-header">
          <p class="eyebrow">{page.versionNotes.eyebrow}</p>
          <h2 id="ext-versions-title">{page.versionNotes.title}</h2>
          <p class="section-description">{page.versionNotes.description}</p>
        </header>
        <ol class="release-list">
          {page.versionNotes.releases.map(release => (
            <li class="release-item" data-release={release.version}>
              <div class="release-head">
                <p class="release-version">{release.version}</p>
                <p class="release-date">{release.date}</p>
              </div>
              <ul>
                {release.changes.map(change => <li>{change}</li>)}
              </ul>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 安装引导 -->
    <section class="install" aria-labelledby="ext-install-title">
      <div class="container install-inner">
        <header class="section-header">
          <p class="eyebrow">{page.install.eyebrow}</p>
          <h2 id="ext-install-title">{page.install.title}</h2>
          <p class="section-description">{page.install.description}</p>
        </header>
        <ol class="install-steps">
          {page.install.steps.map((step, index) => (
            <li class="install-step">
              <p class="step-number" aria-hidden="true">{index + 1}</p>
              <div class="install-step-body">
                <h3>{step.title}</h3>
                {step.details.map(detail => <p>{detail}</p>)}
                <MediaSlot
                  variant="browser"
                  ratio="16 / 9"
                  label={step.mediaLabel}
                  class="install-step-visual"
                />
              </div>
            </li>
          ))}
        </ol>
        <a
          class="btn-primary"
          href={`${downloadPath}?utm_source=website&utm_medium=extension-install&utm_campaign=install`}
          data-cta="extension-install-download"
        >{page.install.downloadCta}</a>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-band" aria-labelledby="ext-cta-title">
      <div class="container cta-inner">
        <h2 id="ext-cta-title">{page.cta.title}</h2>
        <p>{page.cta.description}</p>
        <a class="btn-primary" href={installHref} data-cta="extension-band-install">
          {page.cta.button}
        </a>
        {page.cta.note && <p class="cta-note">{page.cta.note}</p>}
      </div>
    </section>
  </div>
</Layout>

<style>
  .ext-page {
    padding-top: var(--space-10);
  }

  .eyebrow {
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .section-header h2,
  .hero h1 {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--text);
  }

  .hero h1 {
    max-width: 760px;
    font-size: clamp(32px, 4.2vw, 50px);
    line-height: 1.08;
  }

  .section-header h2 {
    font-size: 32px;
    line-height: 40px;
    letter-spacing: -0.02em;
  }

  .section-description {
    max-width: 680px;
    margin-top: var(--space-3);
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.6;
  }

  /* 按钮样式走 Layout 全局原语 .btn-primary / .btn-secondary（design.md §7） */

  .btn-primary:focus-visible,
  .btn-secondary:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  /* hero */
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: var(--space-16);
    align-items: center;
    padding: var(--space-10) 0 var(--space-16);
  }

  .hero-visual {
    min-width: 0;
  }

  .hero-description {
    max-width: 680px;
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: 18px;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  /* 成果展示（双图 + 示例数据下载） */
  .showcase {
    padding: var(--space-16) 0;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .showcase-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .showcase-actions .btn-secondary:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  .showcase-note {
    color: var(--text-3);
    font-size: 13px;
    line-height: 1.6;
  }

  /* 功能清单 */
  .features {
    padding: var(--space-16) 0;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .feature-card {
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--rounded-md);
    background: var(--bg);
    box-shadow: var(--shadow-card);
    scroll-margin-top: 110px;
  }

  /* 功能组图标位：primary-soft 底 + primary 线性图标（design.md §1 soft 用途） */
  .feature-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--rounded-full);
    background: var(--primary-soft);
    color: var(--primary);
  }

  .feature-card h3 {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    line-height: 28px;
    color: var(--text);
  }

  .feature-description {
    margin-top: var(--space-2);
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.6;
  }

  .feature-card ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .feature-card li {
    position: relative;
    padding-left: var(--space-4);
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.55;
  }

  .feature-card li::before {
    position: absolute;
    top: 9px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: var(--rounded-full);
    background: var(--accent);
    content: '';
  }

  /* 版本说明 */
  .versions {
    padding: var(--space-16) 0;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .versions-inner {
    max-width: 800px;
  }

  .release-list {
    display: grid;
    gap: var(--space-6);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .release-item {
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--rounded-md);
    background: var(--bg);
  }

  .release-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }

  .release-version {
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
  }

  .release-date {
    color: var(--text-2);
    font-size: 13px;
  }

  .release-item ul {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding-left: var(--space-6);
  }

  .release-item li {
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.6;
  }

  /* 产品演示视频 */
  .demo {
    padding: var(--space-16) 0;
  }

  .demo-inner {
    max-width: 800px;
  }

  .demo-inner .media-slot {
    margin-top: var(--space-8);
  }

  /* 安装引导 */
  .install {
    padding: var(--space-16) 0;
  }

  .install-steps {
    display: grid;
    gap: var(--space-6);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .install-step {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--rounded-md);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex: 0 0 32px;
    border-radius: var(--rounded-full);
    background: var(--primary-soft);
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 600;
  }

  .install-step h3 {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    color: var(--text);
  }

  .install-step p {
    margin-top: var(--space-1);
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.6;
  }

  .install-step-body {
    flex: 1;
    min-width: 0;
  }

  .install-step-visual {
    max-width: 560px;
    margin-top: var(--space-4);
  }

  .install-inner .btn-primary {
    margin-top: var(--space-8);
  }

  /* CTA */
  .cta-band {
    padding: var(--space-16) 0 var(--space-24);
  }

  .cta-inner {
    padding: var(--space-16) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--rounded-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    text-align: center;
  }

  .cta-inner h2 {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 600;
    line-height: 40px;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .cta-inner > p {
    max-width: 560px;
    margin: var(--space-3) auto 0;
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.6;
  }

  .cta-inner .btn-primary {
    margin-top: var(--space-6);
  }

  .cta-note {
    margin-top: var(--space-3);
    color: var(--text-3);
    font-size: 13px;
  }

  @media (max-width: 960px) {
    .feature-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
      padding: var(--space-6) 0 var(--space-10);
    }

    .showcase-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .showcase,
    .demo,
    .features,
    .versions,
    .install {
      padding: var(--space-10) 0;
    }

    .cta-band {
      padding: var(--space-10) 0 var(--space-16);
    }

    .cta-inner {
      padding: var(--space-10) var(--space-4);
    }
  }
</style>
