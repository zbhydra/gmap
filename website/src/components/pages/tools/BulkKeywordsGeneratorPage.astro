---
/**
 * Bulk Keywords Generator 工具页：关键词 × 地点组合批量生成。
 */
import Icon from '../../site/Icon.astro'
import ToolGuide from '../../tools/ToolGuide.astro'
import ToolShell from '../../tools/ToolShell.astro'
import { getContent, type Locale } from '../../../i18n/content'

interface Props {
  locale: Locale
}

const { locale } = Astro.props

const common = getContent(locale).pages.tools.common
const tool = getContent(locale).pages.tools.bulkKeywords
const copyJson = JSON.stringify({ common, content: tool })
---

<ToolShell locale={locale} toolId="bulk-keywords-generator" content={tool} howToSteps={tool.howTo} copyJson={copyJson}>
  <div class="tool-panel">
    <form class="tool-form" data-tool-form autocomplete="off" novalidate>
      <div class="tool-form-row">
        <div class="field">
          <label class="field-label" for="keywords-input">{tool.form.keywordsLabel}</label>
          <textarea
            class="textarea tool-mono"
            id="keywords-input"
            placeholder={tool.form.keywordsPlaceholder}
            spellcheck="false"
            data-keywords></textarea>
        </div>
        <div class="field">
          <label class="field-label" for="locations-input">{tool.form.locationsLabel}</label>
          <textarea
            class="textarea tool-mono"
            id="locations-input"
            placeholder={tool.form.locationsPlaceholder}
            spellcheck="false"
            data-locations></textarea>
        </div>
      </div>
      <div class="field tool-order" role="radiogroup" aria-labelledby="order-label" data-order>
        <span class="field-label" id="order-label">{tool.form.orderLabel}</span>
        <label><input type="radio" name="order" value="keyword-first" checked />{tool.form.keywordFirst}</label>
        <label><input type="radio" name="order" value="location-first" />{tool.form.locationFirst}</label>
      </div>
      <p class="tool-error" role="alert" data-tool-error hidden><Icon name="info" /><span data-tool-error-text></span></p>
      <div class="tool-actions">
        <button class="btn btn-primary" type="submit" data-ga-event="tool_use" data-ga-tool-id="bulk-keywords">
          {tool.form.submit}<Icon name="arrow-right" class="icon-arrow" />
        </button>
      </div>
    </form>

    <section class="tool-result" data-tool-result hidden aria-label={common.resultHeading}>
      <h2 class="tool-result-label">{common.resultHeading}</h2>
      <p class="tool-summary" data-count-summary></p>
      <textarea
        class="textarea tool-mono tool-preview"
        readonly
        spellcheck="false"
        aria-label={common.resultHeading}
        data-combinations></textarea>
      <div class="tool-actions">
        <button
          class="btn btn-secondary btn-sm"
          type="button"
          data-copy-combinations
          data-ga-event="tool_copy"
          data-ga-tool-id="bulk-keywords"
        >
          <Icon name="copy" />{common.copy}
        </button>
        <button
          class="btn btn-secondary btn-sm"
          type="button"
          data-download-combinations
          data-ga-event="tool_download"
          data-ga-tool-id="bulk-keywords"
        >
          <Icon name="download" />{common.downloadCsv}
        </button>
      </div>
    </section>
  </div>

  <ToolGuide slot="guide" head={common.guide} sections={tool.howTo} />
</ToolShell>

<style>
  /* 组合顺序：选项带示例（keyword + location (design agency New York)），各语言 40–65 字，
     放不进分段控件，用纵向排列的原生单选，长文案自然换行 */
  .tool-order label {
    display: flex;
    align-items: baseline;
    gap: var(--s-2);
    color: var(--text-2);
    font-size: 14.5px;
    cursor: pointer;
  }

  .tool-order input {
    flex: none;
  }
</style>

<script src="../../../scripts/tools/bulkKeywords.ts"></script>
