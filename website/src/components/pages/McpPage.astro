---
/**
 * MCP 落地页（W4）：/google-maps-scraper-mcp。
 *
 * 事实按 014 合同（docs/feat/014.Maps云端/tech-API与MCP.md）：Streamable HTTP 入口 {PUBLIC_API_BASE_URL}/mcp/（必须带结尾斜杠），
 * 工具 search_places / list_reviews，API Key 或 OAuth access token 以 Authorization: Bearer 携带；照片工具尚无合同，只标 Coming soon。
 * 获取 Key 按钮绑 mcp 能力；额度与价格逐字取自 pricing.ts 的 API tab。
 * 会话轮播与拓扑高亮由 scripts/pages/mcp-page.ts 驱动；无 JS 与减弱动效下展示首个场景与静态拓扑。
 */
import { Code } from 'astro:components'
import Layout from '../../layouts/Layout.astro'
import { getContent, type Locale } from '../../i18n/content'
import type { McpClientId, ProductCtaMessage, ProductFaqMessage } from '../../i18n/schema'
import { localePaths } from '../../i18n/ui'
import { capabilities } from '../../lib/capabilities'
import CapabilityAction from '../site/CapabilityAction.astro'
import Icon from '../site/Icon.astro'
import SoonBadge from '../site/SoonBadge.astro'
import SplitWords from '../site/SplitWords.astro'
import CodeText from '../api/CodeText.astro'
import McpScene from '../api/McpScene.astro'
import { MCP_URL } from '../api/endpoints'
import AccentHeading from '../product/AccentHeading.astro'
import ProductCta from '../product/ProductCta.astro'
import ProductFaq from '../product/ProductFaq.astro'
import { faqPageSchema } from '../product/faq-schema'

interface Props {
  locale?: Locale
}

const { locale = 'en-US' } = Astro.props
const t = getContent(locale)
const page = t.pages.scraperMcp
const shared = t.pages.apiPage
const prefix = localePaths[locale] ? `/${localePaths[locale]}` : ''
const pageId = 'google-maps-scraper-mcp'
const keyHref = `${prefix}/dashboard/api/`
const pricingHref = (medium: string) =>
  `${prefix}/pricing/?product_kind=maps_api&utm_source=website&utm_medium=${pageId}-${medium}&utm_campaign=pricing`

/** 014 合同里的 MCP 服务名（客户端连接后显示的名称）。 */
const SERVER_NAME = 'MapsGrab'
const mcpHost = new URL(MCP_URL).host
const [connectedBefore, connectedAfter = ''] = page.agent.connected.split('{server}')

/** 客户端顺序与通用图标（不用品牌 logo）。 */
const CLIENT_IDS: readonly McpClientId[] = ['claude', 'cursor', 'vscode', 'codex']
const CLIENT_ICONS: Record<McpClientId, string> = { claude: 'sparkles', cursor: 'cursor', vscode: 'code', codex: 'terminal' }

/** 各客户端的接入配置（远程 Streamable HTTP + Bearer 头；VS Code 用安全输入，Codex 从环境变量读 Key）。 */
const CONFIGS: Record<McpClientId, { lang: 'bash' | 'json' | 'toml'; code: string }> = {
  claude: {
    lang: 'bash',
    code: `claude mcp add --transport http mapsgrab ${MCP_URL} \\\n  --header "Authorization: Bearer YOUR_API_KEY"`
  },
  cursor: {
    lang: 'json',
    code: JSON.stringify({ mcpServers: { mapsgrab: { url: MCP_URL, headers: { Authorization: 'Bearer YOUR_API_KEY' } } } }, null, 2)
  },
  vscode: {
    lang: 'json',
    code: JSON.stringify(
      {
        inputs: [{ type: 'promptString', id: 'mapsgrab-api-key', description: 'MapsGrab API key', password: true }],
        servers: { mapsgrab: { type: 'http', url: MCP_URL, headers: { Authorization: 'Bearer ${input:mapsgrab-api-key}' } } }
      },
      null,
      2
    )
  },
  codex: {
    lang: 'toml',
    code: `[mcp_servers.mapsgrab]\nurl = "${MCP_URL}"\nbearer_token_env_var = "MAPSGRAB_API_KEY"`
  }
}

/** 认证检视器：一次 tools/call 的请求与响应（响应结构与后端 CallToolResult 序列化一致）。 */
const INSPECT_REQUEST = [
  'POST /mcp/ HTTP/1.1',
  `Host: ${mcpHost}`,
  'Authorization: Bearer YOUR_API_KEY',
  'Content-Type: application/json',
  '',
  '{',
  '  "jsonrpc": "2.0", "id": 7, "method": "tools/call",',
  '  "params": {',
  '    "name": "list_reviews",',
  '    "arguments": {"fid": "0x5495…e0ab", "sort_by": 2}',
  '  }',
  '}'
].join('\n')
const INSPECT_RESPONSE = [
  '{',
  '  "jsonrpc": "2.0", "id": 7,',
  '  "result": {',
  '    "content": [{"type": "text", "text": "{\\"reviews\\": […"}],',
  '    "structuredContent": {',
  '      "reviews": [{"rating": 5, "author_name": "Maya R.", …}],',
  '      "next_cursor": "CAESBkVnSUlDZw…"',
  '    },',
  '    "isError": false',
  '  }',
  '}'
].join('\n')

// 首屏勾选行与计费阶梯都取 pricing.ts 的 API tab。
const apiPlans = t.pages.pricing.tabs.api
const freePlan = apiPlans.cards.find(card => card.status === 'free')
if (!freePlan) throw new Error('[mcp-page] pricing.ts API tab has no free plan card for the {quota} hero line.')
const heroMeta = page.hero.meta.map(item => item.replace('{quota}', freePlan.quota))
const quotaOf = (quota: string) => {
  const match = quota.match(/[\d,]+/)
  if (!match) throw new Error(`[mcp-page] Cannot read a request count from pricing quota "${quota}".`)
  return Number(match[0].replace(/,/g, ''))
}
const maxQuota = Math.max(...apiPlans.cards.map(card => quotaOf(card.quota)))
// 对数刻度：免费档 20 与 Scale 50,000 同屏可读；最短条保留 6% 可见长度。
const ladder = apiPlans.cards.map(card => ({
  card,
  width: Math.max(0.06, Math.log10(quotaOf(card.quota)) / Math.log10(maxQuota))
}))

// FAQ 与收尾 CTA：标题、问答与导语按页，kicker、侧栏导语、按钮与说明是 API / MCP 共用文案。
const faq: ProductFaqMessage = { ...shared.faq, kicker: t.common.faqLabel, title: page.faq.title, items: page.faq.items }
const cta: ProductCtaMessage = { ...shared.cta, title: page.cta.title, lead: page.cta.lead, primary: shared.primaryCta, secondary: shared.pricingCta }
---

<Layout
  locale={locale}
  title={page.seo.title}
  description={page.seo.description}
  includeSoftwareApplicationSchema={false}
  structuredData={[faqPageSchema(faq.items)]}
  preloadAccentFont
>
  <div class="mcp-page" data-mcp-page>
    <!-- ① Hero：标题 + 示例会话（提问 → 工具调用 → 回答，轮播四个场景） -->
    <section class="page-hero mcp-hero has-deco" data-inview>
      <div class="deco" aria-hidden="true">
        <div class="aurora"><i></i><i></i><i></i></div>
        <div class="bg-contours"></div>
        <div class="bg-grid"></div>
        <div class="noise"></div>
      </div>

      <div class="container page-hero-grid">
        <div class="page-hero-copy">
          <span class="kicker kicker--ai" data-enter><Icon name="plug" />{page.hero.kicker}</span>

          <h1 class="h1 mcp-title" data-split="static" style="--split-delay: 90ms">
            <SplitWords parts={[page.hero.title.lead, { text: page.hero.title.accent, class: 'accent text-grad-ai' }, page.hero.title.tail]} />
          </h1>

          <p class="lead" data-enter style="--enter-delay: 180ms">{page.hero.lead}</p>

          <div class="page-hero-actions" data-enter style="--enter-delay: 270ms">
            <CapabilityAction capability="mcp" locale={locale} href={keyHref} class="btn btn-primary btn-lg" data-magnetic="0.22" data-cta={`${pageId}-hero-api-dashboard`}>
              <Icon name="key" />{shared.primaryCta}
            </CapabilityAction>
            <a class="btn btn-secondary btn-lg" href={pricingHref('hero')} data-cta={`${pageId}-hero-pricing`}>{shared.pricingCta}</a>
          </div>

          <div class="page-hero-meta" data-enter style="--enter-delay: 360ms">
            {heroMeta.map(item => <span><Icon name="check" />{item}</span>)}
          </div>
        </div>

        <div class="page-hero-visual mcp-stage" data-reveal="right" data-reveal-onload="520">
          <div class="mcp-agent" role="img" aria-label={page.agent.label} data-mcp-agent>
            <div class="mcp-agent-bar">
              <div class="win-dots" aria-hidden="true"><i></i><i></i><i></i></div>
              <span class="mcp-agent-title">{page.agent.session}</span>
              <span class="badge badge--ai mcp-agent-client" data-mcp-client>{page.clients[CLIENT_IDS[0]]}</span>
            </div>
            <p class="mcp-agent-conn">
              <span class="dot dot--live"></span>
              <span>{connectedBefore}<b>{SERVER_NAME}</b>{connectedAfter}</span>
            </p>
            <div class="mcp-agent-body" data-mcp-stage>
              <McpScene scene={page.agent.scenes[0]} thinking={page.agent.thinking} running={page.agent.running} />
            </div>
            <div class="mcp-agent-input">
              <span class="mcp-input" data-mcp-input>{page.agent.placeholder}</span>
              <span class="mcp-send"><Icon name="send" /></span>
            </div>
          </div>
          {page.agent.scenes.map((scene, index) => (
            <template data-mcp-scene data-client={page.clients[CLIENT_IDS[index % CLIENT_IDS.length]]}>
              <McpScene scene={scene} thinking={page.agent.thinking} running={page.agent.running} />
            </template>
          ))}

          <div class="float-chip mcp-fc mcp-fc--a floaty" style="--float-t: 7s" aria-hidden="true">
            <span class="icon-tile icon-tile--ai"><Icon name="plug" /></span>
            <span><small>{page.hero.chips[0].label}</small>{page.hero.chips[0].value}</span>
          </div>
          <div class="float-chip mcp-fc mcp-fc--b floaty" style="--float-t: 8s; --float-d: -3s" data-parallax="-0.05" aria-hidden="true">
            <span class="icon-tile icon-tile--ok"><Icon name="braces" /></span>
            <span><small>{page.hero.chips[1].label}</small>{page.hero.chips[1].value}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ② 工具：search_places / list_reviews + 照片工具 Coming soon -->
    <section class="section" id="tools">
      <div class="container">
        <header class="section-head" data-stagger="80">
          <span class="kicker kicker--ai" data-reveal>{page.tools.kicker}</span>
          <h2 class="h2" data-split><AccentHeading title={page.tools.title} /></h2>
          <p class="lead" data-reveal>{page.tools.lead}</p>
        </header>

        <div class="mcp-tools" data-stagger="90" data-spotlight-group>
          {page.tools.items.map((tool, index) => (
            <article class="mcp-tool card card--lift" data-spotlight data-reveal>
              <div class="mcp-tool-top">
                <span class="icon-tile icon-tile--ai"><Icon name={tool.icon} /></span>
                <span class="mcp-tool-kind">{page.tools.kind}</span>
              </div>
              <code class="mcp-tool-name">{tool.name}</code>
              <h3>{tool.title}</h3>
              <p>{tool.description}</p>
              <dl class="mcp-tool-args">
                {tool.args.map(arg => (
                  <div>
                    <dt><code>{arg.name}</code></dt>
                    <dd><CodeText text={arg.description} /></dd>
                  </div>
                ))}
              </dl>
              <div class="mcp-tool-returns">
                <span>{page.tools.returns}</span>
                <code>{tool.returns}</code>
              </div>
              <a class="link-arrow" href={`${prefix}/${index === 0 ? 'google-maps-scraper-api' : 'google-maps-reviews-scraper-api'}/`} data-cta={`${pageId}-tool-${tool.name}`}>
                {tool.link}<Icon name="arrow-right" />
              </a>
            </article>
          ))}
          <article class="mcp-tool mcp-tool--soon card" data-reveal>
            <div class="mcp-tool-top">
              <span class="icon-tile"><Icon name="image" /></span>
              {!capabilities.photosApi && <SoonBadge locale={locale} />}
            </div>
            <h3>{page.tools.photos.title}</h3>
            <p>{page.tools.photos.description}</p>
            <a
              class:list={['link-arrow', { 'is-unavailable': !capabilities.photosApi }]}
              href={`${prefix}/google-maps-photos-api/`}
              data-cta={`${pageId}-tool-photos`}
            >
              {page.tools.photos.link}<Icon name="arrow-right" />
            </a>
          </article>
        </div>
      </div>
    </section>

    <!-- ③ 连接拓扑（恒暗主题岛）：客户端 → MCP 入口 → 工具 -->
    <section class="section mcp-flow scheme-dark has-deco" id="how-it-works" data-inview>
      <div class="deco" aria-hidden="true">
        <div class="bg-grid mcp-flow-grid"></div>
        <div class="mcp-flow-glow"></div>
        <div class="noise"></div>
      </div>
      <div class="container">
        <header class="section-head" data-stagger="80">
          <span class="kicker kicker--ai" data-reveal>{page.flow.kicker}</span>
          <h2 class="h2" data-split><AccentHeading title={page.flow.title} accentClass="text-grad-ai" /></h2>
          <p class="lead" data-reveal>{page.flow.lead}</p>
        </header>

        <div class="topo" role="img" aria-label={page.flow.label} data-mcp-topo data-reveal>
          <div class="topo-col">
            <span class="topo-label">{page.flow.clientsLabel}</span>
            {CLIENT_IDS.map((id, index) => (
              <span class:list={['topo-node', { 'is-active': index === 0 }]} data-topo-client>
                <Icon name={CLIENT_ICONS[id]} />{page.clients[id]}
              </span>
            ))}
            <span class="topo-node topo-node--any"><Icon name="plug" />{page.flow.anyClient}</span>
          </div>

          <div class="topo-wire topo-wire--in">
            <span class="topo-dash"></span>
            <span class="topo-rail"><span class="topo-pulse"></span></span>
          </div>

          <div class="topo-hub">
            <span class="topo-hub-icon"><Icon name="bot" /></span>
            <b>{page.flow.hub}</b>
            <code class="topo-url">{mcpHost}/mcp/</code>
            <span class="topo-auth"><Icon name="key" />Authorization: Bearer</span>
            <span class="topo-call">
              <code data-topo-call-tool>{page.tools.items[0].name}</code>
              <span>→ {page.flow.resultLabel}</span>
              <b data-topo-call-result>{page.flow.results[0]}</b>
            </span>
          </div>

          <div class="topo-wire topo-wire--out">
            <span class="topo-dash"></span>
            <span class="topo-rail"><span class="topo-pulse"></span></span>
          </div>

          <div class="topo-col">
            <span class="topo-label">{page.flow.toolsLabel}</span>
            {page.tools.items.map((tool, index) => (
              <span class:list={['topo-node topo-node--tool', { 'is-active': index === 0 }]} data-topo-tool={tool.name} data-topo-result={page.flow.results[index]}>
                <Icon name={tool.icon} /><code>{tool.name}</code>
              </span>
            ))}
            <span class="topo-node topo-node--soon">
              <Icon name="image" />{page.flow.photos}
              {!capabilities.photosApi && <SoonBadge locale={locale} />}
            </span>
            <span class="topo-foot"><Icon name="globe" />{page.flow.publicData}</span>
          </div>
        </div>

        <ol class="topo-steps" data-stagger="90">
          {page.flow.steps.map((step, index) => (
            <li data-reveal>
              <span class="topo-step-num">{String(index + 1).padStart(2, '0')}</span>
              <b>{step.title}</b>
              <span>{step.description}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ④ 接入：每个客户端一段配置 + OAuth 说明 + 通用规格 -->
    <section class="section band" id="setup">
      <div class="container">
        <header class="section-head" data-stagger="80">
          <span class="kicker kicker--ai" data-reveal>{page.setup.kicker}</span>
          <h2 class="h2" data-split><AccentHeading title={page.setup.title} /></h2>
          <p class="lead" data-reveal>{page.setup.lead}</p>
        </header>

        <div class="setup" data-tabs data-reveal>
          <div class="seg setup-tabs" role="tablist" aria-label={page.setup.tabsLabel}>
            <span class="seg-thumb" aria-hidden="true"></span>
            {CLIENT_IDS.map((id, index) => (
              <button
                class="seg-btn"
                type="button"
                role="tab"
                id={`mcp-setup-tab-${id}`}
                aria-controls={`mcp-setup-${id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                data-tab={id}
              >
                <Icon name={CLIENT_ICONS[id]} />{page.clients[id]}
              </button>
            ))}
          </div>
          {CLIENT_IDS.map((id, index) => (
            <div class="setup-panel" role="tabpanel" id={`mcp-setup-${id}`} aria-labelledby={`mcp-setup-tab-${id}`} hidden={index !== 0}>
              <ol class="setup-steps">
                {page.setup.clients[id].steps.map((step, stepIndex) => (
                  <li>
                    <span class="setup-num">{stepIndex + 1}</span>
                    <div>
                      <b>{step.title}</b>
                      <p><CodeText text={step.description} /></p>
                    </div>
                  </li>
                ))}
              </ol>
              <div class="codewin setup-code">
                <div class="codewin-bar">
                  <div class="win-dots" aria-hidden="true"><i></i><i></i><i></i></div>
                  <span class="setup-file">{page.setup.clients[id].file}</span>
                  <button class="codewin-copy" type="button" aria-label={page.setup.copy} data-copy={CONFIGS[id].code}>
                    <Icon name="copy" class="icon--sm" />
                  </button>
                </div>
                <Code code={CONFIGS[id].code} lang={CONFIGS[id].lang} theme="css-variables" />
              </div>
            </div>
          ))}
        </div>

        <div class="setup-extra" data-stagger="90">
          <article class="setup-oauth card" data-reveal>
            <span class="icon-tile icon-tile--ai"><Icon name="user" /></span>
            <div>
              <b>{page.setup.oauth.title}</b>
              <p>{page.setup.oauth.description}</p>
            </div>
          </article>
          <div class="setup-spec card" data-reveal>
            <div class="setup-spec-head">
              <b>{page.setup.spec.title}</b>
              <span>{page.setup.spec.subtitle}</span>
            </div>
            <dl>
              <div>
                <dt>{page.setup.spec.transport}</dt>
                <dd>{page.setup.spec.transportValue}</dd>
              </div>
              <div>
                <dt>{page.setup.spec.endpoint}</dt>
                <dd>
                  <code>{MCP_URL}</code>
                  <button class="setup-copy" type="button" aria-label={page.setup.spec.copyEndpoint} data-copy={MCP_URL}>
                    <Icon name="copy" class="icon--sm" />
                  </button>
                </dd>
              </div>
              <div>
                <dt>{page.setup.spec.auth}</dt>
                <dd>{page.setup.spec.authValue}</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- ⑤ 示例提示词墙（两行跑马灯，反向） -->
    <section class="section mcp-prompts" id="prompts">
      <div class="container">
        <header class="section-head" data-stagger="80">
          <span class="kicker kicker--ai" data-reveal>{page.prompts.kicker}</span>
          <h2 class="h2" data-split><AccentHeading title={page.prompts.title} accentClass="text-grad-ai" /></h2>
          <p class="lead" data-reveal>{page.prompts.lead}</p>
        </header>
      </div>
      <div class="prompt-rows" data-reveal>
        {page.prompts.rows.map((row, rowIndex) => (
          <div class="marquee prompt-marquee" data-marquee data-reverse={rowIndex % 2 === 1 ? '' : undefined} style={`--marquee-duration: ${rowIndex % 2 === 1 ? 64 : 56}s`}>
            <div class="marquee-track" role="list">
              {row.map(item => (
                <article class="prompt-card" role="listitem">
                  <div class="prompt-top">
                    <span class="icon-tile icon-tile--ai"><Icon name={item.icon} /></span>
                    <span class="prompt-tag">{item.tag}</span>
                  </div>
                  <p class="prompt-quote">{item.quote}</p>
                  <div class="prompt-meta">
                    {item.tools.map(tool => <code class="prompt-tool">{tool}</code>)}
                    {item.fields && <span class="prompt-fields">{item.fields}</span>}
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ⑥ 认证与数据边界：请求检视器 + 要点 -->
    <section class="section band" id="trust">
      <div class="container trust">
        <div class="trust-copy">
          <header class="section-head section-head--left" data-stagger="80">
            <span class="kicker kicker--ai" data-reveal>{page.trust.kicker}</span>
            <h2 class="h2" data-split><AccentHeading title={page.trust.title} /></h2>
            <p class="lead" data-reveal>{page.trust.lead}</p>
          </header>
          <ul class="trust-items" role="list" data-stagger="70">
            {page.trust.items.map(item => (
              <li data-reveal>
                <span class="icon-tile"><Icon name={item.icon} /></span>
                <div>
                  <b>{item.title}</b>
                  <p><CodeText text={item.description} /></p>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <figure class="inspector codewin" aria-label={page.trust.inspector.label} data-reveal="right">
          <div class="codewin-bar">
            <div class="win-dots" aria-hidden="true"><i></i><i></i><i></i></div>
            <span class="inspector-path"><b>POST</b>/mcp/</span>
            <span class="badge badge--ok inspector-ok"><Icon name="shield" />{page.trust.inspector.verified}</span>
          </div>
          <div class="codewin-label">{page.trust.inspector.request}</div>
          <Code code={INSPECT_REQUEST} lang="http" theme="css-variables" />
          <div class="codewin-label">{page.trust.inspector.response}</div>
          <Code code={INSPECT_RESPONSE} lang="json" theme="css-variables" />
        </figure>
      </div>
    </section>

    <!-- ⑦ 计费：共享 API 额度，阶梯取自 pricing.ts -->
    <section class="section" id="pricing">
      <div class="container billing">
        <div class="billing-copy">
          <header class="section-head section-head--left" data-stagger="80">
            <span class="kicker kicker--ai" data-reveal>{page.billing.kicker}</span>
            <h2 class="h2" data-split><AccentHeading title={page.billing.title} /></h2>
            <p class="lead" data-reveal>{page.billing.lead}</p>
          </header>
          <a class="link-arrow" href={pricingHref('billing')} data-cta={`${pageId}-billing-pricing`} data-reveal>
            {page.billing.compare}<Icon name="arrow-right" />
          </a>
        </div>
        <div class="ladder card" data-reveal>
          <table class="ladder-table">
