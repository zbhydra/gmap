---
/**
 * ClinkBill Hosted Checkout 成功/取消结果页（noindex）。
 *
 * SSR 渲染等待态/取消态文案；success 页由 payment return 脚本轮询本地订单
 * 状态后切换确认/失败态（文案经 data-payment-return-copy 钩子注入）。
 */
interface Props {
  /** 支付结果。 */
  status: 'success' | 'cancel'
  /** success 页的等待、按订单类别的确认与失败文案。 */
  successCopy: {
    waiting: { title: string; description: string }
    confirmedCredits: { title: string; description: string }
    confirmedSubscription: { title: string; description: string }
    failed: { title: string; description: string }
  }
  /** cancel 页文案。 */
  cancelCopy: { title: string; description: string }
}

const { status, successCopy, cancelCopy } = Astro.props
const copy = status === 'success' ? successCopy.waiting : cancelCopy
---

<section
  class="clink-return-page"
  data-payment-return
  data-payment-return-status={status}
  data-payment-return-state={status === 'success' ? 'waiting' : 'cancelled'}
>
  <span
    data-payment-return-copy="waiting"
    data-title={successCopy.waiting.title}
    data-description={successCopy.waiting.description}
    hidden
  ></span>
  <span
    data-payment-return-copy="confirmed-credits"
    data-title={successCopy.confirmedCredits.title}
    data-description={successCopy.confirmedCredits.description}
    hidden
  ></span>
  <span
    data-payment-return-copy="confirmed-subscription"
    data-title={successCopy.confirmedSubscription.title}
    data-description={successCopy.confirmedSubscription.description}
    hidden
  ></span>
  <span
    data-payment-return-copy="failed"
    data-title={successCopy.failed.title}
    data-description={successCopy.failed.description}
    hidden
  ></span>
  <section class="clink-return-card" aria-live="polite">
    <img src="/payment-icons/clinkbill.png" alt="" aria-hidden="true" width="32" height="32" />
    <p class="clink-return-eyebrow">ClinkBill</p>
    <h1 data-payment-return-title>{copy.title}</h1>
    <p data-payment-return-description>{copy.description}</p>
  </section>
</section>

<script>
  import { initPaymentReturnPage } from '../../components/credit-purchase/paypal-return'

  const root = document.querySelector<HTMLElement>('[data-payment-return]')
  const status = root?.dataset.paymentReturnStatus
  if (status === 'success' || status === 'cancel') {
    initPaymentReturnPage({ provider: 'clink', status, orderNo: null })
  } else {
    console.error(
      new Error(`clink return page: invalid or missing status=${String(status)}`)
    )
  }
</script>

<style>
  .clink-return-page {
    display: grid;
    min-height: 68vh;
    place-items: center;
    padding: 120px 24px 72px;
    background: var(--bg);
  }

  .clink-return-card {
    width: min(620px, 100%);
    padding: 34px;
    border: 1px solid var(--border);
    border-radius: var(--rounded-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    text-align: center;
  }

  [data-payment-return-copy][hidden] {
    display: none;
  }

  [data-payment-return-state='confirmed'] .clink-return-card {
    border-color: var(--ok);
  }

  [data-payment-return-state='failed'] .clink-return-card {
    border-color: var(--bad);
  }

  .clink-return-card img {
    display: block;
    margin: 0 auto 10px;
  }

  .clink-return-eyebrow {
    margin: 0 0 12px;
    color: var(--primary);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .clink-return-card h1 {
    margin: 0;
    color: var(--text);
    font-size: clamp(34px, 5vw, 54px);
    letter-spacing: -0.05em;
  }

  .clink-return-card p:last-child {
    margin: 16px 0 0;
    color: var(--text-2);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.6;
  }

  @media (max-width: 560px) {
    .clink-return-card {
      padding: 28px 20px;
    }

    .clink-return-card h1 {
      font-size: 32px;
    }
  }
</style>
