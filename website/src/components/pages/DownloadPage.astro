---
/**
 * 下载页渲染器（W2：Edge Add-ons / Firefox AMO 商店占位 + 直装 zip + 安装引导）。
 *
 * 商店未上架：商店链接与 release zip 资产均为 href="#" 占位（点击不 404），
 * 上架后仅回填内容常量，不动结构。CTA 带 data-cta 归因属性（事件经 W6 GA4 通道上报）。
 * 图文分区（015 D5 图文改造，对齐竞品逐步截图教程）：hero/zip/渠道步骤配图走
 * MediaSlot 占位，素材产出后仅回填 src，不动结构。
 */
import Layout from '../../layouts/Layout.astro'
import { getContent, type Locale } from '../../i18n/content'
import { localePaths } from '../../i18n/ui'
import { getCompanyContent } from '../../company/companyContent'
import { DEVELOPER_EMAIL } from '../../lib/contact'
import MediaSlot from '../site/MediaSlot.astro'

interface Props {
  /** 当前 locale 路由。 */
  locale?: Locale
}

const { locale = 'en-US' } = Astro.props as Props
const t = getContent(locale)
const page = t.pages.download
// locale 前缀（en-US 为空）；后续语言走 [lang]/ 路由时链接自动带上前缀。
const localePrefix = localePaths[locale] ? `/${localePaths[locale]}` : ''
const contactPath = `${localePrefix}/contact/`
const contactLabel = getCompanyContent(locale).contact.navLabel
// 商店与 release 资产链接占位：上架/发版后回填（同步 Layout 说明与 README）。
const STORE_URL_PLACEHOLDER = '#'
const RELEASE_ZIP_URL_PLACEHOLDER = '#'
---

<Layout
  locale={locale}
  title={page.seo.title}
  description={page.seo.description}
  includeSoftwareApplicationSchema={false}
>
  <div class="dl-page" data-download-page>
    <!-- hero（宽幅产品截图位） -->
    <section class="hero" aria-labelledby="dl-hero-title">
      <div class="container hero-inner">
        <p class="eyebrow">{page.hero.eyebrow}</p>
        <h1 id="dl-hero-title">{page.hero.title}</h1>
        <p class="hero-description">{page.hero.description}</p>
        <MediaSlot variant="browser" ratio="21 / 9" label={page.hero.visualLabel} class="hero-visual" />
      </div>
    </section>

    <!-- 直装 zip（release 资产占位） -->
    <section class="zip" aria-labelledby="dl-zip-title">
      <div class="container">
        <div class="zip-card">
          <div class="zip-copy">
            <h2 id="dl-zip-title">{page.zip.title}</h2>
            <p>{page.zip.description}</p>
            <a
              class="btn-primary"
              href={RELEASE_ZIP_URL_PLACEHOLDER}
              data-cta="download-zip"
              aria-describedby="dl-zip-note"
            >{page.zip.button}</a>
            <p class="zip-note" id="dl-zip-note">{page.zip.note}</p>
          </div>
          <MediaSlot variant="file" ratio="4 / 3" label={page.zip.visualLabel} class="zip-visual" />
        </div>
      </div>
    </section>

    <!-- 浏览器渠道：商店占位 + 分浏览器直装步骤 -->
    {page.channels.map(channel => (
      <section class="channel" aria-labelledby={`dl-${channel.id}-title`} data-channel={channel.id}>
        <div class="container">
          <div class="channel-card">
            <h2 id={`dl-${channel.id}-title`}>{channel.name}</h2>
            <p class="channel-store">{channel.storeName}</p>
            <p class="channel-status">{channel.storeStatus}</p>
            <a
              class="btn-secondary"
              href={STORE_URL_PLACEHOLDER}
              data-cta={`download-store-${channel.id}`}
              aria-disabled="true"
            >{channel.storeCta}</a>
            <h3>{channel.manualTitle}</h3>
            <ol class="channel-steps">
              {channel.steps.map(step => (
                <li>
                  <p class="step-title">{step.title}</p>
                  {step.details.map(detail => <p>{detail}</p>)}
                  <MediaSlot
                    variant="browser"
                    ratio="16 / 9"
                    label={step.mediaLabel}
                    class="step-visual"
                  />
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    ))}

    <!-- 帮助 -->
    <section class="help" aria-labelledby="dl-help-title">
      <div class="container help-inner">
        <h2 id="dl-help-title">{page.help.title}</h2>
        <p>{page.help.description}</p>
        <a
          class="btn-secondary"
          href={`mailto:${DEVELOPER_EMAIL}?subject=MapsGrab%20installation%20help`}
          data-cta="download-help-contact"
        >{page.help.contactCta}</a>
        <a class="help-contact-link" href={contactPath} data-cta="download-help-contact-page">{contactLabel}</a>
      </div>
    </section>
  </div>
</Layout>

<style>
  .dl-page {
    padding-top: var(--space-10);
  }

  .eyebrow {
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h2 {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .hero h1 {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: clamp(32px, 4.2vw, 50px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.08;
    color: var(--text);
  }

  /* 按钮样式走 Layout 全局原语 .btn-primary / .btn-secondary（design.md §7） */

  .btn-primary:focus-visible,
  .btn-secondary:focus-visible,
  .help-contact-link:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  /* hero */
  .hero-inner {
    padding: var(--space-6) 0 var(--space-10);
  }

  .hero-description {
    max-width: 640px;
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: 18px;
    line-height: 1.6;
  }

  .hero-visual {
    margin-top: var(--space-8);
  }

  /* 直装 zip */
  .zip {
    padding: var(--space-6) 0 var(--space-10);
  }

  .zip-card {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
    padding: var(--space-8);
    border: 1px solid var(--border);
    border-radius: var(--rounded-md);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .zip-copy > p {
    max-width: 640px;
    margin-top: var(--space-2);
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.6;
  }

  .zip-card h2 {
    font-size: 24px;
    line-height: 32px;
  }

  .zip-card .btn-primary {
    margin-top: var(--space-6);
  }

  .zip-note {
    margin-top: var(--space-3);
    color: var(--text-2);
    font-size: 13px;
    line-height: 1.6;
  }

  /* 渠道 */
  .channel {
    padding: var(--space-6) 0;
  }

  .channel-card {
    padding: var(--space-8);
    border: 1px solid var(--border);
    border-radius: var(--rounded-md);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .channel-card h2 {
    font-size: 24px;
    line-height: 32px;
  }

  .channel-store {
    margin-top: var(--space-1);
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .channel-status {
    max-width: 640px;
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--warn);
    border-radius: var(--rounded-sm);
    background: var(--warn-soft);
    color: var(--text);
    font-size: 14px;
    line-height: 1.6;
  }

  .channel-card .btn-secondary {
    margin-top: var(--space-4);
  }

  .channel-card h3 {
    margin-top: var(--space-8);
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    line-height: 28px;
    color: var(--text);
  }

  .channel-steps {
    display: grid;
    gap: var(--space-4);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: dl-step;
  }

  .channel-steps li {
    counter-increment: dl-step;
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--rounded-sm);
    background: var(--bg);
  }

  .step-title::before {
    content: counter(dl-step) '. ';
    color: var(--primary);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .step-title {
    color: var(--text);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.6;
  }

  .channel-steps li p:not(.step-title) {
    margin-top: var(--space-1);
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.6;
  }

  .step-visual {
    max-width: 520px;
    margin-top: var(--space-4);
  }

  /* 帮助 */
  .help {
    padding: var(--space-10) 0 var(--space-24);
  }

  .help-inner {
    max-width: 640px;
    padding: var(--space-8);
    border: 1px solid var(--border);
    border-radius: var(--rounded-md);
    background: var(--surface-2);
    text-align: center;
  }

  .help-inner h2 {
    font-size: 24px;
    line-height: 32px;
  }

  .help-inner > p {
    margin-top: var(--space-2);
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.6;
  }

  .help-inner .btn-secondary {
    margin-top: var(--space-6);
  }

  .help-contact-link {
    display: block;
    margin-top: var(--space-3);
    color: var(--primary-hover);
    font-size: 14px;
    font-weight: 600;
  }

  .help-contact-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 960px) {
    .zip-card {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
      padding: var(--space-6) var(--space-4);
    }

    .channel-card {
      padding: var(--space-6) var(--space-4);
    }

    .help {
      padding-bottom: var(--space-16);
    }
  }
</style>
