---
/**
 * Pricing 产品页（三产品线 tab 套餐）。
 *
 * Astro SSG 页面只负责 i18n、SEO 和 Pricing 主体装配；页面结构、样式与交互在 src/components/pricing。
 */
// Layout 先导入：全局样式在前，页面私有样式（PricingPageShell 引入的 pricing.css）在后覆盖
import Layout from '../../layouts/Layout.astro'
import PricingPageShell from '../pricing/PricingPageShell.astro'
import { getContent, type Locale } from '../../i18n/content'

interface Props {
  locale?: Locale
}

const { locale = 'en-US' } = Astro.props as Props
const t = getContent(locale)
const pricing = t.pages.pricing

// 购买答疑 FAQPage 结构化数据：经 Layout 的 structuredData prop 注入 <head>
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pricing.faq.items.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
}
// 三产品线套餐结构化数据：Offer 列表按线展开（卡面价 = SSR 营销展示事实）
const plansSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'MapsGrab Plans',
  description: pricing.seo.description,
  brand: { '@type': 'Brand', name: 'MapsGrab' },
  offers: Object.values(pricing.tabs).flatMap(tab =>
    tab.cards.map(card => ({
      '@type': 'Offer',
      name: `MapsGrab ${tab.name} ${card.name}`,
      price: card.price.replace('$', ''),
      priceCurrency: 'USD',
      category: card.quota
    }))
  )
}
---

<Layout
  locale={locale}
  title={pricing.seo.title}
  description={pricing.seo.description}
  structuredData={[faqSchema, plansSchema]}
  includeSoftwareApplicationSchema={false}
>
  <PricingPageShell locale={locale} copy={pricing} accountCopy={t.pages.account} />
</Layout>
