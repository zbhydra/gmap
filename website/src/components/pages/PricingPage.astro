---
/**
 * Pricing 产品页。
 *
 * Astro SSG 页面只负责 i18n、SEO 和 shared Pricing shell 装配；
 * 购买/登录交互在 src/components/pricing 的命令式 DOM controller。
 */
import PricingPageShell from '../pricing/PricingPageShell.astro'
import Layout from '../../layouts/Layout.astro'
import { getContent, type Locale } from '../../i18n/content'

interface Props {
  locale?: Locale
}

const { locale = 'en-US' } = Astro.props as Props
const t = getContent(locale)
const pricing = t.pages.pricing
const installUrl =
  'https://chromewebstore.google.com/detail/telegram-download-assista/lflkobgaibapekhjnfhkaeagdnojjnla'

// 购买答疑 FAQPage 结构化数据：经 Layout 的 structuredData prop 注入 <head>
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pricing.faq.items.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
}
---

<Layout
  locale={locale}
  title={pricing.seo.title}
  description={pricing.seo.description}
  structuredData={[faqSchema]}
>
  <PricingPageShell copy={pricing} accountCopy={t.pages.account} extensionInstallUrl={installUrl} showHero />
</Layout>
