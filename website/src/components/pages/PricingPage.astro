---
/**
 * Pricing 产品页（三产品线 tab 套餐）。
 *
 * Astro SSG 页面只负责 i18n、SEO 和 shared Pricing shell 装配；
 * 购买/登录交互在 src/components/pricing 的命令式 DOM controller。
 */
import PricingPageShell from '../pricing/PricingPageShell.astro'
import Layout from '../../layouts/Layout.astro'
import { getContent, type Locale } from '../../i18n/content'
import { localePaths } from '../../i18n/ui'
import type { PricingTabId } from '../../i18n/schema'

interface Props {
  locale?: Locale
}

const { locale = 'en-US' } = Astro.props as Props
const t = getContent(locale)
const pricing = t.pages.pricing
const localePrefix = localePaths[locale] ? `/${localePaths[locale]}` : ''
const downloadPath = `${localePrefix}/download/`

// 各 tab Free 卡的引导落地页（不可购买，只做产品入口）
const freeCtaPaths: Record<PricingTabId, string> = {
  online: `${localePrefix}/online-scraper/`,
  extension: downloadPath,
  api: `${localePrefix}/google-maps-scraper-api/`
}

// 购买答疑 FAQPage 结构化数据：经 Layout 的 structuredData prop 注入 <head>
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pricing.faq.items.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
}
// 三产品线套餐结构化数据：Offer 列表按线展开（卡面价 = SSR 营销展示事实）
const plansSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'MapsGrab Plans',
  description: pricing.seo.description,
  brand: { '@type': 'Brand', name: 'MapsGrab' },
  offers: (Object.keys(pricing.tabs) as PricingTabId[]).flatMap(tabId =>
    pricing.tabs[tabId].cards.map(card => ({
      '@type': 'Offer',
      name: `MapsGrab ${pricing.tabLabels[tabId]} ${card.name}`,
      price: card.price.replace('$', ''),
      priceCurrency: 'USD',
      category: card.quota
    }))
  )
}
---

<Layout
  locale={locale}
  title={pricing.seo.title}
  description={pricing.seo.description}
  structuredData={[faqSchema, plansSchema]}
  includeSoftwareApplicationSchema={false}
>
  <PricingPageShell
    copy={pricing}
    accountCopy={t.pages.account}
    freeCtaPaths={freeCtaPaths}
  />
</Layout>
