---
/**
 * 首页（设计稿 index.html，README §7 首页 ①–⑫）。
 *
 * - 首屏标题构建期拆词、文案 data-enter 入场，不等 JS；搜索命令条与产品剧场是 HeroPreview
 *   （014 首页预览合同里唯一的预览状态 owner），字段浏览器 / 补全轨道 / 代码台交互在 home/home-page.ts。
 * - 未交付能力消费 lib/capabilities.ts：介绍页入口照常可达但灰化并带 Coming soon，安装动作走 CapabilityAction。
 * - 样例数据全部虚构（home/home-samples.ts）；定价摘要的价格、额度与方案名逐字取自 pricing 文案。
 */
import { Code } from 'astro:components'
import HeroPreview from '../home/HeroPreview.vue'
import {
  CHAT_MATCHES,
  FIELD_INITIAL_INDEX,
  FIELD_SAMPLES,
  MINI_API_REQUEST,
  ORBIT_BUSINESS,
  ORBIT_NODES,
  THEATER_DATASETS,
  developerSamples,
  sampleCsvDataUri,
  type DeveloperSample
} from '../home/home-samples'
import BrandMark from '../site/BrandMark.astro'
import CapabilityAction from '../site/CapabilityAction.astro'
import Icon from '../site/Icon.astro'
import SoonBadge from '../site/SoonBadge.astro'
import SplitWords from '../site/SplitWords.astro'
import { TOOL_ICONS } from '../tools/tool-catalog'
import Layout from '../../layouts/Layout.astro'
import { getContent, type Locale } from '../../i18n/content'
import type { HomeFieldColumn, HomeFieldGroup, PricingTabId } from '../../i18n/schema'
import { localePaths } from '../../i18n/ui'
import { capabilities } from '../../lib/capabilities'
import { getApiBaseUrl } from '../../scripts/homepage/api'
import { quotaValue } from '../pricing/pricing-finder'
import '../home/home.css'

interface Props {
  /** 当前 locale 路由。 */
  locale?: Locale
}

const { locale = 'en-US' } = Astro.props as Props
const t = getContent(locale)
const page = t.pages.home
const { hero, facts, how, products, fields, enrichment, developers, useCases, pricingTeaser, tools, faq, cta } = page
const pricing = t.pages.pricing

// locale 前缀（en-US 为空）；其他语言走 [lang]/ 路由时链接自动带上前缀。
const localePrefix = localePaths[locale] ? `/${localePaths[locale]}` : ''
const paths = {
  extension: `${localePrefix}/extension/`,
  online: `${localePrefix}/online-scraper/`,
  api: `${localePrefix}/google-maps-scraper-api/`,
  mcp: `${localePrefix}/google-maps-scraper-mcp/`,
  pricing: `${localePrefix}/pricing/`,
  contact: `${localePrefix}/contact/`,
  dashboard: `${localePrefix}/dashboard/`
}

// CTA 归因：站内链接带 utm（canonical 只取 pathname，不受 query 影响），事件侧用 data-cta。
const installHref = `${paths.extension}?utm_source=website&utm_medium=home-cta&utm_campaign=install#install`

const numberFormat = new Intl.NumberFormat(locale)
const fill = (template: string, values: Record<string, string | number>) =>
  template.replace(/\{(\w+)\}/g, (_, key: string) => String(values[key] ?? ''))
/** 把模板按占位符拆成前后两段，中间由页面渲染为强调元素。 */
const around = (template: string, key: string) => {
  const [before, after = ''] = template.split(`{${key}}`)
  return { before, after }
}

// ③ 第二步插画的字段胶囊：导出表头原文
const HOW_TAGS: readonly HomeFieldColumn[] = ['Name', 'Phone', 'Email', 'Website']

// ⑤ 字段浏览器：分组顺序与计数
const FIELD_GROUPS: readonly HomeFieldGroup[] = ['contact', 'location', 'profile', 'reviews', 'ids']
const groupCount = (group: HomeFieldGroup) => FIELD_SAMPLES.filter(field => field.group === group).length
const initialField = FIELD_SAMPLES[FIELD_INITIAL_INDEX]
// 评论导出的 11 列表头（extension 评论导出列原文）
const REVIEW_COLUMNS = [
  'Author',
  'Review Text',
  'Review Rating',
  'Date',
  'Photos',
  'Likes',
  'Owner Answer',
  'Owner Answer Date',
  'Author Profile',
  'Author Image',
  'Review URL'
]

// ⑥ 补全轨道：节点均分圆周，从正上方开始
const orbitAngle = (index: number) => -90 + (360 / ORBIT_NODES.length) * index

// ⑦ 代码台：Photos 端点未实现，没有示例，列表项只读展示
const apiBase = getApiBaseUrl()
const devSamples: Partial<Record<'search' | 'reviews' | 'photos' | 'mcp', DeveloperSample>> = developerSamples(apiBase)
const DEV_ITEMS = [
  { id: 'search', icon: 'database', available: capabilities.scraperApi },
  { id: 'reviews', icon: 'review', available: capabilities.scraperApi },
  { id: 'mcp', icon: 'bot', available: capabilities.mcp },
  { id: 'photos', icon: 'image', available: capabilities.photosApi }
] as const
const devTabs = DEV_ITEMS.flatMap(item => {
  const sample = devSamples[item.id]
  return sample ? [{ ...item, sample }] : []
})
const devReadOnly = DEV_ITEMS.filter(item => !devSamples[item.id])
const devStatus = (sample: DeveloperSample) =>
  sample.tool ? fill(developers.toolCall, { tool: sample.tool }) : fill(developers.response, { ms: sample.latencyMs ?? 0 })
const INTEGRATION_ICONS = ['terminal', 'cursor', 'code', 'sparkles', 'search', 'table', 'file-sheet', 'braces', 'archive']

// ⑧ 用例插画
const USE_CASE_ICONS = ['target', 'chart', 'route']
const BENCHMARK_BARS = [
  { value: 0.92, rating: '4.8' },
  { value: 0.74, rating: '4.3' },
  { value: 0.86, rating: '4.6', you: true },
  { value: 0.58, rating: '3.9' },
  { value: 0.97, rating: '4.9' },
  { value: 0.66, rating: '4.1' }
]
const GEO_DOTS = [
  { x: 18, y: 30, s: 1 },
  { x: 30, y: 58, s: 0.7 },
  { x: 46, y: 36, s: 1.3 },
  { x: 58, y: 66, s: 0.8 },
  { x: 70, y: 28, s: 1.1 },
  { x: 82, y: 56, s: 0.9 }
]

// ⑨ 定价摘要：免费档 + 第一个付费档，逐字取 pricing 文案
const TEASER_LINES: ReadonlyArray<{ id: PricingTabId; icon: string; available: boolean }> = [
  { id: 'extension', icon: 'puzzle', available: capabilities.extensionPurchase },
  { id: 'online', icon: 'cloud', available: true },
  { id: 'api', icon: 'code', available: capabilities.scraperApi }
]
const teaserPlans = (id: PricingTabId) => {
  const cards = pricing.tabs[id].cards
  return { free: cards.find(card => card.status === 'free'), next: cards.find(card => card.status === 'buyable') }
}

// ① 信任条与 ② 事实条的免费额度与 ⑨ 同源：取 Online Free 档，首页不另写数字
const onlineFree = teaserPlans('online').free
if (!onlineFree) throw new Error('[home] pricing.ts Online tab has no free plan card.')
const freeRecords = quotaValue(onlineFree.quota)
const heroCopy = { ...hero, trust: hero.trust.map(item => fill(item, { records: numberFormat.format(freeRecords) })) }
const factValue = (value: number | 'freeRecords') => (value === 'freeRecords' ? freeRecords : value)

const [searchStep, extractStep, exportStep] = how.steps
const extractAction = around(extractStep.body, 'action')
const chatAnswer = around(products.chat.answer, 'count')

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
}
---

<Layout locale={locale} title={page.seo.title} description={page.seo.description} structuredData={[faqSchema]}>
  <div class="home" data-home-page>
    <!-- ① Hero：搜索命令条（匿名预览）+ 产品剧场 -->
    <section class="hero has-deco" data-inview>
      <div class="deco" aria-hidden="true">
        <div class="aurora"><i></i><i></i><i></i><i></i></div>
        <div class="bg-contours hero-contours"></div>
        <div class="bg-grid"></div>
        <div class="noise"></div>
      </div>

      <div class="container hero-copy">
        <a class:list={['pill-announce', { 'is-unavailable': !capabilities.mcp }]} href={paths.mcp} data-enter data-cta="home-hero-announce">
          {capabilities.mcp ? <span class="badge badge--solid">{hero.announce.badge}</span> : <SoonBadge locale={locale} />}
          <span>{hero.announce.text}</span>
          <Icon name="arrow-right" />
        </a>

        <h1 class="display hero-title" data-split="static" style="--split-delay: 90ms">
          <SplitWords
            parts={[
              `${hero.title.firstLine} `,
              { br: 'hide-md' },
              `${hero.title.secondLine} `,
              { text: hero.title.accent, class: 'accent text-grad is-animated' },
              hero.title.end
            ]}
          />
        </h1>

        <p class="lead hero-lead" data-enter style="--enter-delay: 180ms">{hero.lead}</p>
      </div>

      <HeroPreview client:load copy={heroCopy} locale={locale} dashboardUrl={paths.dashboard}>
        <Fragment slot="brand"><BrandMark /></Fragment>
      </HeroPreview>
    </section>

    <!-- ② 产品事实条（真实产品参数） -->
    <section class="facts">
      <div class="container">
        <p class="facts-caption" data-reveal>{facts.caption}</p>
        <div class="facts-grid" data-stagger="80">
          {facts.items.map(item => (
            <div class="fact" data-reveal>
              {item.plus ? (
                <div class="stat-value text-grad">{numberFormat.format(factValue(item.value))}<span class="fact-plus">+{item.plus}</span></div>
              ) : (
                <div class="stat-value text-grad" data-count={factValue(item.value)}>{numberFormat.format(factValue(item.value))}</div>
              )}
              <div class="stat-label">{item.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ③ 三步流程 -->
    <section class="section how" id="how" data-inview>
      <div class="container">
        <header class="section-head" data-stagger="80">
          <span class="kicker" data-reveal>{how.head.kicker}</span>
          <h2 class="h2" data-split>{how.head.title.lead}<span class="accent">{how.head.title.accent}</span>{how.head.title.tail}</h2>
          {how.head.lead && <p class="lead" data-reveal>{how.head.lead}</p>}
        </header>

        <ol class="how-steps" role="list" data-stagger="120" data-spotlight-group>
          <li class="how-arrow how-arrow--1" aria-hidden="true"><Icon name="arrow-right" /></li>
          <li class="how-arrow how-arrow--2" aria-hidden="true"><Icon name="arrow-right" /></li>
          <li class="how-step card" data-reveal data-spotlight>
            <div class="how-visual how-search" aria-hidden="true">
              <div class="hs-bar">
                <Icon name="search" />
                <span class="hs-typed" style={`--chars: ${how.searchSample.length}`}>{how.searchSample}</span>
              </div>
              <div class="hs-results">
                {[0, 1, 2].map(() => (
                  <div class="hs-row"><i class="hs-pin"></i><span class="skel"></span><span class="skel"></span></div>
                ))}
              </div>
            </div>
            <div class="how-text">
              <span class="how-num">01</span>
              <h3 class="h4">{searchStep.title}</h3>
              <p>{searchStep.body}</p>
            </div>
          </li>
          <li class="how-step card" data-reveal data-spotlight>
            <div class="how-visual how-extract" aria-hidden="true">
              <div class="hx-ring">
                <svg viewBox="0 0 120 120">
                  <defs>
                    <linearGradient id="hx-grad" x1="0" y1="0" x2="1" y2="1">
                      <stop offset="0" class="hx-stop-1" /><stop offset=".55" class="hx-stop-2" /><stop offset="1" class="hx-stop-3" />
                    </linearGradient>
                  </defs>
                  <circle class="hx-track" cx="60" cy="60" r="50" />
                  <circle class="hx-fill" cx="60" cy="60" r="50" pathLength="1" />
                </svg>
                <div class="hx-count"><b>{FIELD_SAMPLES.length}</b><span>{how.columnsUnit}</span></div>
              </div>
              <div class="hx-tags">
                {HOW_TAGS.map(tag => <span class="chip chip--mono">{tag}</span>)}
              </div>
            </div>
            <div class="how-text">
              <span class="how-num">02</span>
              <h3 class="h4">{extractStep.title}</h3>
              <p>{extractAction.before}<b>{extractStep.action}</b>{extractAction.after}</p>
            </div>
          </li>
          <li class="how-step card" data-reveal data-spotlight>
            <div class="how-visual how-export" aria-hidden="true">
              <div class="file-card f-json"><Icon name="braces" /><b>.json</b></div>
              <div class="file-card f-reviews"><Icon name="review" /><b>{how.reviewsFile}</b></div>
              <div class="file-card f-csv"><Icon name="file-sheet" /><b>.csv</b></div>
            </div>
            <div class="how-text">
              <span class="how-num">03</span>
              <h3 class="h4">{exportStep.title}</h3>
              <p>{exportStep.body}</p>
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- ④ 产品形态 bento（插件 / Online / API / MCP） -->
    <section class="section products band" id="products" data-inview>
      <div class="container">
        <header class="section-head" data-stagger="80">
          <span class="kicker" data-reveal>{products.head.kicker}</span>
          <h2 class="h2" data-split>{products.head.title.lead}<span class="accent">{products.head.title.accent}</span>{products.head.title.tail}</h2>
          {products.head.lead && <p class="lead" data-reveal>{products.head.lead}</p>}
        </header>

        <div class="bento" data-spotlight-group data-stagger="100">
          <a
            class:list={['bento-card card card-link bento-ext', { 'is-unavailable': !capabilities.extensionInstall }]}
            href={paths.extension}
            data-spotlight
            data-reveal
            data-product-card="extension"
            data-cta="home-product-extension"
          >
            <div class="bento-copy">
              <span class="bento-badges">
                <span class="badge"><Icon name="puzzle" class="icon--sm" />{products.cards.extension.badge}</span>
                {!capabilities.extensionInstall && <SoonBadge locale={locale} />}
              </span>
              <h3 class="h3">{products.cards.extension.title}</h3>
              <p>{products.cards.extension.body}</p>
              <span class="link-arrow">{products.cards.extension.link} <Icon name="arrow-right" /></span>
            </div>
            <div class="bento-visual ext-visual" aria-hidden="true">
              <div class="ev-map">
                <i class="ev-pin" style="--x: 22%; --y: 34%"></i>
                <i class="ev-pin" style="--x: 48%; --y: 22%"></i>
                <i class="ev-pin" style="--x: 38%; --y: 62%"></i>
                <i class="ev-pin" style="--x: 70%; --y: 48%"></i>
                <i class="ev-pin" style="--x: 60%; --y: 80%"></i>
              </div>
              <div class="ev-panel">
                <div class="ev-head"><span class="ev-logo"></span>MapsGrab<span class="ev-count mono">{fill(products.extracting, { count: 24 })}</span></div>
                <div class="progress"><i style="--p: 64%"></i></div>
                <div class="ev-rows">
                  {['4.8', '4.6', '4.9', '4.5'].map(rating => (
                    <div class="ev-row"><span class="ev-dot"></span><span class="skel"></span><b>{rating}</b></div>
                  ))}
                </div>
              </div>
            </div>
          </a>

          <a class="bento-card card card-link bento-online" href={paths.online} data-spotlight data-reveal data-product-card="online" data-cta="home-product-online">
            <div class="bento-copy">
              <span class="bento-badges">
                <span class="badge"><Icon name="cloud" class="icon--sm" />{products.cards.online.badge}</span>
              </span>
              <h3 class="h3">{products.cards.online.title}</h3>
              <p>{products.cards.online.body}</p>
              <span class="link-arrow">{products.cards.online.link} <Icon name="arrow-right" /></span>
            </div>
            <div class="bento-visual queue" aria-hidden="true">
              {THEATER_DATASETS.map((dataset, index) => {
                const running = index === THEATER_DATASETS.length - 1
                return (
                  <div class:list={['q-row', running ? 'is-running' : 'is-done']}>
                    <span class="q-kw">{dataset.keyword}</span>
                    <span class="q-state">{running ? products.queue.processing : fill(products.queue.rows, { count: dataset.total })}</span>
                    <span class="progress">{running ? <i class="q-anim"></i> : <i style="--p: 100%"></i>}</span>
                  </div>
                )
              })}
              <div class="q-zip"><Icon name="archive" class="icon--sm" /><span>9f3c2a7e5b1d4c08a6e2f71b9d0c4e55.zip</span></div>
            </div>
          </a>

          <a
            class:list={['bento-card card card-link bento-api', { 'is-unavailable': !capabilities.scraperApi }]}
            href={paths.api}
            data-spotlight
            data-reveal
            data-product-card="api"
            data-cta="home-product-api"
          >
            <div class="bento-copy">
              <span class="bento-badges">
                <span class="badge"><Icon name="code" class="icon--sm" />{products.cards.api.badge}</span>
                {!capabilities.scraperApi && <SoonBadge locale={locale} />}
              </span>
              <h3 class="h3">{products.cards.api.title}</h3>
              <p>{products.cards.api.body}</p>
              <span class="link-arrow">{products.cards.api.link} <Icon name="arrow-right" /></span>
            </div>
            <div class="bento-visual mini-code" aria-hidden="true">
              <div class="mc-req"><span class="mc-verb">{MINI_API_REQUEST.verb}</span>{MINI_API_REQUEST.path}</div>
              <pre class="mc-res"><span class="tok-punc">{'{'}</span>
  <span class="tok-key">"name"</span><span class="tok-punc">:</span> <span class="tok-str">"{ORBIT_BUSINESS.name}"</span><span class="tok-punc">,</span>
  <span class="tok-key">"average_rating"</span><span class="tok-punc">:</span> <span class="tok-num">4.7</span><span class="tok-punc">,</span>
  <span class="tok-key">"phone"</span><span class="tok-punc">:</span> <span class="tok-str">"(503) 555-0142"</span><span class="tok-punc">,</span>
  <span class="tok-key">"emails"</span><span class="tok-punc">: [</span><span class="tok-str">"hello@emberandoak.coffee"</span><span class="tok-punc">]</span>
<span class="tok-punc">{'}'}</span></pre>
            </div>
          </a>

          <a
            class:list={['bento-card card card-link bento-mcp', { 'is-unavailable': !capabilities.mcp }]}
            href={paths.mcp}
            data-spotlight
            data-reveal
            data-product-card="mcp"
            data-cta="home-product-mcp"
          >
            <div class="bento-copy">
              <span class="bento-badges">
                <span class="badge badge--ai"><Icon name="bot" class="icon--sm" />{products.cards.mcp.badge}</span>
                {!capabilities.mcp && <SoonBadge locale={locale} />}
              </span>
              <h3 class="h3">{products.cards.mcp.title}</h3>
              <p>{products.cards.mcp.body}</p>
              <span class="link-arrow">{products.cards.mcp.link} <Icon name="arrow-right" /></span>
            </div>
            <div class="bento-visual chat" aria-hidden="true">
              <div class="chat-msg user">{products.chat.prompt}</div>
              <div class="chat-tool"><Icon name="plug" class="icon--sm" />mapsgrab · search_places</div>
              <div class="chat-msg bot">
                {chatAnswer.before}<b>{CHAT_MATCHES.count}</b>{chatAnswer.after}
                <span class="chat-list">
                  {CHAT_MATCHES.top.map(([name, rating]) => <span>{name} <em>{rating}</em></span>)}
                </span>
              </div>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- ⑤ 36 列字段浏览器 -->
    <section class="section fields" id="fields" data-fields>
      <div class="container fields-grid">
        <div class="fields-copy" data-stagger="80">
          <span class="kicker" data-reveal>{fields.head.kicker}</span>
          <h2 class="h2" data-split>{fields.head.title.lead}<span class="accent">{fields.head.title.accent}</span>{fields.head.title.tail}</h2>
          {fields.head.lead && <p class="lead" data-reveal>{fields.head.lead}</p>}
          <div class="field-filters" data-tabs data-field-filters data-reveal>
            <div class="field-filters-list" role="tablist" aria-label={fields.filtersLabel}>
              <button type="button" role="tab" aria-selected="true" data-tab="all">{fields.all} <span>{FIELD_SAMPLES.length}</span></button>
              {FIELD_GROUPS.map(group => (
                <button type="button" role="tab" aria-selected="false" data-tab={group}>{fields.groups[group].filter} <span>{groupCount(group)}</span></button>
              ))}
            </div>
          </div>
        </div>

        <div class="fields-stage" data-reveal="zoom">
          <div class="field-inspector card" data-inspector aria-live="polite">
            <div class="insp-head">
              <span class="icon-tile icon-tile--brand" data-insp-icon><Icon name={initialField.icon} /></span>
              <div>
                <div class="insp-name" data-insp-name>{initialField.header}</div>
                <div class="insp-group" data-insp-group>{fields.groups[initialField.group].label}</div>
              </div>
              <span class="insp-index mono" data-insp-index>{FIELD_INITIAL_INDEX + 1} / {FIELD_SAMPLES.length}</span>
            </div>
            <p class="insp-desc" data-insp-desc>{fields.descriptions[initialField.header]}</p>
            <div class="insp-sample">
              <span class="insp-sample-label">{fields.sampleLabel}</span>
              <code data-insp-sample>{initialField.sample || fields.emptySample}</code>
            </div>
          </div>
          <div class="field-cloud" data-field-cloud>
            {FIELD_SAMPLES.map((field, index) => (
              <button
                class:list={['field-chip', { 'is-active': index === FIELD_INITIAL_INDEX }]}
                type="button"
                data-group={field.group}
                data-group-label={fields.groups[field.group].label}
                data-icon={field.icon}
                data-desc={fields.descriptions[field.header]}
                data-sample={field.sample || fields.emptySample}
              >
                <Icon name={field.icon} />{field.header}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="container fields-extra" data-stagger="100">
        <div class="card card-pad extra-card" data-reveal>
          <div class="extra-head">
            <span class="icon-tile icon-tile--pin"><Icon name="review" /></span>
            <div>
              <h3 class="h4">{fields.reviews.title}</h3>
              <p class="body-sm muted">{fields.reviews.body}</p>
            </div>
          </div>
          <div class="extra-tags">
            {REVIEW_COLUMNS.map(column => <span class="chip chip--mono">{column}</span>)}
          </div>
        </div>
        <div class="card card-pad extra-card" data-reveal>
          <div class="extra-head">
            <span class="icon-tile icon-tile--ok"><Icon name="image" /></span>
            <div>
              <h3 class="h4">{fields.photos.title}</h3>
              <p class="body-sm muted">{fields.photos.body}</p>
            </div>
          </div>
          <div class="photo-strip" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
          <a class="link-arrow" href={sampleCsvDataUri()} download="MapsGrab-sample.csv" data-cta="home-fields-sample-csv">
            {fields.sampleCsv} <Icon name="download" />
          </a>
        </div>
      </div>
    </section>

    <!-- ⑥ Email / 社媒补全（轨道图） -->
    <section class="section enrich band" id="enrichment" data-inview>
      <div class="container enrich-grid">
        <div class="enrich-copy" data-stagger="80">
          <span class="kicker" data-reveal>{enrichment.head.kicker}</span>
          <h2 class="h2" data-split>{enrichment.head.title.lead}<span class="accent">{enrichment.head.title.accent}</span>{enrichment.head.title.tail}</h2>
          {enrichment.head.lead && <p class="lead" data-reveal>{enrichment.head.lead}</p>}
          <ul class="check-list" data-reveal>
            {enrichment.points.map(point => <li>{point}</li>)}
          </ul>
        </div>

        <div class="orbit" data-orbit data-reveal="zoom" aria-hidden="true">
          <div class="orbit-ring r1"></div>
          <div class="orbit-ring r2"></div>
          <div class="orbit-ring r3"></div>
          <div class="orbit-spokes">
            {ORBIT_NODES.map((node, index) => <span class={`orbit-spoke orbit--${node.id}`} style={`--a: ${orbitAngle(index)}deg`}></span>)}
          </div>
          <div class="orbit-center">
            <span class="oc-avatar"><Icon name="coffee" /></span>
            <b>{ORBIT_BUSINESS.name}</b>
            <span class="oc-site mono">{ORBIT_BUSINESS.site}</span>
            <span class="oc-scan"><i></i></span>
            <div class="oc-results">
              {ORBIT_NODES.map(node => (
                <div class={`or-row orbit--${node.id}`} hidden><Icon name={node.icon} /><span>{node.value}</span><Icon name="check" class="icon-check" /></div>
              ))}
            </div>
          </div>
          <div class="orbit-nodes">
            {ORBIT_NODES.map((node, index) => (
              <span class={`orbit-node orbit--${node.id}`} style={`--a: ${orbitAngle(index)}deg`}><Icon name={node.icon} /><span class="node-check"><Icon name="check" /></span></span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ⑦ 开发者（恒暗主题岛）：REST 与 MCP 示例按 014 API / MCP 合同 -->
    <section class="section dev scheme-dark has-deco" id="developers" data-inview>
      <div class="deco" aria-hidden="true">
        <div class="bg-grid dev-grid-bg"></div>
        <div class="dev-glow"></div>
        <div class="noise"></div>
      </div>
      <div class="container dev-layout" data-tabs data-dev>
        <div class="dev-copy" data-stagger="80">
          <span class="kicker" data-reveal>{developers.head.kicker}</span>
          <h2 class="h2" data-split>{developers.head.title.lead}<span class="accent text-grad">{developers.head.title.accent}</span>{developers.head.title.tail}</h2>
          {developers.head.lead && <p class="lead" data-reveal>{developers.head.lead}</p>}
          <div class="dev-list" data-reveal>
            <div class="dev-tabs" role="tablist" aria-label={developers.listLabel}>
              {devTabs.map((item, index) => (
                <button
                  type="button"
                  role="tab"
                  id={`dev-tab-${item.id}`}
                  aria-selected={index === 0 ? 'true' : 'false'}
                  aria-controls={`dev-panel-${item.id}`}
                  data-tab={item.id}
                >
                  <span class:list={['icon-tile', { 'icon-tile--ai': item.id === 'mcp' }]}><Icon name={item.icon} /></span>
                  <span class="dev-item-text">
                    <b>{developers.items[item.id].title}{!item.available && <SoonBadge locale={locale} />}</b>
                    <small>{developers.items[item.id].description}</small>
                  </span>
                </button>
              ))}
            </div>
            {devReadOnly.map(item => (
              <div class="dev-item is-unavailable">
                <span class="icon-tile"><Icon name={item.icon} /></span>
                <span class="dev-item-text">
                  <b>{developers.items[item.id].title}{!item.available && <SoonBadge locale={locale} />}</b>
                  <small>{developers.items[item.id].description}</small>
                </span>
              </div>
            ))}
          </div>
          <div class="cluster dev-actions" data-reveal>
            <a class="btn btn-invert" href={paths.api} data-cta="home-dev-explore-api">
              {developers.exploreApi} <Icon name="arrow-right" class="icon-arrow" />
            </a>
            <a class="btn btn-secondary" href={`${paths.pricing}#api`} data-cta="home-dev-api-pricing">{developers.apiPricing}</a>
          </div>
        </div>

        <div class="dev-code" data-reveal="right">
          {devTabs.map((item, index) => (
            <div class="dev-panel" role="tabpanel" id={`dev-panel-${item.id}`} aria-labelledby={`dev-tab-${item.id}`} hidden={index !== 0} data-dev-panel>
              <div class="codewin" data-tabs>
                <div class="codewin-bar">
                  <div class="win-dots" aria-hidden="true"><i></i><i></i><i></i></div>
                  <div class="codewin-tabs" role="tablist" aria-label={developers.langLabel}>
                    {item.sample.langs.map((lang, langIndex) => (
                      <button
                        class="codewin-tab"
                        type="button"
                        role="tab"
                        id={`dev-${item.id}-lang-${langIndex}`}
                        aria-selected={langIndex === 0 ? 'true' : 'false'}
                        aria-controls={`dev-${item.id}-request-${langIndex}`}
                        data-tab={String(langIndex)}
                      >{lang}</button>
                    ))}
                  </div>
                  <button class="codewin-copy" type="button" aria-label={developers.copyLabel} data-copy={item.sample.requests[0].code} data-dev-copy>
                    <Icon name="copy" class="icon--sm" />
                  </button>
                </div>
                {item.sample.requests.map((request, langIndex) => (
                  <div
                    class="dev-request"
                    role="tabpanel"
                    id={`dev-${item.id}-request-${langIndex}`}
                    aria-labelledby={`dev-${item.id}-lang-${langIndex}`}
                    hidden={langIndex !== 0}
                    data-dev-request
                  >
                    <Code code={request.code} lang={request.lang} theme="css-variables" />
                  </div>
                ))}
                <div class="codewin-label">
                  <span class="dot dev-dot"></span>
                  <span data-dev-status data-sending={developers.sending}>{devStatus(item.sample)}</span>
                </div>
                <div class="dev-response" data-dev-response>
                  <Code code={item.sample.response.code} lang={item.sample.response.lang} theme="css-variables" />
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="dev-works" data-reveal>
        <p class="dev-works-label">{developers.worksWith}</p>
        <div class="marquee" data-marquee>
          <div class="marquee-track">
            {developers.integrations.map((name, index) => (
              <span class="chip"><Icon name={INTEGRATION_ICONS[index]} />{name}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ⑧ 用例（用法描述，不是证言） -->
    <section class="section usecases" id="use-cases" data-inview>
      <div class="container">
        <header class="section-head" data-stagger="80">
          <span class="kicker" data-reveal>{useCases.head.kicker}</span>
          <h2 class="h2" data-split>{useCases.head.title.lead}<span class="accent">{useCases.head.title.accent}</span>{useCases.head.title.tail}</h2>
          {useCases.head.lead && <p class="lead" data-reveal>{useCases.head.lead}</p>}
        </header>

        <div class="uc-grid" data-stagger="110">
          {useCases.cards.map((card, index) => (
            <article class="uc-card card" data-reveal>
              {index === 0 && (
                <div class="uc-visual uc-leads" aria-hidden="true">
                  {useCases.leadTags.map(tag => (
                    <div class="ul-row"><span class="ul-check"></span><span class="skel"></span><span class="ul-tag">{tag}</span></div>
                  ))}
                </div>
              )}
              {index === 1 && (
                <div class="uc-visual uc-bars" aria-hidden="true">
                  {BENCHMARK_BARS.map(bar => (
                    <div class:list={['ub', { 'is-you': bar.you }]}><i style={`--v: ${bar.value}`}></i><span>{bar.rating}</span></div>
                  ))}
                </div>
              )}
              {index === 2 && (
                <div class="uc-visual uc-geo" aria-hidden="true">
                  {GEO_DOTS.map(dot => <i style={`--x: ${dot.x}%; --y: ${dot.y}%; --s: ${dot.s}`}></i>)}
                  <span class="ug-coord mono">45.5231° N, 122.6765° W</span>
                </div>
              )}
              <div class="uc-label"><span class="icon-tile"><Icon name={USE_CASE_ICONS[index]} /></span>{card.label}</div>
              <h3>{card.title}</h3>
              <p>{card.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ⑨ 定价摘要 -->
    <section class="section pricing-teaser band" id="pricing">
      <div class="container">
        <header class="section-head" data-stagger="80">
          <span class="kicker" data-reveal>{pricingTeaser.head.kicker}</span>
          <h2 class="h2" data-split>{pricingTeaser.head.title.lead}<span class="accent">{pricingTeaser.head.title.accent}</span>{pricingTeaser.head.title.tail}</h2>
          {pricingTeaser.head.lead && <p class="lead" data-reveal>{pricingTeaser.head.lead}</p>}
        </header>

        <div class="pt-grid" data-stagger="100" data-spotlight-group>
          {TEASER_LINES.map(line => {
            const copy = pricingTeaser.lines[line.id]
            const { free, next } = teaserPlans(line.id)
            return (
              <a
                class:list={['pt-card card card-link card--lift', { 'is-unavailable': !line.available }]}
                href={`${paths.pricing}#${line.id}`}
                data-spotlight
                data-reveal
                data-cta={`home-pricing-${line.id}`}
              >
                <div class="pt-top">
                  <span class="icon-tile icon-tile--brand"><Icon name={line.icon} /></span>
                  <span class="badge badge--muted">{copy.billing}</span>
                </div>
                <h3 class="h4">{copy.title}{!line.available && <SoonBadge locale={locale} />}</h3>
                {free && <div class="pt-price"><b>{free.price}</b><span>{free.quota}</span></div>}
                {next && <div class="pt-next"><span>{next.name}</span><b>{next.price}</b><span>· {next.quota}</span></div>}
                <span class="link-arrow">{copy.link} <Icon name="arrow-right" /></span>
              </a>
            )
          })}
        </div>
      </div>
    </section>

    <!-- ⑩ 免费工具 -->
    <section class="section tools" id="tools">
      <div class="container">
        <header class="section-head" data-stagger="80">
          <span class="kicker" data-reveal>{tools.head.kicker}</span>
          <h2 class="h2" data-split>{tools.head.title.lead}<span class="accent">{tools.head.title.accent}</span>{tools.head.title.tail}</h2>
          {tools.head.lead && <p class="lead" data-reveal>{tools.head.lead}</p>}
        </header>
        <div class="tools-grid" data-tools-grid data-spotlight-group data-stagger="60">
          {t.layout.footer.tools.map(tool => (
            <a class="tool-card card card-link card--lift" href={`${localePrefix}${tool.path}`} data-spotlight data-reveal data-cta={`home-tool-${tool.id}`}>
              <span class="icon-tile"><Icon name={TOOL_ICONS[tool.id]} /></span>
              <span class="tool-go"><Icon name="arrow-up-right" /></span>
              <h3>{tool.label}</h3>
              <p>{tools.descriptions[tool.id]}</p>
            </a>
          ))}
          <div class="tool-more" data-reveal><Icon name="wrench" class="icon--lg" /><span>{tools.more}</span></div>
        </div>
      </div>
    </section>

    <!-- ⑪ FAQ（同时输出 FAQPage 结构化数据） -->
    <section class="section faq band" id="faq">
      <div class="container faq-layout">
        <div class="faq-aside" data-stagger="80">
          <span class="kicker" data-reveal>{faq.kicker}</span>
          <h2 class="h2" data-split>{faq.title.lead}<span class="accent">{faq.title.accent}</span>{faq.title.tail}</h2>
          <p class="lead" data-reveal>{faq.lead}</p>
          <a class="btn btn-secondary" href={paths.contact} data-reveal data-cta="home-faq-contact"><Icon name="mail" />{faq.contact}</a>
        </div>
        <div class="faq-list" data-stagger="60">
          {faq.items.map((item, index) => (
            <details class="acc" data-reveal data-faq-item={index}>
              <summary>{item.question}<span class="acc-icon"><Icon name="plus" /></span></summary>
              <div class="acc-body"><p>{item.answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ⑫ 收尾 CTA -->
    <section class="section final-cta">
      <div class="container">
        <div class="cta-panel has-deco" data-inview data-reveal="zoom">
          <div class="deco" aria-hidden="true">
            <div class="aurora"><i></i><i></i><i></i></div>
            <div class="bg-contours"></div>
            <div class="bg-grid cta-grid"></div>
            <div class="cta-pins" data-cta-pins></div>
            <div class="noise"></div>
          </div>
          <span class="kicker" data-reveal>{cta.kicker}</span>
          <h2 class="display cta-title" data-split>{cta.title.lead}<span class="accent text-grad is-animated">{cta.title.accent}</span>{cta.title.tail}</h2>
          <p class="lead cta-lead" data-reveal>{cta.lead}</p>
          <div class="cta-actions" data-reveal>
            <CapabilityAction
              capability="extensionInstall"
              locale={locale}
              href={installHref}
              class="btn btn-primary btn-lg"
              data-cta="home-band-install"
              data-magnetic="0.22"
            >
              <Icon name="puzzle" />{cta.install}
            </CapabilityAction>
            <a class="btn btn-secondary btn-lg" href={paths.online} data-cta="home-band-online">{cta.online}</a>
          </div>
          <p class="cta-note" data-reveal>{cta.note}</p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { initHomePage } from '../home/home-page'

  initHomePage()
</script>
