---
/**
 * 首页渲染器（营销 hero + 在线导出操作卡 / 三产品卡 / 社证占位 / FAQ / CTA）。
 *
 * 路由 locale → i18n 字典 → 语义化区块 → Layout 外壳；
 * hero 内嵌 Online Scraper 操作卡（对标竞品首页形态）：输入区可编辑、主按钮为
 * aria-disabled 占位（Online 功能未落地，点击无效），关键词计数由页脚脚本驱动；
 * FAQ 输出 FAQPage 结构化数据，CTA 统一带 data-cta 归因属性（事件经 W6 GA4 通道上报）。
 */
import Layout from '../../layouts/Layout.astro'
import { getContent, type Locale } from '../../i18n/content'
import { localePaths } from '../../i18n/ui'

interface Props {
  /** 当前 locale 路由。 */
  locale?: Locale
}

const { locale = 'en-US' } = Astro.props as Props
const t = getContent(locale)
const page = t.pages.home
// locale 前缀（en-US 为空）；后续语言走 [lang]/ 路由时链接自动带上前缀。
const localePrefix = localePaths[locale] ? `/${localePaths[locale]}` : ''
const extensionPath = `${localePrefix}/extension/`

// CTA 归因：站内链接带 utm（canonical 只取 pathname，不受 query 影响），事件侧用 data-cta（cta_click 事件经 W6 GA4 通道上报）。
const installUtm = (medium: string) =>
  `?utm_source=website&utm_medium=${medium}&utm_campaign=install`

// 操作卡关键词输入行数上限（UI 占位口径，014 云端契约落地时以服务端限制为准）。
const MAX_KEYWORD_LINES = 100

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: page.faq.items.map(item => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
}
---

<Layout
  locale={locale}
  title={page.seo.title}
  description={page.seo.description}
  structuredData={[faqSchema]}
>
  <div class="home" data-home-page>
    <!-- ① hero：营销文案 + 在线导出操作卡（Online 未落地，主按钮为占位无效） -->
    <section class="hero" aria-labelledby="home-hero-title">
      <div class="container hero-inner">
        <p class="eyebrow">{page.hero.eyebrow}</p>
        <h1 id="home-hero-title">{page.hero.title}</h1>
        <p class="hero-description">{page.hero.description}</p>
        <ul class="hero-highlights">
          {page.hero.highlights.map(item => (
            <li>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2.5 7.5 5.5 10.5 11.5 3.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>
        <div
          class="scraper-card"
          data-scraper-card
          data-max-keywords={MAX_KEYWORD_LINES}
        >
          <div class="scraper-card-head">
            <label class="scraper-label" for="home-scraper-keywords">
              {page.hero.scraperCard.label}
            </label>
            <span class="scraper-hint">{page.hero.scraperCard.hint}</span>
          </div>
          <textarea
            id="home-scraper-keywords"
            class="scraper-textarea"
            rows="4"
            spellcheck="false"
            aria-label={page.hero.scraperCard.textareaLabel}
            data-scraper-keywords
          >{page.hero.scraperCard.sampleKeywords.join('\n')}</textarea>
          <div class="scraper-card-foot">
            <button type="button" class="btn-primary" aria-disabled="true" data-pending-cta>
              {page.hero.scraperCard.submitLabel}
            </button>
            <span class="scraper-count" data-scraper-count aria-live="polite">
              {page.hero.scraperCard.sampleKeywords.length} / {MAX_KEYWORD_LINES}
            </span>
          </div>
          <p class="scraper-note">{page.hero.scraperCard.note}</p>
          <div class="scraper-links">
            <a
              href={`${extensionPath}${installUtm('home-hero')}`}
              data-cta="home-hero-install"
            >{page.hero.primaryCta}</a>
            <span class="scraper-links-divider" aria-hidden="true">·</span>
            <a class="scraper-links-product" href={extensionPath} data-cta="home-hero-product">
              {page.hero.secondaryCta}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ② 三产品形态卡（插件 / Online / API 均为链接卡） -->
    <section class="products" aria-labelledby="home-products-title">
      <div class="container">
        <header class="section-header">
          <p class="eyebrow">{page.products.eyebrow}</p>
          <h2 id="home-products-title">{page.products.title}</h2>
          <p class="section-description">{page.products.description}</p>
        </header>
        <div class="product-grid">
          {page.products.items.map(item => (
            <article class="product-card" data-product-card={item.id}>
              <p class="product-badge is-available">{page.products.availableLabel}</p>
              <h3>{item.name}</h3>
              <p class="product-tagline">{item.tagline}</p>
              <p class="product-description">{item.description}</p>
              <ul class="product-bullets">
                {item.bullets.map(bullet => <li>{bullet}</li>)}
              </ul>
              <a class="product-link" href={item.href} data-cta={`home-product-${item.id}`}>
                {item.ctaLabel}
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M3 7h8M7.5 3.5 11 7l-3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ③ 社证占位区（早期用户场景，非虚构具名评价） -->
    <section class="testimonials" aria-labelledby="home-testimonials-title">
      <div class="container">
        <header class="section-header">
          <p class="eyebrow">{page.testimonials.eyebrow}</p>
          <h2 id="home-testimonials-title">{page.testimonials.title}</h2>
        </header>
        <div class="testimonial-grid">
          {page.testimonials.items.map(item => (
            <figure class="testimonial-card">
              <blockquote>{item.quote}</blockquote>
              <figcaption>{item.role}</figcaption>
            </figure>
          ))}
        </div>
        <p class="testimonial-note">{page.testimonials.note}</p>
      </div>
    </section>

    <!-- ④ FAQ -->
    <section class="faq" aria-labelledby="home-faq-title">
      <div class="container faq-inner">
        <header class="section-header">
          <p class="eyebrow">{t.common.faqLabel}</p>
          <h2 id="home-faq-title">{page.faq.title}</h2>
          {page.faq.description && <p class="section-description">{page.faq.description}</p>}
        </header>
        <div class="faq-list">
          {page.faq.items.map((item, index) => (
            <details class="faq-item" data-faq-item={index}>
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- ⑤ CTA -->
    <section class="cta-band" aria-labelledby="home-cta-title">
      <div class="container cta-inner">
        <h2 id="home-cta-title">{page.cta.title}</h2>
        <p>{page.cta.description}</p>
        <a
          class="btn-primary"
          href={`${extensionPath}${installUtm('home-cta')}`}
          data-cta="home-band-install"
        >{page.cta.button}</a>
        {page.cta.note && <p class="cta-note">{page.cta.note}</p>}
      </div>
    </section>
  </div>
</Layout>

<script>
  // 操作卡关键词计数：按非空行统计；上限来自 data-max-keywords（SSR 侧单一来源），
  // 纯本地 UI 状态，不发起任何请求（Online 采集功能未落地）。
  const card = document.querySelector('[data-scraper-card]')
  const textarea = card?.querySelector<HTMLTextAreaElement>('[data-scraper-keywords]')
  const count = card?.querySelector<HTMLElement>('[data-scraper-count]')
  if (card instanceof HTMLElement && textarea && count) {
    const max = Number(card.dataset.maxKeywords)
    const update = (): void => {
      const lines = textarea.value.split('\n').filter(line => line.trim().length > 0).length
      count.textContent = `${lines} / ${max}`
    }
    textarea.addEventListener('input', update)
    update()
  }
</script>

<style>
  .home {
    padding-top: var(--space-10);
  }

  .eyebrow {
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .section-header h2,
  .hero h1 {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--text);
  }

  .hero h1 {
    max-width: 760px;
    margin-inline: auto;
    font-size: clamp(36px, 4.8vw, 58px);
    line-height: 1.05;
  }

  .section-header h2 {
    font-size: 32px;
    line-height: 40px;
    letter-spacing: -0.02em;
  }

  .section-description {
    max-width: 640px;
    margin-top: var(--space-3);
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.6;
  }

  /* 按钮样式走 Layout 全局原语 .btn-primary / .btn-secondary（design.md §7） */

  .btn-primary:focus-visible,
  .btn-secondary:focus-visible,
  .product-link:focus-visible,
  .faq-item summary:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 3px;
  }

  /* ① hero：营销文案居中 + 在线导出操作卡 */
  .hero-inner {
    padding: var(--space-10) 0 var(--space-16);
    text-align: center;
  }

  .hero-description {
    max-width: 680px;
    margin-top: var(--space-4);
    margin-inline: auto;
    color: var(--text-2);
    font-size: 18px;
    line-height: 1.6;
  }

  .hero-highlights {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-6);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .hero-highlights li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-2);
    font-size: 14px;
    font-weight: 600;
  }

  .hero-highlights svg {
    color: var(--primary);
    flex-shrink: 0;
  }

  /* 在线导出操作卡：输入区可用，主按钮为占位无效（Online 未落地） */
  .scraper-card {
    max-width: 760px;
    margin: var(--space-8) auto 0;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--rounded-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    text-align: left;
  }

  .scraper-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
  }

  .scraper-label {
    color: var(--text);
    font-size: 15px;
    font-weight: 600;
  }

  .scraper-hint {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 11.5px;
  }

  .scraper-textarea {
    width: 100%;
    min-height: 132px;
    margin-top: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--rounded-sm);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1.6;
    resize: vertical;
  }

  .scraper-textarea:focus {
    outline: 2px solid var(--ring);
    outline-offset: 1px;
  }

  .scraper-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  /* 未落地功能按钮：可聚焦但视觉降级（design.md 禁用语义 = 降透明度），无 handler 点击无效 */
  .scraper-card button[aria-disabled='true'] {
    opacity: 0.55;
    cursor: default;
  }

  .scraper-count {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }

  .scraper-note {
    margin-top: var(--space-4);
    color: var(--text-3);
    font-size: 13px;
    line-height: 1.6;
  }

  .scraper-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    font-size: 14px;
    font-weight: 600;
  }

  .scraper-links a {
    color: var(--link);
  }

  .scraper-links a:hover {
    color: var(--primary-hover);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .scraper-links-divider {
    color: var(--text-3);
  }

  /* ② 产品卡 */
  .products {
    padding: var(--space-16) 0;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .product-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--rounded-md);
    background: var(--surface);
    box-shadow: var(--shadow-card);
  }

  .product-badge {
    align-self: flex-start;
    padding: 2px 10px;
    border-radius: var(--rounded-full);
    background: var(--primary-soft);
    color: var(--primary-hover);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    line-height: 20px;
  }

  .product-card h3 {
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    line-height: 28px;
    color: var(--text);
  }

  .product-tagline {
    margin-top: var(--space-1);
    color: var(--text-2);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.6;
  }

  .product-description {
    margin-top: var(--space-3);
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.6;
  }

  .product-bullets {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .product-bullets li {
    position: relative;
    padding-left: var(--space-4);
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.55;
  }

  .product-bullets li::before {
    position: absolute;
    top: 9px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: var(--rounded-full);
    background: var(--primary);
    content: '';
  }

  .product-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-6);
    color: var(--link);
    font-size: 14px;
    font-weight: 600;
  }

  .product-link:hover {
    color: var(--primary-hover);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* ③ 社证占位 */
  .testimonials {
    padding: var(--space-16) 0;
    background: var(--surface);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-8);
  }

  .testimonial-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--rounded-md);
    background: var(--bg);
  }

  .testimonial-card blockquote {
    color: var(--text);
    font-size: 15px;
    line-height: 1.7;
  }

  .testimonial-card figcaption {
    margin-top: auto;
    color: var(--text-2);
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .testimonial-note {
    max-width: 640px;
    margin-top: var(--space-6);
    color: var(--text-2);
    font-size: 13px;
    line-height: 1.6;
  }

  /* ④ FAQ：原生 details/summary，零 JS */
  .faq {
    padding: var(--space-16) 0;
  }

  .faq-inner {
    max-width: 800px;
  }

  .faq-list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .faq-item {
    border: 1px solid var(--border);
    border-radius: var(--rounded-sm);
    background: var(--surface);
    padding: var(--space-4) var(--space-6);
  }

  .faq-item[open] {
    background: var(--surface-2);
  }

  .faq-item summary {
    color: var(--text);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.6;
    cursor: pointer;
  }

  .faq-item p {
    margin-top: var(--space-2);
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.7;
  }

  /* ⑤ CTA 行动区 */
  .cta-band {
    padding: var(--space-16) 0 var(--space-24);
  }

  .cta-inner {
    padding: var(--space-16) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--rounded-lg);
    background: var(--surface);
    box-shadow: var(--shadow-card);
    text-align: center;
  }

  .cta-inner h2 {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 600;
    line-height: 40px;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .cta-inner > p {
    max-width: 560px;
    margin: var(--space-3) auto 0;
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.6;
  }

  .cta-inner .btn-primary {
    margin-top: var(--space-6);
  }

  .cta-note {
    margin-top: var(--space-3);
    color: var(--text-2);
    font-size: 13px;
  }

  @media (max-width: 960px) {
    .product-grid,
    .testimonial-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-inner {
      padding: var(--space-6) 0 var(--space-10);
    }

    .products,
    .testimonials,
    .faq {
      padding: var(--space-10) 0;
    }

    .cta-band {
      padding: var(--space-10) 0 var(--space-16);
    }

    .cta-inner {
      padding: var(--space-10) var(--space-4);
    }
  }
</style>
