---
/**
 * 插件页能力展台（设计稿 extension.html ④）：左侧 6 个能力 tab，右侧场景面板交叉淡入。
 *
 * 选中 tab 底部进度条走完即切到下一项；悬停舞台或键盘聚焦时暂停，方向键切换，离屏暂停（data-inview）。
 * 减弱动效下不自动轮播，只保留手动切换。场景内容与插件导出口径一致：36 列（Plus Code 列位保留、当前为空）、
 * 11 个评论列、街景图被过滤、官网补全 6 个社媒、批量任务 90 秒无进展跳过、导出 CSV / JSON。
 */
import type { Locale } from '../../i18n/content'
import type { ExtensionFeatureId, ExtensionPageContent } from '../../i18n/schema'
import Icon from '../site/Icon.astro'
import { fillCopy, splitCopy } from '../product/copy'
import ProductSectionHead from '../product/ProductSectionHead.astro'
import StarBar from './StarBar.astro'
import {
  BATCH_PANEL_SAMPLE,
  ENRICH_SAMPLES,
  EXPORT_SAMPLE,
  PHOTO_SAMPLES,
  RECORD_SAMPLE,
  REVIEW_SAMPLES,
  exportFileName,
  type BatchItemState
} from './extension-samples'

interface Props {
  locale: Locale
  features: ExtensionPageContent['features']
}

const { locale, features } = Astro.props
const { business, reviews, photos, enrichment, batch, files } = features

// 键名加引号：Astro frontmatter 会把行首的裸 export 当作导出语句提升
const TAB_ICONS: Record<ExtensionFeatureId, string> = {
  'business': 'building',
  'reviews': 'review',
  'photos': 'image',
  'enrichment': 'mail',
  'batch': 'list-plus',
  'export': 'download'
}
const DESTINATION_ICONS = ['download', 'filter', 'zap']

const fields: Array<{ label: string; value: string; mono?: boolean; rating?: boolean }> = [
  { label: business.fields.phone, value: RECORD_SAMPLE.phone, mono: true },
  { label: business.fields.website, value: RECORD_SAMPLE.website },
  { label: business.fields.rating, value: fillCopy(business.reviewCount, { count: new Intl.NumberFormat(locale).format(RECORD_SAMPLE.reviews) }), rating: true },
  { label: business.fields.hours, value: RECORD_SAMPLE.hours },
  { label: business.fields.timeZone, value: RECORD_SAMPLE.timeZone, mono: true },
  { label: business.fields.coordinates, value: RECORD_SAMPLE.coordinates, mono: true },
  { label: business.fields.placeId, value: RECORD_SAMPLE.placeId, mono: true },
  { label: business.fields.mapsUrl, value: RECORD_SAMPLE.mapsUrl, mono: true }
]
/** 960px 以下记录卡改单列，只显示前 5 个字段（同设计稿移动端）；脚注「+N more」按当前可见字段数分别计数。 */
const NARROW_FIELDS = 5
const moreCopy = (shown: number) => fillCopy(business.more, { count: RECORD_SAMPLE.totalColumns - shown })
const [columnsBefore, columnsAfter] = splitCopy(business.columns, 'count')
const batchStates: Record<BatchItemState, (rows: number) => string> = {
  done: rows => fillCopy(batch.done, { count: rows }),
  stuck: () => batch.skipped,
  run: () => batch.running,
  queued: () => batch.queued
}
---

<section class="section xs" id="features">
  <div class="container">
    <ProductSectionHead head={features.head} />

    <div class="xs-layout" data-xs data-inview>
      <div class="xs-tabs" role="tablist" aria-label={features.tabsLabel} data-stagger="60">
        {features.tabs.map((tab, index) => (
          <button
            class="xs-tab"
            type="button"
            role="tab"
            id={`xs-tab-${tab.id}`}
            aria-controls={`xs-${tab.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            tabindex={index === 0 ? 0 : -1}
            data-reveal
          >
            <span class="xs-tab-ic"><Icon name={TAB_ICONS[tab.id]} /></span>
            <span class="xs-tab-text"><b>{tab.title}</b><span>{tab.description}</span></span>
            <span class="xs-bar"><i></i></span>
          </button>
        ))}
      </div>

      <div class="xs-stage card" data-reveal="zoom">
        <div class="xs-stage-grid" aria-hidden="true"></div>

        <div class="xs-panel is-active" id="xs-business" role="tabpanel" aria-labelledby="xs-tab-business">
          <div class="xp-record">
            <div class="xp-rec-head">
              <span class="xp-rec-avatar"><Icon name="coffee" /></span>
              <div>
                <b>{RECORD_SAMPLE.name}</b>
                <span>{RECORD_SAMPLE.summary}</span>
              </div>
              <span class="badge badge--ok">{business.claimed}</span>
            </div>
            <dl class="xp-fields">
              {fields.map((field, index) => (
                <div class:list={{ 'xp-wide-only': index >= NARROW_FIELDS }} style={`--i: ${index}`}>
                  <dt>{field.label}</dt>
                  <dd class:list={{ mono: field.mono }}>
                    {field.rating ? (
                      <>
                        <span class="rating"><Icon name="star" class="icon--fill" />{RECORD_SAMPLE.rating.toFixed(1)}</span> · {field.value}
                      </>
                    ) : field.value}
                  </dd>
                </div>
              ))}
            </dl>
            <div class="xp-rec-foot">
              <span class="xp-ring" aria-hidden="true">
                <svg viewBox="0 0 36 36"><circle cx="18" cy="18" r="15"></circle><circle class="xp-ring-fill" cx="18" cy="18" r="15" pathLength="100"></circle></svg>
              </span>
              <span>{columnsBefore}<b>{RECORD_SAMPLE.totalColumns}</b>{columnsAfter} · {business.reserved}</span>
              <span class="xp-rec-more mono xp-wide-only">{moreCopy(fields.length)}</span>
              <span class="xp-rec-more mono xp-narrow-only">{moreCopy(NARROW_FIELDS)}</span>
            </div>
          </div>
        </div>

        <div class="xs-panel" id="xs-reviews" role="tabpanel" aria-labelledby="xs-tab-reviews" hidden>
          <div class="xp-rev-top">
            <span class="xp-rev-title"><b>{reviews.title}</b> · {RECORD_SAMPLE.name}</span>
            <span class="badge">{fillCopy(reviews.columns, { count: RECORD_SAMPLE.reviewColumns })}</span>
          </div>
          <div class="xp-rev-list">
            {REVIEW_SAMPLES.map((review, index) => (
              <article class="xp-review" style={`--i: ${index}`}>
                <span class="xp-av" style={`--tone: var(--${review.tone})`} aria-hidden="true">{review.initial}</span>
                <div>
                  <div class="xp-review-meta"><b>{review.author}</b><StarBar rating={review.rating} /><span class="mono">{review.date}</span></div>
                  <p>{review.text}</p>
                  {review.owner && (
                    <div class="xp-owner"><b>{reviews.ownerReply}</b> · {review.owner.date}<br />{review.owner.text}</div>
                  )}
                </div>
              </article>
            ))}
          </div>
          <div class="xp-rev-foot"><span class="spinner"></span>{reviews.loading}</div>
        </div>

        <div class="xs-panel" id="xs-photos" role="tabpanel" aria-labelledby="xs-tab-photos" hidden>
          <div class="xp-pho-grid">
            {PHOTO_SAMPLES.tones.map((tone, index) => (
              <span class:list={['xp-ph', { 'xp-ph--sv': index === PHOTO_SAMPLES.streetView }]} style={`--i: ${index}; --tone: var(--${tone})`}>
                {index === PHOTO_SAMPLES.streetView && <em><Icon name="x" />{photos.streetView}</em>}
              </span>
            ))}
          </div>
          <div class="xp-pho-urls mono">
            {PHOTO_SAMPLES.urls.map((url, index) => <span style={`--i: ${index}`}>{url}</span>)}
          </div>
        </div>

        <div class="xs-panel" id="xs-enrichment" role="tabpanel" aria-labelledby="xs-tab-enrichment" hidden>
          <div class="xp-site">
            <span class="xp-site-ic"><Icon name="web" /></span>
            <div><small>{enrichment.website}</small><b class="mono">{ENRICH_SAMPLES.domain}</b></div>
            <span class="xp-site-scan" aria-hidden="true"></span>
          </div>
          <span class="xp-wire" aria-hidden="true"></span>
          <ul class="xp-found" role="list">
            {ENRICH_SAMPLES.found.map((item, index) => (
              <li style={`--i: ${index}; --c: var(--${item.tone})`}>
                <Icon name={item.icon} class="xp-found-ic" /><span class="mono">{item.value}</span><Icon name="check" class="xp-ok" />
              </li>
            ))}
          </ul>
          <div class="xp-nets">
            {ENRICH_SAMPLES.more.map((icon, index) => <span style={`--i: ${index + ENRICH_SAMPLES.found.length}`} aria-hidden="true"><Icon name={icon} /></span>)}
            <em>{enrichment.moreNetworks}</em>
          </div>
        </div>

        <div class="xs-panel" id="xs-batch" role="tabpanel" aria-labelledby="xs-tab-batch" hidden>
          <div class="xp-bat-head">
            <b>{BATCH_PANEL_SAMPLE.name}</b>
            <span class="xp-bat-counts mono">
              <span class="ok">{fillCopy(batch.complete, { count: BATCH_PANEL_SAMPLE.complete })}</span>
              <span class="warn">{fillCopy(batch.stuck, { count: BATCH_PANEL_SAMPLE.stuck })}</span>
              <span>{fillCopy(batch.total, { count: BATCH_PANEL_SAMPLE.total })}</span>
            </span>
          </div>
          <ul class="xp-bat-list" role="list">
            {BATCH_PANEL_SAMPLE.items.map((item, index) => (
              <li class={`is-${item.state}`} style={`--i: ${index}`}>
                <span>{item.keyword}</span>
                <em>{item.state === 'run' && <span class="spinner"></span>}{batchStates[item.state](item.rows)}</em>
              </li>
            ))}
          </ul>
          <div class="xp-bat-foot"><Icon name="download" />{batch.autoExport}</div>
        </div>

        <div class="xs-panel" id="xs-export" role="tabpanel" aria-labelledby="xs-tab-export" hidden>
          <div class="xp-formats" aria-hidden="true">
            {files.formats.map((format, index) => <span class:list={{ 'is-on': index === 0 }}>{format}</span>)}
          </div>
          <div class="xp-file">
            <span class="xp-file-ic"><Icon name="file-sheet" /></span>
            <div>
              <b class="mono" data-xp-file>{exportFileName(EXPORT_SAMPLE.rows, EXPORT_SAMPLE.keyword, new Date())}</b>
              <small>{fillCopy(files.fileMeta, { rows: EXPORT_SAMPLE.rows, selected: EXPORT_SAMPLE.selectedColumns, total: RECORD_SAMPLE.totalColumns })}</small>
            </div>
          </div>
          <div class="xp-dests">
            {files.destinations.map((destination, index) => (
              <div class:list={['xp-dest', { 'is-hit': index === 0 }]} style={`--i: ${index}`}>
                <span><Icon name={DESTINATION_ICONS[index]} /></span><b>{destination.title}</b><small>{destination.description}</small>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { reducedMotion } from '../../scripts/site/motion'
  import { part } from '../../scripts/pages/product-page'
  import { EXPORT_SAMPLE, exportFileName } from './extension-samples'

  const KEY_STEPS: Partial<Record<string, number>> = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 }

  function initShowcase(layout: HTMLElement): void {
    const tabs = Array.from(layout.querySelectorAll<HTMLButtonElement>('[role="tab"]'))
    const panels = tabs.map(tab => part(layout, `#${tab.getAttribute('aria-controls')}`, HTMLElement))
    const strip = part(layout, '[role="tablist"]', HTMLElement)
    const stage = part(layout, '.xs-stage', HTMLElement)
    let current = 0

    // 脚本接管后所有面板常驻，改用 is-active 交叉淡入
    panels.forEach(panel => {
      panel.hidden = false
    })

    const select = (index: number, focus = false) => {
      current = index
      tabs.forEach((tab, position) => {
        const active = position === index
        tab.setAttribute('aria-selected', String(active))
        tab.tabIndex = active ? 0 : -1
        panels[position].classList.toggle('is-active', active)
        panels[position].setAttribute('aria-hidden', String(!active))
      })
      if (focus) tabs[index].focus()
      // 窄屏横向标签：把当前项滚进可视区
      if (strip.scrollWidth > strip.clientWidth) {
        strip.scrollTo({ left: tabs[index].offsetLeft - 16, behavior: reducedMotion() ? 'auto' : 'smooth' })
      }
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(index))
      // 进度条走完：自动切到下一项。会话中途开启减弱动效时全局规则把进度条压到近乎 0 时长，
      // 这里改为停止轮播、停在当前项（与加载时即减弱动效的终态一致），不再每帧切换
      part(tab, '.xs-bar i', HTMLElement).addEventListener('animationend', () => {
        if (reducedMotion()) {
          layout.classList.remove('is-auto')
          return
        }
        if (index === current) select((current + 1) % tabs.length)
      })
    })
    strip.addEventListener('keydown', event => {
      const step = KEY_STEPS[event.key]
      if (!step) return
      event.preventDefault()
      select((current + step + tabs.length) % tabs.length, true)
    })

    if (!reducedMotion()) {
      layout.classList.add('is-auto')
      const pause = () => layout.classList.add('is-paused')
      const resume = () => {
        if (!layout.contains(document.activeElement)) layout.classList.remove('is-paused')
      }
      stage.addEventListener('pointerenter', pause)
      stage.addEventListener('pointerleave', resume)
      layout.addEventListener('focusin', pause)
      layout.addEventListener('focusout', () => window.setTimeout(resume, 0))
    }

    part(layout, '[data-xp-file]', HTMLElement).textContent = exportFileName(EXPORT_SAMPLE.rows, EXPORT_SAMPLE.keyword, new Date())
    select(0)
  }

  const layout = document.querySelector<HTMLElement>('[data-xs]')
  if (layout) initShowcase(layout)
</script>

<style>
  .xs-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(24px, 4vw, 64px);
    margin-top: clamp(40px, 5vw, 64px);
  }

  .xs-tabs {
    display: grid;
    align-content: start;
    gap: 6px;
  }

  .xs-tab {
    position: relative;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    align-items: start;
    gap: 14px;
    padding: 16px 18px 18px;
    overflow: hidden;
    border-radius: var(--r-md);
    text-align: left;
    transition:
      background-color var(--dur-3) var(--ease-out),
      box-shadow var(--dur-3) var(--ease-out);
  }

  .xs-tab:hover {
    background: var(--surface-2);
  }

  .xs-tab[aria-selected='true'] {
    background: var(--surface);
    box-shadow: var(--shadow-sm), inset 0 0 0 1px var(--border);
  }

  .xs-tab-ic {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: var(--r-sm);
    background: var(--surface-2);
    color: var(--text-3);
    transition:
      background var(--dur-3) var(--ease-out),
      color var(--dur-3) var(--ease-out),
      border-color var(--dur-3) var(--ease-out),
      transform var(--dur-3) var(--ease-spring);
  }

  .xs-tab-ic :global(.icon) {
    width: 19px;
    height: 19px;
  }

  .xs-tab[aria-selected='true'] .xs-tab-ic {
    border-color: transparent;
    background: var(--grad-brand);
    box-shadow: var(--shadow-sm);
    color: var(--primary-fg);
    transform: rotate(-6deg);
  }

  .xs-tab-text {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .xs-tab-text b {
    color: var(--text);
    font-size: 16px;
    font-weight: 650;
    letter-spacing: -0.012em;
  }

  .xs-tab-text span {
    color: var(--text-3);
    font-size: 14px;
    line-height: 1.5;
  }

  .xs-tab[aria-selected='true'] .xs-tab-text span {
    color: var(--text-2);
  }

  .xs-bar {
    position: absolute;
    right: 18px;
    bottom: 0;
    left: 18px;
    height: 2px;
    overflow: hidden;
    border-radius: var(--r-2xs);
  }

  .xs-tab[aria-selected='true'] .xs-bar {
    background: var(--border);
  }

  .xs-bar i {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--grad-brand);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  /* 轮播节拍：进度条匀速走满（7 秒一项），走完由脚本切到下一项 */
  .xs-layout.is-auto .xs-tab[aria-selected='true'] .xs-bar i {
    animation: xs-progress 7s linear forwards;
  }

  .xs-layout.is-paused .xs-tab[aria-selected='true'] .xs-bar i {
    animation-play-state: paused;
  }

  @keyframes xs-progress {
    to {
      transform: scaleX(1);
    }
  }

  .xs-stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: 540px;
    border-radius: var(--r-xl);
    background:
      radial-gradient(90% 70% at 85% 0%, var(--primary-soft), transparent 62%),
      radial-gradient(70% 60% at 0% 100%, var(--accent-soft), transparent 60%),
      var(--surface);
  }

  .xs-stage-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-position: center;
    background-size: 32px 32px;
    -webkit-mask-image: radial-gradient(ellipse 70% 65% at 50% 50%, var(--mask-solid) 20%, transparent 80%);
    mask-image: radial-gradient(ellipse 70% 65% at 50% 50%, var(--mask-solid) 20%, transparent 80%);
  }

  .xs-stage .xs-panel {
    position: relative;
    grid-area: 1 / 1;
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: clamp(24px, 3.4vw, 48px);
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, 12px, 0) scale(0.985);
    /* 面板切换自带交叉淡入，不叠站级 tabpanel 入场 */
    animation: none;
    transition:
      opacity var(--dur-3) var(--ease-out),
      transform var(--dur-4) var(--ease-out),
      visibility var(--dur-3) var(--ease-out);
  }

  .xs-stage .xs-panel.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
  }

  .xs-panel > * {
    width: min(100%, 520px);
  }

  /* 激活时子元素错峰入场（--i 为序号） */
  @keyframes xp-in {
    from {
      opacity: 0;
      transform: translate3d(0, 14px, 0);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes xp-pop {
    0% {
      opacity: 0;
      transform: scale(0.82);
    }

    60% {
      opacity: 1;
      transform: scale(1.04);
    }

    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* 1. 商家记录卡 */
  .xp-record {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
  }

  .xp-rec-head {
    display: grid;
    grid-template-columns: 46px minmax(0, 1fr) auto;
    align-items: center;
    gap: 14px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--border);
  }

  .xp-rec-avatar {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: var(--r-sm);
    background: var(--grad-brand);
    box-shadow: var(--shadow-sm);
    color: var(--primary-fg);
  }

  .xp-rec-head b {
    display: block;
    color: var(--text);
    font-size: var(--fs-lead);
    font-weight: 650;
    letter-spacing: -0.015em;
  }

  .xp-rec-head div span {
    display: block;
    margin-top: 2px;
    color: var(--text-3);
    font-size: 13px;
  }

  .xp-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
  }

  .xp-fields > div {
    min-width: 0;
    padding: 12px 20px;
    border-top: 1px solid var(--border);
  }

  .xp-fields > div:nth-child(-n + 2) {
    border-top: 0;
  }

  .xp-fields > div:nth-child(even) {
    border-left: 1px solid var(--border);
  }

  .xp-fields dt {
    color: var(--text-3);
    font-family: var(--font-mono);
    font-variant-ligatures: none;
    font-size: 10.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .xp-fields dd {
    margin: 2px 0 0;
    overflow: hidden;
    color: var(--text);
    font-size: 13.5px;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .xp-fields dd.mono {
    font-size: 12.5px;
  }

  .xp-fields .rating :global(.icon) {
    width: 13px;
    height: 13px;
  }

  .xs-panel.is-active .xp-fields > div {
    animation:
      xp-in var(--dur-4) var(--ease-out) both,
      xp-flash var(--dur-5) var(--ease-out) both;
    animation-delay: calc(var(--i) * 120ms + 180ms);
  }

  @keyframes xp-flash {
    0% {
      background-color: var(--primary-soft);
    }

    100% {
      background-color: transparent;
    }
  }

  .xp-rec-foot {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    border-top: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text-2);
    font-size: 13px;
  }

  .xp-rec-foot b {
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }

  .xp-ring svg {
    display: block;
    width: 26px;
    height: 26px;
    transform: rotate(-90deg);
  }

  .xp-ring circle {
    fill: none;
    stroke: var(--border-2);
    stroke-width: 3.5;
  }

  .xp-ring .xp-ring-fill {
    stroke: var(--accent);
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    stroke-linecap: round;
  }

  .xs-panel.is-active .xp-ring-fill {
    animation: xp-ring var(--dur-5) var(--ease-out) forwards;
    animation-delay: 300ms;
  }

  @keyframes xp-ring {
    to {
      stroke-dashoffset: 0;
