---
/**
 * 插件页批量任务暗色岛（设计稿 extension.html ⑤）：插件 Dashboard 页 mock，界面文案与真实批量面板一致。
 * 循环演示任务名与关键词逐字输入 → Start Extracting → 逐项状态（含 90 秒无进展被跳过）→ 完成后自动导出提示；
 * 离屏 / 后台暂停，减弱动效下停在第一个任务的完成态。mock 只是插画（aria-hidden），不放站点动作按钮。
 */
import type { ExtensionPageContent } from '../../i18n/schema'
import Icon from '../site/Icon.astro'
import AccentHeading from '../product/AccentHeading.astro'
import { fillCopy } from '../product/copy'
import { BATCH_DASHBOARD_URL, BATCH_HISTORY, BATCH_LINE_LIMIT } from './extension-samples'

interface Props {
  batch: ExtensionPageContent['batch']
}

const { batch } = Astro.props
const mock = batch.mock
---

<section class="section xb scheme-dark has-deco" id="batch" data-inview>
  <div class="deco" aria-hidden="true">
    <div class="bg-grid xb-grid"></div>
    <div class="xb-glow"></div>
    <div class="noise"></div>
  </div>
  <div class="container xb-layout">
    <div class="xb-copy" data-stagger="80">
      <span class="kicker" data-reveal>{batch.head.kicker}</span>
      <h2 class="h2" data-split><AccentHeading title={batch.head.title} accentClass="text-grad" /></h2>
      <p class="lead" data-reveal>{batch.head.lead}</p>
      <ul class="check-list" role="list" data-reveal>
        {batch.checks.map(item => <li>{item}</li>)}
      </ul>
    </div>

    <div
      class="xb-visual"
      data-reveal="right"
      data-xb
      data-line-count={mock.lineCount}
      data-progress={mock.progress}
      data-progress-stuck={mock.progressStuck}
      data-progress-exported={mock.progressExported}
      data-line-run={mock.lines.run}
      data-line-done={mock.lines.done}
      data-line-stuck={mock.lines.stuck}
      data-complete={mock.complete}
    >
      <div class="browser xb-frame">
        <div class="browser-bar">
          <div class="win-dots" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="browser-url">
            <Icon name="puzzle" />
            <span>{BATCH_DASHBOARD_URL}</span>
          </div>
        </div>
        <div class="xb-body" aria-hidden="true">
          <div class="xb-tabs"><span class="is-on">{mock.tabs[0]}</span><span>{mock.tabs[1]}</span></div>
          <div class="xb-form">
            <div class="xb-field">
              <small>{mock.taskName}</small>
              <span class="xb-input" data-xb-name data-placeholder={mock.taskPlaceholder}></span>
            </div>
            <div class="xb-field">
              <small>{mock.keywords} <em class="mono" data-xb-lines>{fillCopy(mock.lineCount, { count: 0, limit: BATCH_LINE_LIMIT })}</em></small>
              <div class="xb-area" data-xb-area></div>
            </div>
            <span class="xb-start" data-xb-start><Icon name="zap" />{mock.start}</span>
          </div>
          <div class="xb-table">
            <div class="xb-th"><span>{mock.columns.task}</span><span>{mock.columns.status}</span><span>{mock.columns.actions}</span></div>
            <div class="xb-rows" data-xb-rows>
              {BATCH_HISTORY.map(task => (
                <div class="xb-tr">
                  <span class="xb-task">{task.name}</span>
                  <span class="xb-status"><span><span class="badge badge--ok">{mock.complete}</span><em class="mono">{fillCopy(mock.progress, { done: task.done, total: task.total })}</em></span></span>
                  <span class="xb-acts"><Icon name="copy" /><Icon name="x" /></span>
                </div>
              ))}
            </div>
          </div>
        </div>
        <div class="xb-toast" data-xb-toast aria-hidden="true">
          <span class="toast-icon"><Icon name="check" /></span>
          <span class="xb-toast-text"><b>{mock.toast}</b><small class="mono" data-xb-file></small></span>
        </div>
      </div>
      <div class="float-chip xb-chip floaty" style="--float-t: 7.5s" aria-hidden="true">
        <span class="icon-tile icon-tile--ok"><Icon name="database" /></span>
        <span><small>{mock.chip.label}</small>{mock.chip.value}</span>
      </div>

      <template data-xb-line-template><div><span></span><em></em></div></template>
      <template data-xb-row-template>
        <div class="xb-tr is-new">
          <span class="xb-task" data-task></span>
          <span class="xb-status">
            <span><span class="badge" data-badge>{mock.running}</span><em class="mono" data-progress></em></span>
            <span class="progress"><i data-bar></i></span>
          </span>
          <span class="xb-acts"><Icon name="copy" /><Icon name="x" /></span>
        </div>
      </template>
    </div>
  </div>
</section>

<script>
  import { reducedMotion, visibilityGate } from '../../scripts/site/motion'
  import { copyOf, part, stamp } from '../../scripts/pages/product-page'
  import { fillCopy } from '../product/copy'
  import { BATCH_LINE_LIMIT, BATCH_TASKS, exportFileName, type BatchTask } from './extension-samples'

  type LineState = 'run' | 'done' | 'stuck'

  /** 关键词行状态 → 根元素上的文案键。 */
  const LINE_COPY: Record<LineState, string> = { run: 'lineRun', done: 'lineDone', stuck: 'lineStuck' }
  /** 任务表最多保留的行数。 */
  const TABLE_LIMIT = 3

  function initBatch(root: HTMLElement): void {
    const name = part(root, '[data-xb-name]', HTMLElement)
    const area = part(root, '[data-xb-area]', HTMLElement)
    const lines = part(root, '[data-xb-lines]', HTMLElement)
    const start = part(root, '[data-xb-start]', HTMLElement)
    const rows = part(root, '[data-xb-rows]', HTMLElement)
    const toast = part(root, '[data-xb-toast]', HTMLElement)
    const file = part(root, '[data-xb-file]', HTMLElement)

    const lineCount = (count: number) => fillCopy(copyOf(root, 'lineCount'), { count, limit: BATCH_LINE_LIMIT })
    const progressText = (done: number, total: number, stuck: number) =>
      fillCopy(copyOf(root, stuck ? 'progressStuck' : 'progress'), { done, total, stuck })

    const makeLine = (text = '') => {
      const line = stamp(root, '[data-xb-line-template]', HTMLElement)
      part(line, 'span', HTMLElement).textContent = text
      return line
    }
    const setLine = (line: HTMLElement, state: LineState) => {
      line.className = `is-${state}`
      part(line, 'em', HTMLElement).textContent = copyOf(root, LINE_COPY[state])
    }

    const addRow = (task: BatchTask) => {
      const row = stamp(root, '[data-xb-row-template]', HTMLElement)
      part(row, '[data-task]', HTMLElement).textContent = task.name
      part(row, '[data-progress]', HTMLElement).textContent = progressText(0, task.keywords.length, 0)
      rows.prepend(row)
      while (rows.children.length > TABLE_LIMIT) rows.lastElementChild?.remove()
      return row
    }

    const complete = (row: HTMLElement, task: BatchTask) => {
      const badge = part(row, '[data-badge]', HTMLElement)
      badge.classList.add('badge--ok')
      badge.textContent = copyOf(root, 'complete')
      part(row, '[data-progress]', HTMLElement).textContent = fillCopy(copyOf(root, 'progressExported'), {
        done: task.keywords.length - 1,
        total: task.keywords.length
      })
      part(row, '[data-bar]', HTMLElement).style.setProperty('--p', '100%')
      file.textContent = exportFileName(task.rows.reduce((sum, value) => sum + value, 0), task.name, new Date())
    }

    if (reducedMotion()) {
      const task = BATCH_TASKS[0]
      name.textContent = task.name
      area.replaceChildren(
        ...task.keywords.map((keyword, index) => {
          const line = makeLine(keyword)
          setLine(line, index === task.stuck ? 'stuck' : 'done')
          return line
        })
      )
      lines.textContent = lineCount(task.keywords.length)
      const row = addRow(task)
      row.classList.remove('is-new')
      complete(row, task)
      return
    }

    const gate = visibilityGate(root, 0.25)
    const typeInto = async (element: HTMLElement, text: string, speed: number) => {
      element.classList.add('is-typing')
      for (let index = 1; index <= text.length; index++) {
        element.textContent = text.slice(0, index)
        await gate.nap(speed)
      }
      element.classList.remove('is-typing')
    }

    const play = async (task: BatchTask) => {
      await gate.wait()
      name.textContent = ''
      area.replaceChildren()
      lines.textContent = lineCount(0)
      start.classList.add('is-disabled')
      await gate.nap(500)
      await typeInto(name, task.name, 34)
      await gate.nap(250)
      const lineElements: HTMLElement[] = []
      for (const [index, keyword] of task.keywords.entries()) {
        const line = makeLine()
        area.append(line)
        lineElements.push(line)
        await typeInto(part(line, 'span', HTMLElement), keyword, 16)
        lines.textContent = lineCount(index + 1)
      }
      start.classList.remove('is-disabled')
      await gate.nap(450)
      start.classList.add('is-pressed')
      await gate.nap(180)
      start.classList.remove('is-pressed')
      const row = addRow(task)
      const progress = part(row, '[data-progress]', HTMLElement)
      const bar = part(row, '[data-bar]', HTMLElement)
      let done = 0
      let stuck = 0
      for (const [index, line] of lineElements.entries()) {
        setLine(line, 'run')
        await gate.nap(index === task.stuck ? 1500 : 950)
        if (index === task.stuck) {
          setLine(line, 'stuck')
          stuck++
        } else {
          setLine(line, 'done')
          done++
        }
        progress.textContent = progressText(done, lineElements.length, stuck)
        bar.style.setProperty('--p', `${Math.round(((index + 1) / lineElements.length) * 100)}%`)
      }
      // 完成即自动导出（真实插件行为）：框内提示文件名
      complete(row, task)
      await gate.nap(300)
      toast.classList.add('is-on')
      await gate.nap(2600)
      toast.classList.remove('is-on')
      await gate.nap(600)
    }

    void (async () => {
      for (let round = 0; ; round++) await play(BATCH_TASKS[round % BATCH_TASKS.length])
    })()
  }

  const root = document.querySelector<HTMLElement>('[data-xb]')
  if (root) initBatch(root)
</script>

<style>
  .xb {
    overflow: hidden;
  }

  .xb-grid {
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 70% 50%, var(--mask-solid) 15%, transparent 75%);
    mask-image: radial-gradient(ellipse 80% 70% at 70% 50%, var(--mask-solid) 15%, transparent 75%);
  }

  .xb-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(40% 50% at 78% 40%, color-mix(in srgb, var(--primary) 28%, transparent), transparent 70%),
      radial-gradient(30% 40% at 10% 90%, color-mix(in srgb, var(--cyan) 16%, transparent), transparent 70%);
  }

  .xb-layout {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    align-items: center;
    gap: clamp(40px, 6vw, 96px);
  }

  .xb-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .xb-visual {
    position: relative;
  }

  .xb-frame {
    position: relative;
    border-color: var(--border-2);
    box-shadow: var(--shadow-lg), var(--hairline-hl);
  }

  .xb-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    padding: 18px;
  }

  .xb-tabs {
    display: flex;
    gap: 4px;
    justify-self: start;
    max-width: 100%;
    padding: 4px;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    background: var(--surface-3);
    scrollbar-width: none;
  }

  .xb-tabs span {
    padding: 6px 14px;
    border-radius: var(--r-full);
    color: var(--text-3);
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
  }

  .xb-tabs .is-on {
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    color: var(--text);
  }

  .xb-form {
    display: grid;
    gap: 12px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
  }

  .xb-field {
    display: grid;
    gap: 6px;
  }

  .xb-field small {
    display: flex;
    justify-content: space-between;
    color: var(--text-3);
    font-size: 11.5px;
    font-weight: 600;
  }

  .xb-field small em {
    font-size: 11px;
    font-style: normal;
  }

  .xb-input,
  .xb-area {
    min-height: 36px;
    padding: 8px 12px;
    border: 1px solid var(--border-2);
    border-radius: var(--r-sm);
    background: var(--surface-2);
    color: var(--text);
    font-size: 13px;
  }

  .xb-input:empty::before {
    color: var(--text-3);
    content: attr(data-placeholder);
  }

  .xb-area {
    display: grid;
    align-content: start;
    gap: 2px;
    height: 118px;
    overflow: hidden;
    font-family: var(--font-mono);
    font-variant-ligatures: none;
    font-size: 12px;
  }

  .xb-area div {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 20px;
    padding: 0 6px;
    border-radius: var(--r-xs);
    transition: background-color var(--dur-3) var(--ease-out);
  }

  .xb-area em {
    flex-shrink: 0;
    color: var(--text-3);
    font-size: 10.5px;
    font-style: normal;
  }

  .xb-area .is-run {
    background: var(--primary-soft);
  }

  .xb-area .is-run em {
    color: var(--primary-text);
  }

  .xb-area .is-done em {
    color: var(--ok);
  }

  .xb-area .is-stuck em {
    color: var(--warn);
  }

  /* 插件面板里的开始按钮（插画，非站点动作） */
  .xb-start {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 6px;
    height: 32px;
    padding: 0 14px;
    border-radius: var(--r-full);
    background: var(--primary);
    color: var(--primary-fg);
    font-size: 12.5px;
    font-weight: 650;
    transition:
      transform var(--dur-1) var(--ease-out),
      opacity var(--dur-2) var(--ease-out);
  }

  .xb-start :global(.icon) {
    width: 13px;
    height: 13px;
  }

  .xb-start.is-pressed {
    transform: scale(0.95);
  }

  .xb-start.is-disabled {
    opacity: 0.5;
  }

  .xb-table {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--r-md);
    background: var(--surface);
  }

  .xb-th,
  .xb-tr {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) 54px;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
  }

  .xb-th {
    background: var(--surface-2);
    color: var(--text-3);
    font-family: var(--font-mono);
    font-variant-ligatures: none;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .xb-tr {
    border-top: 1px solid var(--border);
    font-size: 12.5px;
  }

  .xb-tr.is-new {
    animation: row-in var(--dur-4) var(--ease-out) both;
  }

  .xb-task {
    overflow: hidden;
    color: var(--text);
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .xb-status {
    display: grid;
    gap: 4px;
  }

  .xb-status > span:first-child {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .xb-status em {
    color: var(--text-3);
    font-size: 11px;
    font-style: normal;
  }

  .xb-status .progress {
    height: 4px;
  }

  .xb-acts {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    color: var(--text-3);
  }

  .xb-acts :global(.icon) {
    width: 14px;
    height: 14px;
  }

  .xb-chip {
    bottom: -64px;
    left: -34px;
  }

  .xb-toast {
    position: absolute;
    right: 16px;
    bottom: 16px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: calc(100% - 32px);
    padding: 12px 14px;
    border: 1px solid var(--border-2);
    border-radius: var(--r-md);
    background: var(--surface);
    box-shadow: var(--shadow-lg);
    opacity: 0;
    transform: translate3d(0, 12px, 0) scale(0.97);
    transition:
      opacity var(--dur-3) var(--ease-out),
      transform var(--dur-3) var(--ease-out);
    pointer-events: none;
  }

  .xb-toast.is-on {
    opacity: 1;
    transform: none;
  }

  .xb-toast-text {
    display: grid;
    min-width: 0;
  }

  .xb-toast-text b {
    color: var(--text);
    font-size: 13px;
  }

  .xb-toast-text small {
    overflow: hidden;
    color: var(--text-3);
    font-size: 11px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 1240px) {
    .xb-chip {
      display: none;
    }
  }

  @media (max-width: 1080px) {
    .xb-layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* 窄屏任务表让出操作列，状态与进度不挤压换行 */
  @media (max-width: 560px) {
    .xb-th,
    .xb-tr {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .xb-th span:last-child,
    .xb-acts {
      display: none;
    }

    .xb-status em {
      white-space: nowrap;
    }
  }
</style>
