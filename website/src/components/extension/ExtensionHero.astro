---
/**
 * 插件页首屏（设计稿 extension.html ①）。
 *
 * 左侧：版本胶囊（指向页内发布说明）、标题、两个安装入口（受 extensionInstall 开关灰化）与信任行。
 * 右侧浏览器剧场循环三组虚构搜索：输入关键词 → 结果列表自动滚动、卡片被捕获 → 面板逐行入列、地图落 pin →
 * Extract complete → 导出到浏览器下载（文件名与插件 export/csv.ts 同格式）。面板三态文案与真实插件面板一致。
 * 剧场离屏 / 后台暂停；减弱动效下直接呈现第一组的完成态。
 */
import type { Locale } from '../../i18n/content'
import type { ExtensionPageContent } from '../../i18n/schema'
import BrandMark from '../site/BrandMark.astro'
import CapabilityAction from '../site/CapabilityAction.astro'
import Icon from '../site/Icon.astro'
import SplitWords from '../site/SplitWords.astro'
import { fillCopy, splitCopy } from '../product/copy'
import StarBar from './StarBar.astro'
import { THEATER_SETS, exportFileName } from './extension-samples'

interface Props {
  locale: Locale
  hero: ExtensionPageContent['hero']
  /** 发布说明里的版本号（胶囊徽章）。 */
  version: string
}

const { locale, hero, version } = Astro.props
const theater = hero.theater
const first = THEATER_SETS[0]
const [extractingBefore, extractingAfter] = splitCopy(theater.extracting, 'count')
const [exportBefore, exportAfter] = splitCopy(theater.exportCta, 'count')
const [closesBefore, closesAfter] = splitCopy(theater.closes, 'time')
const titleParts = [hero.title.lead, { text: hero.title.accent, class: 'accent text-grad is-animated' }, hero.title.tail]
---

<section class="page-hero xh-hero has-deco" data-inview>
  <div class="deco" aria-hidden="true">
    <div class="aurora"><i></i><i></i><i></i></div>
    <div class="bg-contours"></div>
    <div class="bg-grid"></div>
    <div class="noise"></div>
  </div>

  <div class="container page-hero-grid">
    <div class="page-hero-copy">
      <a class="pill-announce" href="#release-notes" data-enter>
        <span class="badge badge--solid">{fillCopy(hero.announce.badge, { version })}</span>
        <span>{hero.announce.text}</span>
        <Icon name="arrow-right" />
      </a>

      <h1 class="h1 xh-title" data-split="static" style="--split-delay: 90ms"><SplitWords parts={titleParts} /></h1>

      <p class="lead" data-enter style="--enter-delay: 180ms">{hero.lead}</p>

      <div class="page-hero-actions" data-enter style="--enter-delay: 270ms">
        <CapabilityAction
          capability="extensionInstall"
          locale={locale}
          href="#install"
          class="btn btn-primary btn-lg"
          data-magnetic="0.2"
          data-cta="extension-hero-edge-install"
        >
          <Icon name="puzzle" />{hero.edgeCta}
        </CapabilityAction>
        <CapabilityAction
          capability="extensionInstall"
          locale={locale}
          href="#install"
          class="btn btn-secondary btn-lg"
          data-cta="extension-hero-browsers-install"
        >
          {hero.browsersCta}
        </CapabilityAction>
      </div>

      <div class="page-hero-meta" data-enter style="--enter-delay: 360ms">
        {hero.meta.map(item => <span><Icon name="check" />{item}</span>)}
      </div>
    </div>

    <div class="page-hero-visual xh" data-reveal="rise" data-reveal-onload="420" data-xh>
      <div class="browser xh-frame">
        <div class="browser-bar">
          <div class="win-dots" aria-hidden="true"><i></i><i></i><i></i></div>
          <div class="browser-url">
            <Icon name="lock" />
            <span data-xh-url></span>
          </div>
          <span class="dl-ring" data-xh-dl aria-hidden="true">
            <svg class="dl-ring-svg" viewBox="0 0 36 36">
              <circle class="dl-ring-track" cx="18" cy="18" r="15"></circle>
              <circle class="dl-ring-fill" cx="18" cy="18" r="15" pathLength="100"></circle>
            </svg>
            <Icon name="download" />
          </span>
          <span class="xh-ext" title={theater.extensionActive} aria-hidden="true">
            <Icon name="puzzle" /><i class="ext-dot"></i>
          </span>
        </div>

        <div class="xh-body">
          <div class="xh-side" aria-hidden="true">
            <div class="xh-search">
              <Icon name="search" />
              <span data-xh-query>{first.query}</span>
            </div>
            <div class="xh-chips">{theater.filters.map(filter => <span>{filter}</span>)}</div>
            <div class="xh-results">
              <div class="xh-track" data-xh-track></div>
            </div>
          </div>

          <div class="xh-map" aria-hidden="true">
            <svg class="xh-map-svg" viewBox="0 0 420 520" preserveAspectRatio="xMidYMid slice">
              <rect class="m-land" width="420" height="520"></rect>
              <g class="m-streets">
                <path d="M40 0V520M92 0V520M144 0V520M196 0V520M248 0V520M300 0V520M352 0V520M404 0V520"></path>
                <path d="M0 36H420M0 84H420M0 132H420M0 228H420M0 276H420M0 324H420M0 420H420M0 468H420"></path>
              </g>
              <path class="m-park" d="M262 300c16-34 82-40 104-12 22 26 8 72-30 84-40 12-90-32-74-72z"></path>
              <path class="m-park" d="M30 404c0-11 9-20 20-20h64c11 0 20 9 20 20v34c0 11-9 20-20 20H50c-11 0-20-9-20-20z"></path>
              <path class="m-water" d="M330 -10C318 70 360 140 344 220C330 290 288 350 300 430C308 480 330 510 324 530H420V-10Z"></path>
              <g class="m-major">
                <path class="casing" d="M-10 180H430"></path>
                <path class="casing" d="M120 -10C132 120 112 260 132 340C150 420 122 480 132 530"></path>
                <path class="road" d="M-10 180H430"></path>
                <path class="road" d="M120 -10C132 120 112 260 132 340C150 420 122 480 132 530"></path>
              </g>
              <g class="m-labels">
                <text x="150" y="172">PIKE ST</text>
                <text x="20" y="372" class="m-label-sm">CAPITOL HILL</text>
                <text x="188" y="262" class="m-label-sm">FIRST HILL</text>
              </g>
            </svg>
            <div class="xh-pins" data-xh-pins></div>
          </div>

          <aside class="mgp xh-panel" data-xh-panel data-state="idle" aria-label={theater.panelLabel}>
            <div class="mgp-head">
              <BrandMark />
              <span class="mgp-title">MapsGrab</span>
              <span class="xh-dock" title={theater.dock} aria-hidden="true"><Icon name="swap" /></span>
            </div>
            <div class="mgp-status">
              <div class="mgp-status-row">
                <span class="xh-state">
                  <span class="xh-state-idle"><span class="mgp-start" data-xh-start><Icon name="play" />{theater.start}</span></span>
                  <span class="xh-state-run"><span class="spinner"></span><span>{extractingBefore}<b data-xh-run>0</b>{extractingAfter}</span></span>
                  <span class="xh-state-done"><Icon name="check-circle" /><span>{theater.complete}</span></span>
                </span>
                <span class="mgp-pause xh-pill">
                  <span class="xh-pill-run"><Icon name="pause" />{theater.pause}</span>
                  <span class="xh-pill-done"><Icon name="refresh" />{theater.reset}</span>
                </span>
              </div>
              <div class="progress"><i data-xh-progress></i></div>
              <div class="mgp-kpis">
                <span><b data-xh-kpi="phones">0</b> {theater.kpis.phones}</span>
                <span><b data-xh-kpi="websites">0</b> {theater.kpis.websites}</span>
                <span><b data-xh-kpi="emails">0</b> {theater.kpis.emails}</span>
              </div>
            </div>
            <div class="mgp-list" data-xh-list></div>
            <div class="mgp-foot">
              <span class="btn btn-primary" data-xh-export>
                <Icon name="download" />
                <span>{exportBefore}<span data-xh-count>0</span>{exportAfter}</span>
              </span>
            </div>
          </aside>
        </div>

        <div class="dl-pop" data-xh-dlpop aria-hidden="true">
          <span class="dl-pop-ic"><Icon name="file-sheet" /></span>
          <span class="dl-pop-text">
            <b data-xh-file>{exportFileName(first.total, first.query, new Date())}</b>
            <small>{theater.saved}</small>
          </span>
          <Icon name="check-circle" class="dl-pop-ok" />
        </div>
      </div>

      <div class="float-chip xh-fc-scroll floaty" style="--float-t: 7s" data-parallax="0.05" aria-hidden="true">
        <span class="icon-tile"><Icon name="refresh" /></span>
        <span><small>{theater.scrollChip.label}</small>{theater.scrollChip.value}</span>
      </div>
      <div class="float-chip xh-fc-dedupe floaty" style="--float-t: 8s; --float-d: -3s" data-parallax="-0.04" aria-hidden="true">
        <span class="icon-tile icon-tile--ok"><Icon name="layers" /></span>
        <span><small>{theater.dedupeChip.label}</small>{theater.dedupeChip.value}</span>
      </div>

      <template data-xh-card-template>
        <div class="xh-card">
          <div class="xh-card-main">
            <span class="xh-card-name" data-name></span>
            <span class="xh-card-rating"><span data-rating></span><StarBar /><span>(<span data-reviews></span>)</span></span>
            <span class="xh-card-meta" data-meta></span>
            <span class="xh-card-open"><b>{theater.open}</b> · {closesBefore}<span data-closes></span>{closesAfter}</span>
          </div>
          <span class="xh-card-thumb" data-thumb></span>
          <span class="xh-card-check"><Icon name="check" /></span>
        </div>
      </template>
      <template data-xh-end-template><div class="xh-end">{theater.endOfList}</div></template>
      <template data-xh-row-template>
        <div class="mgp-row is-new">
          <span class="mgp-avatar" data-avatar></span>
          <div class="xh-row-text"><div class="mgp-name" data-name></div><div class="mgp-meta" data-meta></div></div>
          <span class="rating"><Icon name="star" class="icon--fill" /><span data-rating></span></span>
        </div>
      </template>
      {THEATER_SETS.map((set, index) => <template data-xh-avatar-template={index}><Icon name={set.icon} /></template>)}
      <template data-xh-pin-template><i class="map-pin is-active is-dropped"><span class="pin-ring"></span></i></template>
    </div>
  </div>
</section>

<script>
  import { formatNumber, reducedMotion, visibilityGate } from '../../scripts/site/motion'
  import { part, stamp } from '../../scripts/pages/product-page'
  import { PIN_SPOTS, THEATER_SETS, exportFileName, theaterPhone, type TheaterSet } from './extension-samples'

  /** 与 .xh-card 的固定高度一致：自动滚动按卡片高度推进。 */
  const CARD_HEIGHT = 100
  /** 面板列表最多保留的行数（更早的行滚出面板）。 */
  const LIST_LIMIT = 8
  /** 演示数据的补全比例（虚构）：电话 96%、官网 83%、邮箱 62%。 */
  const KPI_RATIOS = [
    ['phones', 0.96],
    ['websites', 0.83],
    ['emails', 0.62]
  ] as const

  function initTheater(stage: HTMLElement): void {
    const gate = visibilityGate(stage, 0.12)
    const track = part(stage, '[data-xh-track]', HTMLElement)
    const query = part(stage, '[data-xh-query]', HTMLElement)
    const url = part(stage, '[data-xh-url]', HTMLElement)
    const pins = part(stage, '[data-xh-pins]', HTMLElement)
    const panel = part(stage, '[data-xh-panel]', HTMLElement)
    const start = part(stage, '[data-xh-start]', HTMLElement)
    const run = part(stage, '[data-xh-run]', HTMLElement)
    const progress = part(stage, '[data-xh-progress]', HTMLElement)
    const list = part(stage, '[data-xh-list]', HTMLElement)
    const exportButton = part(stage, '[data-xh-export]', HTMLElement)
    const count = part(stage, '[data-xh-count]', HTMLElement)
    const download = part(stage, '[data-xh-dl]', HTMLElement)
    const popup = part(stage, '[data-xh-dlpop]', HTMLElement)
    const file = part(stage, '[data-xh-file]', HTMLElement)
    const kpis = KPI_RATIOS.map(([key, ratio]) => ({ ratio, element: part(stage, `[data-xh-kpi="${key}"]`, HTMLElement) }))

    const fill = (root: Element, key: string, text: string) => {
      part(root, `[data-${key}]`, HTMLElement).textContent = text
    }

    const buildCards = (set: TheaterSet) => {
      track.replaceChildren(
        ...set.items.map(([name, rating, reviews, address, closes, tone]) => {
          const card = stamp(stage, '[data-xh-card-template]', HTMLElement)
          fill(card, 'name', name)
          fill(card, 'rating', rating.toFixed(1))
          fill(card, 'reviews', formatNumber(reviews))
          fill(card, 'meta', `${set.category} · ${address}`)
          fill(card, 'closes', closes)
          part(card, '.star-bar', HTMLElement).style.setProperty('--r', String(rating))
          part(card, '[data-thumb]', HTMLElement).style.setProperty('--tone', `var(--${tone})`)
          return card
        }),
        stamp(stage, '[data-xh-end-template]', HTMLElement)
      )
    }

    const scrollTo = (offset: number, animate = true) => {
      const viewport = track.parentElement?.clientHeight ?? 0
      const max = Math.max(0, track.scrollHeight - viewport)
      track.classList.toggle('is-scrolling', animate)
      track.style.transform = `translate3d(0, ${-Math.min(offset, max)}px, 0)`
    }

    const setCount = (value: number) => {
      kpis.forEach(({ ratio, element }) => {
        element.textContent = String(Math.round(value * ratio))
      })
      count.textContent = String(value)
      run.textContent = String(value)
    }

    const addRow = (set: TheaterSet, index: number) => {
      const [name, rating] = set.items[index]
      const row = stamp(stage, '[data-xh-row-template]', HTMLElement)
      part(row, '[data-avatar]', HTMLElement).append(stamp(stage, `[data-xh-avatar-template="${THEATER_SETS.indexOf(set)}"]`, SVGSVGElement))
      fill(row, 'name', name)
      fill(row, 'meta', `${set.category} · ${theaterPhone(set, index)}`)
      fill(row, 'rating', rating.toFixed(1))
      list.prepend(row)
      while (list.children.length > LIST_LIMIT) list.lastElementChild?.remove()
      return row
    }

    const dropPin = (index: number, instant: boolean) => {
      const [x, y] = PIN_SPOTS[index % PIN_SPOTS.length]
      const pin = stamp(stage, '[data-xh-pin-template]', HTMLElement)
      pin.style.setProperty('--x', `${x}%`)
      pin.style.setProperty('--y', `${y}%`)
      if (instant) {
        pin.classList.remove('is-dropped')
        pin.replaceChildren()
      }
      pins.append(pin)
    }

    const reset = (set: TheaterSet) => {
      buildCards(set)
      scrollTo(0, false)
      list.replaceChildren()
      pins.replaceChildren()
      progress.style.setProperty('--p', '0%')
      setCount(0)
      panel.dataset.state = 'idle'
      start.classList.remove('is-pressed')
      exportButton.classList.remove('is-ready', 'is-pressed')
      download.classList.remove('is-on', 'is-done')
      popup.classList.remove('is-on')
      query.textContent = set.query
      url.textContent = `google.com/maps/search/${set.query.toLowerCase().replace(/ /g, '+')}`
    }

    const finish = (set: TheaterSet) => {
      panel.dataset.state = 'done'
      progress.style.setProperty('--p', '100%')
      setCount(set.total)
      file.textContent = exportFileName(set.total, set.query, new Date())
    }

    const typeQuery = async (text: string) => {
      query.textContent = ''
      query.classList.add('is-typing')
      for (let index = 1; index <= text.length; index++) {
        query.textContent = text.slice(0, index)
        await gate.nap(38 + Math.random() * 40)
      }
      query.classList.remove('is-typing')
    }

    const play = async (set: TheaterSet) => {
      await gate.wait()
      reset(set)
      await typeQuery(set.query)
      await gate.nap(500)
      start.classList.add('is-pressed')
      await gate.nap(320)
      panel.dataset.state = 'run'
      const cards = Array.from(track.querySelectorAll('.xh-card'))
      for (const [index, card] of cards.entries()) {
        card.classList.add('is-captured')
        const row = addRow(set, index)
        window.setTimeout(() => row.classList.remove('is-new'), 900)
        dropPin(index, false)
        setCount(Math.round((set.total * (index + 1)) / cards.length))
        progress.style.setProperty('--p', `${Math.round(((index + 1) / cards.length) * 100)}%`)
        await gate.nap(560)
        // 保持当前捕获项在列表上部；到底时露出列表结束提示
        if (index >= 1) scrollTo((index - 0.4) * CARD_HEIGHT)
        await gate.nap(260)
      }
      scrollTo(Number.MAX_SAFE_INTEGER)
      finish(set)
      exportButton.classList.add('is-ready')
      await gate.nap(1300)
      exportButton.classList.replace('is-ready', 'is-pressed')
      await gate.nap(160)
      exportButton.classList.remove('is-pressed')
      download.classList.add('is-on')
      await gate.nap(60)
      download.classList.add('is-done')
      await gate.nap(900)
      popup.classList.add('is-on')
      await gate.nap(2800)
      popup.classList.remove('is-on')
      pins.querySelectorAll('.map-pin').forEach(pin => pin.classList.add('is-leaving'))
      await gate.nap(700)
    }

    if (reducedMotion()) {
      const set = THEATER_SETS[0]
      reset(set)
      track.querySelectorAll('.xh-card').forEach(card => card.classList.add('is-captured'))
      for (let index = LIST_LIMIT - 2; index >= 0; index--) addRow(set, index).classList.remove('is-new')
      set.items.forEach((_, index) => dropPin(index, true))
      scrollTo(Number.MAX_SAFE_INTEGER, false)
      finish(set)
      return
    }

    reset(THEATER_SETS[0])
    void (async () => {
      for (let round = 0; ; round++) await play(THEATER_SETS[round % THEATER_SETS.length])
    })()
  }

  const stage = document.querySelector<HTMLElement>('[data-xh]')
  if (stage) initTheater(stage)
</script>

<style>
  .xh-hero {
    --hero-cols: minmax(0, 0.9fr) minmax(0, 1.1fr);
    padding-bottom: clamp(64px, 8vw, 128px);
  }

  .xh-title {
    font-size: clamp(2.5rem, 1.45rem + 3.2vw, 4.15rem);
  }

  .xh {
    position: relative;
  }

  .xh-frame {
    position: relative;
    z-index: 2;
    box-shadow: var(--shadow-lg), var(--glow-soft);
  }

  .xh-frame .browser-url {
    max-width: 340px;
  }

  .xh-frame .dl-pop {
    right: 46px;
    width: 286px;
    transform-origin: 85% 0;
  }

  .xh-ext {
    position: relative;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    color: var(--primary-text);
  }

  .xh-ext :global(.icon) {
    width: 17px;
    height: 17px;
  }

  .xh-body {
    position: relative;
    display: grid;
    grid-template-columns: 214px minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    height: 456px;
    overflow: hidden;
  }

  /* Maps 结果侧栏 */
  .xh-side {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-width: 0;
    border-right: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
  }

  .xh-search {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    margin: 12px 12px 8px;
    padding: 0 14px;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    color: var(--text);
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
  }

  .xh-search :global(.icon) {
    width: 15px;
    height: 15px;
    color: var(--text-3);
  }

  .xh-search span {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .xh-chips {
    display: flex;
    gap: 6px;
    padding: 0 12px 10px;
    border-bottom: 1px solid var(--border);
  }

  .xh-chips span {
    display: flex;
    align-items: center;
    height: 24px;
    padding: 0 10px;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    color: var(--text-2);
    font-size: 11px;
    font-weight: 500;
    white-space: nowrap;
  }

  .xh-results {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(180deg, var(--mask-solid) 82%, transparent);
    mask-image: linear-gradient(180deg, var(--mask-solid) 82%, transparent);
  }

  .xh-track {
    will-change: transform;
  }

  .xh-track.is-scrolling {
    transition: transform var(--dur-4) var(--ease-out);
  }

  .xh-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 46px;
    align-items: start;
    gap: 10px;
    height: 100px;
    padding: 10px 12px 10px 14px;
    border-bottom: 1px solid var(--border);
    line-height: 1.4;
    transition: background-color var(--dur-4) var(--ease-out);
  }

  .xh-card::before {
    position: absolute;
    inset: 10px auto 10px 0;
    width: 3px;
    border-radius: 0 var(--r-2xs) var(--r-2xs) 0;
    background: var(--primary);
    transform: scaleY(0);
    transition: transform var(--dur-3) var(--ease-out);
    content: '';
  }

  .xh-card.is-captured {
    background: linear-gradient(90deg, var(--primary-soft), transparent 85%);
  }

  .xh-card.is-captured::before {
    transform: none;
  }

  .xh-card-main {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .xh-card-name {
    overflow: hidden;
    color: var(--text);
    font-size: 13px;
    font-weight: 650;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .xh-card-rating {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--text-2);
    font-size: 11.5px;
    font-variant-numeric: tabular-nums;
  }

  .xh-card-meta,
  .xh-card-open {
    overflow: hidden;
