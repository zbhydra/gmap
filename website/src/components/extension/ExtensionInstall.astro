---
/**
 * 插件页安装区（设计稿 extension.html ⑦，页内锚点 #install）与发布说明（#release-notes，承接 changelog 职能）。
 *
 * 商店按钮与 release zip 下载都受 extensionInstall 开关控制：未交付时灰化为 Coming soon，不带链接与埋点。
 * 分浏览器步骤用站级 [data-tabs] 分段切换，截图未产出前用 .media-slot 占位；帮助入口始终可用。
 */
import type { Locale } from '../../i18n/content'
import type { ExtensionPageContent } from '../../i18n/schema'
import { localePaths } from '../../i18n/ui'
import CapabilityAction from '../site/CapabilityAction.astro'
import Icon from '../site/Icon.astro'
import { fillCopy } from '../product/copy'
import ProductSectionHead from '../product/ProductSectionHead.astro'

interface Props {
  locale: Locale
  install: ExtensionPageContent['install']
}

const { locale, install } = Astro.props
const prefix = localePaths[locale] ? `/${localePaths[locale]}` : ''
// 商店与 release 资产链接：上架 / 发版后回填；开关关闭期间按钮灰化，不会渲染这些链接。
const EDGE_STORE_URL_PLACEHOLDER = '#'
const FIREFOX_STORE_URL_PLACEHOLDER = '#'
const RELEASE_ZIP_URL_PLACEHOLDER = '#'
const STORE_URLS = { edge: EDGE_STORE_URL_PLACEHOLDER, firefox: FIREFOX_STORE_URL_PLACEHOLDER }
// 商店品牌标未取官方素材前用通用图标（README §11）
const STORE_ICONS = { edge: 'window', firefox: 'globe' }
const CHANNEL_ICONS = { chromium: 'window', firefox: 'globe' }
const { notes } = install
---

<section class="section xi band" id="install">
  <div class="container">
    <ProductSectionHead head={install.head} />

    <div class="xi-stack">
      <div class="xi-top" data-stagger="90" data-spotlight-group>
        {install.stores.map(store => (
          <article class="xi-store card" data-spotlight data-reveal>
            <span class={`xi-logo xi-logo--${store.id}`} aria-hidden="true"><Icon name={STORE_ICONS[store.id]} /></span>
            <div class="xi-store-text">
              <b>{store.name}</b>
              <span>{store.store}</span>
            </div>
            <p>{store.note}</p>
            <CapabilityAction
              capability="extensionInstall"
              locale={locale}
              href={STORE_URLS[store.id]}
              class="btn btn-secondary btn-sm"
              target="_blank"
              rel="noopener"
              data-cta={`extension-store-${store.id}`}
            >
              {store.cta}<Icon name="external" />
            </CapabilityAction>
          </article>
        ))}

        <article class="xi-zip card has-deco" data-spotlight data-reveal>
          <div class="deco" aria-hidden="true"><div class="bg-grid xi-zip-grid"></div></div>
          <span class="icon-tile icon-tile--brand"><Icon name="archive" /></span>
          <div>
            <b>{install.zip.title}</b>
            <p>{install.zip.description}</p>
          </div>
          <CapabilityAction
            capability="extensionInstall"
            locale={locale}
            href={RELEASE_ZIP_URL_PLACEHOLDER}
            class="btn btn-primary"
            data-cta="extension-install-zip"
          >
            <Icon name="download" />{install.zip.button}
          </CapabilityAction>
          <span class="xi-zip-meta mono">{fillCopy(install.zip.meta, { version: notes.version })}</span>
        </article>
      </div>

      <div class="xi-main card" data-tabs data-reveal data-xi>
        <div class="xi-main-head">
          <div class="seg" role="tablist" aria-label={install.browserLabel}>
            <span class="seg-thumb" aria-hidden="true"></span>
            {install.channels.map((channel, index) => (
              <button
                class="seg-btn"
                type="button"
                role="tab"
                id={`xi-tab-${channel.id}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls={`xi-${channel.id}`}
                data-tab={channel.id}
                data-note={channel.note}
              >
                <Icon name={CHANNEL_ICONS[channel.id]} />{channel.tab}
              </button>
            ))}
          </div>
          <span class="xi-main-note" data-xi-note>{install.channels[0].note}</span>
        </div>

        {install.channels.map((channel, index) => (
          <div id={`xi-${channel.id}`} role="tabpanel" aria-labelledby={`xi-tab-${channel.id}`} hidden={index !== 0}>
            <ol class="xi-steps" role="list" style={`--n: ${channel.steps.length}`}>
              {channel.steps.map((step, stepIndex) => (
                <li class="xi-step">
                  <div class="media-slot xi-shot" style="--ratio: 16 / 10">
                    <div class="media-slot-label">
                      <span class="media-slot-kicker">{install.shotKicker}</span>
                      <span class="media-slot-text">{step.shot}</span>
                    </div>
                  </div>
                  <span class="xi-num mono">{String(stepIndex + 1).padStart(2, '0')}</span>
                  <div class="xi-step-text">
                    <b>{step.title}</b>
                    <p>{step.description.map(part => (typeof part === 'string' ? part : <code>{part.code}</code>))}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))}

        <div class="xi-help">
          <Icon name="info" />
          <span><b>{install.help.title}</b> {install.help.description}</span>
          <a class="link-arrow" href={`${prefix}/contact/`} data-cta="extension-install-help">
            {install.help.cta}<Icon name="arrow-right" />
          </a>
        </div>
      </div>
    </div>

    <article class="xi-notes card" id="release-notes" data-release={notes.version} data-reveal>
      <div class="xi-notes-head">
        <span class="kicker">{notes.kicker}</span>
        <div class="xi-notes-ver"><b>{notes.version}</b><span class="badge badge--muted">{notes.status}</span><span class="mono">{notes.date}</span></div>
      </div>
      <ul class="check-list check-list--sm xi-notes-list" role="list">
        {notes.items.map(item => <li>{item}</li>)}
      </ul>
    </article>
  </div>
</section>

<script>
  import { copyOf, part } from '../../scripts/pages/product-page'

  // 切换浏览器时同步说明文字（站级 [data-tabs] 切换后派发 tabchange）
  const tabs = document.querySelector<HTMLElement>('[data-xi]')
  if (tabs) {
    const note = part(tabs, '[data-xi-note]', HTMLElement)
    tabs.addEventListener('tabchange', () => {
      note.textContent = copyOf(part(tabs, '[role="tab"][aria-selected="true"]', HTMLElement), 'note')
    })
  }
</script>

<style>
  .xi-stack {
    display: grid;
    gap: 20px;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .xi-top {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  .xi-store {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    align-content: start;
    align-items: center;
    gap: 14px;
    padding: 22px;
  }

  .xi-store p {
    grid-column: 1 / -1;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.55;
  }

  .xi-store :global(.btn) {
    grid-column: 1 / -1;
    justify-self: start;
  }

  .xi-store-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .xi-store-text b {
    color: var(--text);
    font-size: 16px;
    font-weight: 650;
  }

  .xi-store-text span {
    color: var(--text-3);
    font-size: 13px;
  }

  .xi-logo {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--r-sm);
    box-shadow: var(--shadow-sm);
    color: var(--primary-fg);
  }

  .xi-logo :global(.icon) {
    width: 22px;
    height: 22px;
  }

  .xi-logo--edge {
    background: var(--grad-brand);
  }

  .xi-logo--firefox {
    background: var(--grad-warm);
  }

  .xi-zip {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 22px;
    background:
      radial-gradient(90% 80% at 100% 0%, var(--primary-soft), transparent 70%),
      var(--surface);
  }

  .xi-zip-grid {
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 100% 0%, var(--mask-solid) 10%, transparent 70%);
    mask-image: radial-gradient(ellipse 70% 80% at 100% 0%, var(--mask-solid) 10%, transparent 70%);
  }

  .xi-zip b {
    color: var(--text);
    font-size: 16px;
    font-weight: 650;
  }

  .xi-zip p {
    margin-top: 4px;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.55;
  }

  .xi-zip :global(.btn) {
    justify-self: start;
  }

  .xi-zip-meta {
    color: var(--text-3);
    font-size: 11.5px;
  }

  .xi-main {
    padding: clamp(20px, 2.6vw, 32px);
  }

  .xi-main-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
  }

  .xi-main-note {
    color: var(--text-3);
    font-size: 13.5px;
  }

  .xi-steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr));
    gap: 20px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .xi-step {
    position: relative;
    display: grid;
    grid-template-columns: 34px minmax(0, 1fr);
    align-content: start;
    gap: 14px 12px;
  }

  .xi-shot {
    grid-column: 1 / -1;
    border-radius: var(--r-md);
  }

  .xi-shot .media-slot-label {
    gap: 6px;
    padding: 16px;
  }

  .xi-shot .media-slot-text {
    font-size: 12.5px;
  }

  .xi-num {
    position: relative;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--primary-soft);
    color: var(--primary-text);
    font-size: 12px;
    font-weight: 600;
  }

  .xi-step-text b {
    display: block;
    color: var(--text);
    font-size: 15.5px;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .xi-step-text p {
    margin-top: 4px;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.55;
  }

  .xi-step-text code {
    padding: 2px 6px;
    border-radius: var(--r-xs);
    background: var(--surface-2);
    color: var(--text);
    font-family: var(--font-mono);
    font-variant-ligatures: none;
    font-size: 0.86em;
  }

  .xi-help {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    margin-top: 24px;
    padding: 14px 18px;
    border-radius: var(--r-md);
    background: var(--surface-2);
    color: var(--text-2);
    font-size: 14px;
  }

  .xi-help > :global(.icon) {
    width: 18px;
    height: 18px;
    color: var(--primary-text);
  }

  .xi-help b {
    color: var(--text);
  }

  .xi-help .link-arrow {
    margin-left: auto;
    font-size: 14px;
  }

  .xi-notes {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: 24px 40px;
    margin-top: 20px;
    padding: clamp(22px, 2.6vw, 32px);
  }

  .xi-notes-head {
    display: grid;
    align-content: start;
    gap: 14px;
  }

  .xi-notes-ver {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: var(--text-3);
    font-size: 13px;
  }

  .xi-notes-ver b {
    color: var(--text);
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .xi-notes-list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 24px;
  }

  @media (max-width: 1080px) {
    .xi-top {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .xi-zip {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 960px) {
    .xi-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .xi-notes {
      grid-template-columns: minmax(0, 1fr);
    }

    .xi-top {
      grid-template-columns: minmax(0, 1fr);
    }

    .xi-notes-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .xi-steps {
      grid-template-columns: minmax(0, 1fr);
    }

    .xi-help .link-arrow {
      margin-left: 0;
    }

    .xi-shot {
      aspect-ratio: 2 / 1;
    }
  }
</style>
