---
/**
 * 云端页三种创建模式（设计稿 online-scraper.html ④，可交互）：
 * - 关键词：逐行输入，去首尾空白、去空行、按出现顺序去重后计数（同 Dashboard）；旁列各档每任务关键词上限。
 * - 地图：中心 + 半径 + 网格间距，取点直接调用 Dashboard 的 gridViewports（由近及远出点）；
 *   关键词数 × 点数超过 50 时显示 Dashboard 同款报错、禁用提交、不画采样点，不截断。
 * - 地区：国家 / 州 / 城市 → In / Near → 生成「{base} {in|near} {地点}」查询，附 GeoNames 署名。
 * 自动演示只在面板可见时推进，访客一操作滑杆或按钮就停；减弱动效下各面板直接呈现终态。
 * 与 Dashboard 相同的界面文案取 dashboard.create 段；演示只改本区块的 mock 状态，不发请求。
 * 计数文案放 data-count-label：data-count 是站级数字滚动的声明式属性，会改写元素内容。
 */
import type { DashboardContent, OnlineScraperPageContent, PricingPlanCardMessage } from '../../i18n/schema'
import Icon from '../site/Icon.astro'
import ProductSectionHead from '../product/ProductSectionHead.astro'
import { fillCopy, splitCopy } from '../product/copy'
import { DEMO_PLAN, MAP_DEMO, MAP_SAMPLE_LIMIT, REGION_DEMO, keywordLimitOf, mapGridSteps } from './online-samples'

interface Props {
  modes: OnlineScraperPageContent['modes']
  create: DashboardContent['create']
  /** Online 档位卡（pricing.ts），用于各档每任务关键词上限条。 */
  plans: readonly PricingPlanCardMessage[]
}

const { modes, create, plans } = Astro.props
const { map, region } = create
const TABS = [
  { id: 'keywords', icon: 'list' },
  { id: 'map', icon: 'map' },
  { id: 'regions', icon: 'globe' }
] as const
/** 默认展示地图模式（三种里最需要演示的一种）。 */
const DEFAULT_TAB = 'map'
const keywordCount = (count: number) => fillCopy(create.count, { count, limit: DEMO_PLAN.keywordLimit })
const limitBars = plans.map(plan => ({ name: plan.name, limit: keywordLimitOf(plan.id), featured: plan.featured }))
const maxLimit = Math.max(...limitBars.map(bar => bar.limit))
const mapPoints = mapGridSteps(MAP_DEMO.radius.value, MAP_DEMO.spacing.value).length
const mapCount = MAP_DEMO.keywords.length * mapPoints
const [sampleBefore, sampleAfter] = splitCopy(fillCopy(map.sampleCount, { limit: MAP_SAMPLE_LIMIT }), 'count')
const [formulaBefore, formulaAfter] = splitCopy(fillCopy(modes.map.formula, { keywords: MAP_DEMO.keywords.length }), 'points')
const center = `${MAP_DEMO.center.lat.toFixed(4)}, ${MAP_DEMO.center.lng.toFixed(4)}`
---

<section class="section om-sec" id="modes" data-inview>
  <div class="container">
    <ProductSectionHead head={modes.head} />

    <div class="om card" data-tabs data-reveal="zoom" data-om>
      <div class="om-head">
        <div class="seg" role="tablist" aria-label={modes.tabsLabel}>
          <span class="seg-thumb" aria-hidden="true"></span>
          {TABS.map(tab => (
            <button
              class="seg-btn"
              type="button"
              role="tab"
              id={`om-tab-${tab.id}`}
              aria-selected={tab.id === DEFAULT_TAB ? 'true' : 'false'}
              aria-controls={`om-${tab.id}`}
              data-tab={tab.id}
              data-note={modes.notes[tab.id]}
            >
              <Icon name={tab.icon} />{create.modes[tab.id]}
            </button>
          ))}
        </div>
        <span class="om-note" data-om-note>{modes.notes[DEFAULT_TAB]}</span>
      </div>

      <!-- 关键词：去空行与重复后计数，套餐关键词上限 -->
      <div
        class="om-panel om-kw"
        id="om-keywords"
        role="tabpanel"
        aria-labelledby="om-tab-keywords"
        data-omk
        data-count-label={create.count}
        data-blank={modes.keywords.blank}
        data-duplicate={modes.keywords.duplicate}
        hidden
      >
        <div class="om-box">
          <div class="om-label"><b>{create.keywords}</b><span class="mono" data-omk-count>{keywordCount(0)}</span></div>
          <ol class="om-lines mono" data-omk-lines></ol>
          <p class="om-hint">{modes.keywords.hint}</p>
        </div>
        <div class="om-box">
          <div class="om-label"><b>{modes.keywords.limitsTitle}</b><span>{modes.keywords.limitsCaption}</span></div>
          <ul class="om-bars" role="list">
            {limitBars.map((bar, index) => (
              <li class:list={{ 'is-on': bar.featured }} style={`--v: ${bar.limit / maxLimit}; --i: ${index}`}>
                <span>{bar.name}</span><i><s></s></i><b class="mono">{bar.limit}</b>
              </li>
            ))}
          </ul>
          <p class="om-hint">{modes.keywords.limitsHint}</p>
        </div>
      </div>

      <!-- 地图：中心 + 半径 + 网格间距 → 由近及远的采样点；关键词数 × 点数 ≤ 50，超限阻止不截断 -->
      <div class="om-panel om-mp" id="om-map" role="tabpanel" aria-labelledby="om-tab-map" data-omm data-scale={modes.map.scale}>
        <div class="om-stage" aria-hidden="true">
          <svg class="om-map-svg" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
            <defs>
              <pattern id="om-streets" width="38" height="38" patternUnits="userSpaceOnUse">
                <path d="M0 0.8H38M0.8 0V38"></path>
              </pattern>
            </defs>
            <g class="om-art" data-omm-art>
              <rect class="m-land" x="-1600" y="-1600" width="3600" height="3600"></rect>
              <rect x="-1600" y="-1600" width="3600" height="3600" fill="url(#om-streets)"></rect>
              <path class="m-water" d="M-1600 300C-400 240 -120 330 60 296C210 268 300 330 420 312C700 270 1200 360 2000 300V2000H-1600Z"></path>
              <path class="m-park" d="M226 120c24-30 90-26 106 10 14 30-8 66-44 70-38 4-82-48-62-80z"></path>
              <path class="m-park" d="M44 168c0-12 10-22 22-22h70c12 0 22 10 22 22v40c0 12-10 22-22 22H66c-12 0-22-10-22-22z"></path>
              <path class="m-park" d="M-420 -260c40-60 180-50 210 20 26 60-20 120-90 126-80 6-160-80-120-146z"></path>
              <path class="m-park" d="M560 -120c30-40 140-36 160 18 18 46-14 96-74 100-66 4-122-70-86-118z"></path>
              <g class="m-major">
                <path class="casing" d="M-1600 214H2000"></path>
                <path class="casing" d="M184 -1600C196 -400 170 0 196 200C214 340 188 520 200 2000"></path>
                <path class="casing" d="M-1600 -380L2000 520"></path>
                <path class="road" d="M-1600 214H2000"></path>
                <path class="road" d="M184 -1600C196 -400 170 0 196 200C214 340 188 520 200 2000"></path>
                <path class="road" d="M-1600 -380L2000 520"></path>
              </g>
              <g class="m-labels">
                <text x="232" y="238">BURNSIDE</text>
                <text x="58" y="140" class="m-label-sm">PEARL DISTRICT</text>
                <text x="236" y="102" class="m-label-sm">IRVINGTON</text>
                <text x="70" y="352" class="m-label-sm">WILLAMETTE</text>
              </g>
            </g>
          </svg>
          <svg class="om-grid" viewBox="0 0 400 400">
            <circle class="om-scan" data-omm-scan cx="200" cy="200" r="150"></circle>
            <circle class="om-cover" data-omm-cover cx="200" cy="200" r="150"></circle>
            <g data-omm-dots></g>
            <circle class="om-center-ring" cx="200" cy="200" r="11"></circle>
            <circle class="om-center" cx="200" cy="200" r="6.5"></circle>
          </svg>
          <span class="om-scale mono"><i data-omm-scale></i><span data-omm-scale-label></span></span>
          <span class="om-pin-tag mono"><Icon name="locate" />{center}</span>
        </div>

        <div class="om-side">
          <div class="om-label"><b>{create.keywords}</b><span class="mono">{keywordCount(MAP_DEMO.keywords.length)}</span></div>
          <div class="om-chips-static mono">{MAP_DEMO.keywords.map(keyword => <span>{keyword}</span>)}</div>
          <div class="om-coords">
            <span><small>{map.latitude}</small><b class="mono">{MAP_DEMO.center.lat.toFixed(4)}</b></span>
            <span><small>{map.longitude}</small><b class="mono">{MAP_DEMO.center.lng.toFixed(4)}</b></span>
          </div>
          <label class="om-range">
            <span>{map.radius}</span><b class="mono" data-omm-radius-value>{MAP_DEMO.radius.value}</b>
            <input
              type="range"
              min={MAP_DEMO.radius.min}
              max={MAP_DEMO.radius.max}
              step="1"
              value={MAP_DEMO.radius.value}
              aria-label={map.radius}
              data-omm-radius
            />
          </label>
          <label class="om-range">
            <span>{map.spacing}</span><b class="mono" data-omm-spacing-value>{MAP_DEMO.spacing.value}</b>
            <input
              type="range"
              min={MAP_DEMO.spacing.min}
              max={MAP_DEMO.spacing.max}
              step="1"
              value={MAP_DEMO.spacing.value}
              aria-label={map.spacing}
              data-omm-spacing
            />
          </label>
          <div class="om-readout" data-omm-readout>
            <b>{sampleBefore}<span class="mono" data-omm-count>{mapCount}</span>{sampleAfter}</b>
            <small>{formulaBefore}<span data-omm-points>{mapPoints}</span>{formulaAfter}</small>
            <span class="om-meter"><i data-omm-meter style={`--p: ${Math.min(1, mapCount / MAP_SAMPLE_LIMIT)}`}></i></span>
          </div>
          <p class="om-error" data-omm-error hidden>
            <Icon name="info" />{fillCopy(map.overLimit, { limit: MAP_SAMPLE_LIMIT })}
          </p>
          <div class="om-submit" aria-hidden="true">
            <span class="btn btn-primary btn-sm" data-omm-submit>{create.submit}</span>
          </div>
          <ul class="om-facts" role="list">
            {modes.map.facts.map(fact => <li>{fact}</li>)}
          </ul>
        </div>
        <template data-omm-dot-template><svg><circle class="om-dot" r="4.5"></circle></svg></template>
      </div>

      <!-- 地区：GeoNames 国家 / 州 / 城市 → In / Near → 可编辑的最终查询 -->
      <div
        class="om-panel om-rg"
        id="om-regions"
        role="tabpanel"
        aria-labelledby="om-tab-regions"
        data-omr
        data-count-label={create.count}
        data-remove={region.remove}
        hidden
      >
        <div class="om-box">
          <div class="om-label"><b>{region.baseKeywords}</b></div>
          <div class="om-chips-static mono">{REGION_DEMO.bases.map(base => <span>{base}</span>)}</div>
          <div class="om-selects">
            <span class="om-select"><small>{region.country}</small><b>{REGION_DEMO.country}</b><Icon name="chevron-down" /></span>
            <span class="om-select"><small>{region.state}</small><b>{REGION_DEMO.state}</b><Icon name="chevron-down" /></span>
            <span class="om-select"><small>{region.city}</small><b data-omr-next>{REGION_DEMO.cities[0]}</b><Icon name="chevron-down" /></span>
            <button class="btn btn-secondary btn-sm om-add" type="button" data-omr-add>
              <Icon name="plus" />{modes.regions.addCity}
            </button>
          </div>
          <div class="om-label"><b>{region.selectedRegions}</b></div>
          <div class="om-places" data-omr-places></div>
          <div class="om-phrasing">
            <span id="om-phrasing-label">{region.matchMode}</span>
            <span class="om-toggle" role="group" aria-labelledby="om-phrasing-label">
              <button type="button" aria-pressed="true" data-omr-mode="in">{region.inMode}</button>
              <button type="button" aria-pressed="false" data-omr-mode="near">{region.nearMode}</button>
            </span>
            <button class="btn btn-primary btn-sm om-generate" type="button" data-omr-generate>
              <Icon name="sparkles" />{region.generate}
            </button>
          </div>
        </div>
        <div class="om-box om-final">
          <div class="om-label"><b>{region.finalQueries}</b><span class="mono" data-omr-count>{keywordCount(0)}</span></div>
          <ol class="om-queries mono" data-omr-queries></ol>
          <p class="om-error" data-omr-error hidden>
            <Icon name="info" />{fillCopy(create.invalid, { limit: DEMO_PLAN.keywordLimit })}
          </p>
          <p class="om-hint">{modes.regions.hint}</p>
          <p class="om-attr">{region.attribution}</p>
        </div>
        <template data-omr-place-template>
          <span class="om-place"><span data-name></span><button type="button" data-remove><Icon name="x" /></button></span>
        </template>
        <template data-omr-query-template><li><span></span></li></template>
      </div>

      <template data-omk-line-template><li class="is-new"><span></span><em></em></li></template>
    </div>
  </div>
</section>

<script>
  import { reducedMotion, visibilityGate, wait } from '../../scripts/site/motion'
  import { copyOf, part, stamp } from '../../scripts/pages/product-page'
  import { fillCopy } from '../product/copy'
  import {
    DEMO_PLAN,
    KEYWORD_DEMO_LINES,
    MAP_DEMO,
    MAP_SAMPLE_LIMIT,
    REGION_DEMO,
    judgeKeywordLines,
    mapGridSteps,
    regionPlace,
    regionQueries,
    type RegionPhrasing
  } from './online-samples'

  /** 比例尺候选（公里），取落在 110 屏幕像素以内的最大值。 */
  const SCALE_STEPS_KM = [1, 2, 5, 10, 20, 50]
  const SCALE_MAX_PX = 110
  /** 插画坐标：400 × 400 视口，中心 (200, 200)，半径 ≥ 3 km 时覆盖圆固定 150 个单位。 */
  const VIEW = 400
  const CENTER = 200
  const COVER = 150

  function initModes(root: HTMLElement): void {
    const reduced = reducedMotion()
    const gate = visibilityGate(root, 0.2)
    const note = part(root, '[data-om-note]', HTMLElement)
    const panelListeners: Array<(key: string) => void> = []

    // 面板可见（所在 tab 被选中）且区块在视口内时才推进演示
    const panelShown = (panel: HTMLElement) =>
      new Promise<void>(resolve => {
        const check = () => {
          if (panel.hidden) return
          root.removeEventListener('tabchange', check)
          resolve()
        }
        root.addEventListener('tabchange', check)
        check()
      })
    const waitPanel = async (panel: HTMLElement) => {
      for (;;) {
        await gate.wait()
        if (!panel.hidden) return
        await panelShown(panel)
      }
    }

    root.addEventListener('tabchange', () => {
      const selected = part(root, '[role="tab"][aria-selected="true"]', HTMLElement)
      note.textContent = copyOf(selected, 'note')
      panelListeners.forEach(listener => listener(copyOf(selected, 'tab')))
    })

    const press = async (button: HTMLElement) => {
      button.classList.add('is-pressed')
      await wait(150)
      button.classList.remove('is-pressed')
    }

    /* ---------- 关键词：逐行输入，判定去留后计数 ---------- */
    const keywordPanel = part(root, '[data-omk]', HTMLElement)
    const keywordLines = part(keywordPanel, '[data-omk-lines]', HTMLElement)
    const keywordCount = part(keywordPanel, '[data-omk-count]', HTMLElement)
    const keywordCountCopy = copyOf(keywordPanel, 'countLabel')
    const skipCopy = { blank: copyOf(keywordPanel, 'blank'), duplicate: copyOf(keywordPanel, 'duplicate') }
    let keywordRun = 0

    const playKeywords = async () => {
      const run = ++keywordRun
      keywordLines.replaceChildren()
      keywordCount.textContent = fillCopy(keywordCountCopy, { count: 0, limit: DEMO_PLAN.keywordLimit })
      for (const line of judgeKeywordLines(KEYWORD_DEMO_LINES)) {
        if (!reduced) await waitPanel(keywordPanel)
        if (run !== keywordRun) return
        const item = stamp(root, '[data-omk-line-template]', HTMLLIElement)
        part(item, 'span', HTMLElement).textContent = line.text
        keywordLines.append(item)
        if (!reduced) await wait(380)
        if (run !== keywordRun) return
        if (line.skip) {
          item.classList.add('is-skip')
          part(item, 'em', HTMLElement).textContent = skipCopy[line.skip]
        }
        keywordCount.textContent = fillCopy(keywordCountCopy, { count: line.count, limit: DEMO_PLAN.keywordLimit })
      }
    }

    panelListeners.push(key => {
      if (key === 'keywords') void playKeywords()
    })
    if (!keywordPanel.hidden) void playKeywords()

    /* ---------- 地图：中心 + 半径 + 网格间距 ---------- */
    const mapPanel = part(root, '[data-omm]', HTMLElement)
    const stage = part(mapPanel, '.om-stage', HTMLElement)
    const art = part(mapPanel, '[data-omm-art]', SVGGElement)
    const cover = part(mapPanel, '[data-omm-cover]', SVGCircleElement)
    const scan = part(mapPanel, '[data-omm-scan]', SVGCircleElement)
    const dots = part(mapPanel, '[data-omm-dots]', SVGGElement)
    const scaleBar = part(mapPanel, '[data-omm-scale]', HTMLElement)
    const scaleLabel = part(mapPanel, '[data-omm-scale-label]', HTMLElement)
    const radiusInput = part(mapPanel, '[data-omm-radius]', HTMLInputElement)
    const spacingInput = part(mapPanel, '[data-omm-spacing]', HTMLInputElement)
    const radiusValue = part(mapPanel, '[data-omm-radius-value]', HTMLElement)
    const spacingValue = part(mapPanel, '[data-omm-spacing-value]', HTMLElement)
    const readout = part(mapPanel, '[data-omm-readout]', HTMLElement)
    const sampleCount = part(mapPanel, '[data-omm-count]', HTMLElement)
    const pointCount = part(mapPanel, '[data-omm-points]', HTMLElement)
    const meter = part(mapPanel, '[data-omm-meter]', HTMLElement)
    const mapError = part(mapPanel, '[data-omm-error]', HTMLElement)
    const mapSubmit = part(mapPanel, '[data-omm-submit]', HTMLElement)
    const scaleCopy = copyOf(mapPanel, 'scale')
    let lastKey = ''
    let mapTouched = false

    const fillTrack = (input: HTMLInputElement) => {
      const min = Number(input.min)
      const max = Number(input.max)
      input.style.setProperty('--fill', `${((Number(input.value) - min) / (max - min)) * 100}%`)
    }

    const renderMap = (animate: boolean) => {
      const radius = Number(radiusInput.value)
      const spacing = Number(spacingInput.value)
      radiusValue.textContent = String(radius)
      spacingValue.textContent = String(spacing)
      fillTrack(radiusInput)
      fillTrack(spacingInput)
      const steps = mapGridSteps(radius, spacing)
      const total = MAP_DEMO.keywords.length * steps.length
      const over = total > MAP_SAMPLE_LIMIT

      // 底图随半径缩放（类似地图 setView），只动 transform；半径小于 3 km 时覆盖圆按比例缩小
      const unit = COVER / Math.max(radius, 3)
      art.style.transform = `scale(${(unit / 15).toFixed(4)})`
      cover.setAttribute('r', (radius * unit).toFixed(2))
      scan.setAttribute('r', Math.max(radius * unit, 8).toFixed(2))

      const px = stage.getBoundingClientRect().width / VIEW || 1
      let scaleKm = SCALE_STEPS_KM[0]
      for (const km of SCALE_STEPS_KM) if (km * unit * px <= SCALE_MAX_PX) scaleKm = km
      scaleBar.style.setProperty('--w', `${Math.round(scaleKm * unit * px)}px`)
      scaleLabel.textContent = fillCopy(scaleCopy, { value: scaleKm })

      sampleCount.textContent = String(total)
      pointCount.textContent = String(steps.length)
      meter.style.setProperty('--p', String(Math.min(1, total / MAP_SAMPLE_LIMIT)))
      readout.classList.toggle('is-over', over)
      stage.classList.toggle('is-over', over)
      mapError.hidden = !over
      mapSubmit.classList.toggle('is-disabled', over)

      // 超限时与 Dashboard 一样不画采样点；未超限时按由近及远的顺序逐个出现
      const key = `${radius}/${spacing}`
      if (over) {
        dots.classList.add('om-dots-out')
      } else if (key !== lastKey || dots.classList.contains('om-dots-out')) {
        dots.classList.remove('om-dots-out')
        dots.replaceChildren(
          ...steps.map((step, index) => {
            const dot = part(stamp(mapPanel, '[data-omm-dot-template]', SVGSVGElement), 'circle', SVGCircleElement)
            dot.setAttribute('cx', (CENTER + step.dx * spacing * unit).toFixed(2))
            dot.setAttribute('cy', (CENTER - step.dy * spacing * unit).toFixed(2))
            dot.style.setProperty('--i', String(animate ? index : 0))
            return dot
          })
        )
      }
      lastKey = key
      if (animate && !reduced) {
        scan.classList.remove('is-on')
        void scan.getBoundingClientRect()
        scan.classList.add('is-on')
      }
    }

    // 访客一动滑杆就停自动演示，读数开始播报
    const touchMap = () => {
      mapTouched = true
      readout.setAttribute('aria-live', 'polite')
    }
    for (const input of [radiusInput, spacingInput]) {
      input.addEventListener('input', () => {
        touchMap()
        renderMap(true)
      })
      input.addEventListener('pointerdown', touchMap)
      input.addEventListener('keydown', touchMap)
    }
    window.addEventListener('resize', () => renderMap(false))
    renderMap(false)

    // 自动演示：正常 → 缩小 → 超限被阻止 → 加大间距恢复 → 回到默认
    if (!reduced) {
      void (async () => {
        for (let step = 0; ; step = (step + 1) % MAP_DEMO.steps.length) {
          await waitPanel(mapPanel)
          if (mapTouched) return
          const [radius, spacing] = MAP_DEMO.steps[step]
          radiusInput.value = String(radius)
          spacingInput.value = String(spacing)
          renderMap(true)
          await wait(3000)
        }
      })()
    }

    /* ---------- 地区：城市 → 最终查询 ---------- */
    const regionPanel = part(root, '[data-omr]', HTMLElement)
    const places = part(regionPanel, '[data-omr-places]', HTMLElement)
    const nextCityLabel = part(regionPanel, '[data-omr-next]', HTMLElement)
    const addButton = part(regionPanel, '[data-omr-add]', HTMLButtonElement)
    const generateButton = part(regionPanel, '[data-omr-generate]', HTMLButtonElement)
    const queries = part(regionPanel, '[data-omr-queries]', HTMLElement)
    const queryCount = part(regionPanel, '[data-omr-count]', HTMLElement)
    const queryError = part(regionPanel, '[data-omr-error]', HTMLElement)
    const phrasingButtons = Array.from(regionPanel.querySelectorAll<HTMLButtonElement>('[data-omr-mode]'))
    const countCopy = copyOf(regionPanel, 'countLabel')
    const removeCopy = copyOf(regionPanel, 'remove')
    const cities = REGION_DEMO.cities
    let selected: string[] = []
    let phrasing: RegionPhrasing = 'in'
    let cursor = 0
    let regionTouched = false

    const nextCity = () => {
      for (let offset = 0; offset < cities.length; offset++) {
        const city = cities[(cursor + offset) % cities.length]
        if (!selected.includes(city)) return city
      }
      return null
    }

    const renderPlaces = () => {
      places.replaceChildren(
        ...selected.map(city => {
          const chip = stamp(regionPanel, '[data-omr-place-template]', HTMLElement)
          const label = regionPlace(city)
          part(chip, '[data-name]', HTMLElement).textContent = label
          const remove = part(chip, '[data-remove]', HTMLButtonElement)
          remove.setAttribute('aria-label', fillCopy(removeCopy, { name: label }))
          remove.addEventListener('click', () => {
            regionTouched = true
            selected = selected.filter(item => item !== city)
            renderPlaces()
          })
          return chip
        })
      )
      const upcoming = nextCity()
      nextCityLabel.textContent = upcoming ?? '—'
      addButton.disabled = !upcoming
    }

    const addCity = () => {
      const city = nextCity()
      if (!city) return
      selected.push(city)
      cursor = (cities.indexOf(city) + 1) % cities.length
      renderPlaces()
    }

    const setPhrasing = (mode: RegionPhrasing) => {
      phrasing = mode
      phrasingButtons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.omrMode === mode)))
    }

    const setQueryCount = (count: number) => {
      const over = count > DEMO_PLAN.keywordLimit
      queryCount.textContent = fillCopy(countCopy, { count, limit: DEMO_PLAN.keywordLimit })
      queryCount.classList.toggle('is-over', over)
      queryError.hidden = !over
    }

    const generate = () => {
      const list = regionQueries(selected, phrasing)
      queries.replaceChildren(
        ...list.map((query, index) => {
          const item = stamp(regionPanel, '[data-omr-query-template]', HTMLLIElement)
          item.style.setProperty('--i', String(index))
          part(item, 'span', HTMLElement).textContent = query
          return item
        })
      )
      setQueryCount(list.length)
    }

    const resetRegions = () => {
      selected = []
      cursor = 0
      setPhrasing('in')
      queries.replaceChildren()
      setQueryCount(0)
      renderPlaces()
    }

    addButton.addEventListener('click', () => {
      regionTouched = true
      addCity()
    })
    generateButton.addEventListener('click', () => {
      regionTouched = true
      generate()
    })
    phrasingButtons.forEach(button =>
      button.addEventListener('click', () => {
        regionTouched = true
        setPhrasing(button.dataset.omrMode === 'near' ? 'near' : 'in')
      })
    )

    resetRegions()
    if (reduced) {
      // 减弱动效：添加三个城市并生成查询后的终态
      for (let step = 0; step < 3; step++) addCity()
      generate()
      return
    }

    // 自动演示：逐个添加城市 → Generate queries；访客一操作就停
    void (async () => {
      for (;;) {
        await waitPanel(regionPanel)
        if (regionTouched) return
        resetRegions()
        for (let step = 0; step < 3; step++) {
          await wait(700)
          await waitPanel(regionPanel)
          if (regionTouched) return
          await press(addButton)
          addCity()
        }
        await wait(800)
        if (regionTouched) return
        await press(generateButton)
        generate()
        await wait(5200)
      }
    })()
  }

  const root = document.querySelector<HTMLElement>('[data-om]')
  if (root) initModes(root)
</script>

