---
/**
 * 工具页统一外壳（设计稿 place-id-finder.html，README §7「免费工具模板」）。
 *
 * 区块：① Hero（工具图标 + 面包屑眉标、H1 = 工具名、说明、工具面板）→ 用法区（guide 插槽：Place ID Finder 为
 * 三步用法 + 标识讲解，其余工具为 howTo 三节）→ 相关工具（排除当前工具）→ FAQ → 收尾 CTA。
 * 工具面板经默认插槽传入，各工具逻辑在 scripts/tools/ 前端执行；Email Checker 另调用后端验证接口。
 *
 * 埋点：进入 = 各工具脚本上报 tool_view；功能使用 = 主按钮 data-ga-event="tool_use"（全局点击委派）；
 * CTA 漏斗 = data-cta + 链接 utm。安装入口受 extensionInstall 开关控制（未交付时灰化，无链接与埋点）。
 */
import Layout from '../../layouts/Layout.astro'
import { getContent, type Locale } from '../../i18n/content'
import { localePaths } from '../../i18n/ui'
import type { ToolHowToSectionMessage, ToolPageMessage } from '../../i18n/schema'
import CapabilityAction from '../site/CapabilityAction.astro'
import Icon from '../site/Icon.astro'
import SplitWords from '../site/SplitWords.astro'
import { faqPageSchema } from '../product/faq-schema'
import ProductCta from '../product/ProductCta.astro'
import ProductFaq from '../product/ProductFaq.astro'
import ProductSectionHead from '../product/ProductSectionHead.astro'
import { TOOL_ICONS, headingText, type ToolId } from './tool-catalog'
import './tool-panel.css'

interface Props {
  /** 工具 ID（data-tool-page、埋点与相关工具排除用）。 */
  toolId: ToolId
  locale?: Locale
  /** 页面文案（SEO、首屏、FAQ、CTA）。 */
  content: ToolPageMessage
  /** HowTo 结构化数据的步骤，与页面用法区同源。 */
  howToSteps: readonly ToolHowToSectionMessage[]
  /** 客户端脚本文案载荷（JSON），注入根节点；Place ID Finder 的文案在面板 data-* 上，不传。 */
  copyJson?: string
}

const { toolId, locale = 'en-US', content, howToSteps, copyJson } = Astro.props
const t = getContent(locale)
const common = t.pages.tools.common
const tools = t.layout.footer.tools
const descriptions = t.pages.home.tools.descriptions
const current = tools.find(tool => tool.id === toolId)
if (!current) throw new Error(`[tool-shell] Unknown tool id: ${toolId}`)
const prefix = localePaths[locale] ? `/${localePaths[locale]}` : ''
// CTA 漏斗（015 feat「免费工具漏斗」）：站内链接带 utm 归因，事件侧用 data-cta。
const utm = `utm_source=website&utm_medium=tool-${toolId}`
const installHref = `${prefix}/extension/?${utm}&utm_campaign=install#install`
const pricingHref = `${prefix}/pricing/?${utm}&utm_campaign=pricing#extension`
const titleParts = [content.hero.title.lead, { text: content.hero.title.accent, class: 'accent text-grad is-animated' }, content.hero.title.tail]

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: headingText(content.hero.title),
  step: howToSteps.map(step => ({ '@type': 'HowToStep', name: step.heading, text: step.body }))
}
---

<Layout
  locale={locale}
  title={content.seo.title}
  description={content.seo.description}
  structuredData={[faqPageSchema(content.faq.items), howToSchema]}
  includeSoftwareApplicationSchema={false}
  preloadAccentFont
>
  <div data-tool-page={toolId}>
    {copyJson && <script is:inline type="application/json" data-tool-copy set:html={copyJson} />}

    <section class="page-hero page-hero--center tool-hero has-deco" data-inview>
      <div class="deco" aria-hidden="true">
        <div class="aurora"><i></i><i></i><i></i></div>
        <div class="bg-contours"></div>
        <div class="bg-grid"></div>
        <div class="noise"></div>
      </div>

      <div class="container">
        <div class="page-hero-copy">
          <div class="tool-eyebrow" data-enter>
            <span class="icon-tile icon-tile--brand"><Icon name={TOOL_ICONS[toolId]} /></span>
            <nav class="crumbs" aria-label={t.common.breadcrumbLabel}>
              <a href={`${prefix}/#tools`}>{common.crumbRoot}</a>
              <Icon name="chevron-right" />
              <span aria-current="page">{current.label}</span>
            </nav>
          </div>
          <h1 class="h1 tool-title" data-split="static" style="--split-delay: 80ms"><SplitWords parts={titleParts} /></h1>
          <p class="lead" data-enter style="--enter-delay: 160ms">{content.hero.description}</p>
        </div>

        <div class="page-hero-visual tool-stage" data-enter style="--enter-delay: 240ms">
          <slot />
        </div>
      </div>
    </section>

    <slot name="guide" />

    <section class="section tool-related" id="tools">
      <div class="container">
        <ProductSectionHead head={common.related} />
        <div class="tools-grid tools-grid--3" data-tools-grid data-spotlight-group data-stagger="60">
          {tools.filter(tool => tool.id !== toolId).map(tool => (
            <a
              class="tool-card card card-link card--lift"
              href={`${prefix}${tool.path}`}
              data-spotlight
              data-reveal
              data-cta={`tool-related-${tool.id}`}
              data-ga-event="internal_workflow_click"
              data-ga-source="tool_related"
              data-ga-target={`tool_${tool.id.replaceAll('-', '_')}`}
            >
              <span class="icon-tile"><Icon name={TOOL_ICONS[tool.id]} /></span>
              <span class="tool-go"><Icon name="arrow-up-right" /></span>
              <h3>{tool.label}</h3>
              <p>{descriptions[tool.id]}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <ProductFaq locale={locale} faq={{ ...common.faq, title: content.faq.title, items: content.faq.items }} />

    <ProductCta cta={{ ...common.cta, title: content.cta.title, lead: content.cta.lead }}>
      <CapabilityAction
        capability="extensionInstall"
        locale={locale}
        href={installHref}
        class="btn btn-primary btn-lg"
        data-magnetic="0.22"
        data-cta={`tool-${toolId}-install`}
      >
        <Icon name="puzzle" />{common.cta.primary}
      </CapabilityAction>
      <a class="btn btn-secondary btn-lg" href={pricingHref} data-cta={`tool-${toolId}-pricing`}>{common.cta.secondary}</a>
    </ProductCta>
  </div>
</Layout>

<style>
  /* 工具面板投影较深，Hero 底部比共享值多留一点 */
  .tool-hero {
    padding-bottom: clamp(64px, 7vw, 96px);
  }

  /* 眉标胶囊：工具图标 + 面包屑「Free tools › 工具名」 */
  .tool-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 4px 16px 4px 4px;
    border: 1px solid var(--border);
    border-radius: var(--r-full);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    box-shadow: var(--shadow-xs);
    backdrop-filter: blur(8px);
  }

  .tool-eyebrow .icon-tile {
    width: 30px;
    height: 30px;
    border-radius: 50%;
  }

  .tool-eyebrow .icon-tile :global(.icon) {
    width: 16px;
    height: 16px;
  }

  .tool-title {
    max-width: 920px;
  }

  .tool-stage {
    width: min(100%, 880px);
    margin-inline: auto;
  }

  /* 工具是本页主角：面板比共享居中 Hero 的视觉区更贴近说明，结果尽量留在首屏 */
  .tool-hero .tool-stage {
    margin-top: clamp(32px, 4vw, 48px);
  }

  /* 窄屏胶囊保持一行：工具名过长时截断 */
  @media (max-width: 640px) {
    .tool-eyebrow {
      gap: 8px;
      max-width: 100%;
      padding-right: 14px;
    }

    .tool-eyebrow .crumbs {
      flex-wrap: nowrap;
      min-width: 0;
      white-space: nowrap;
    }

    .tool-eyebrow .crumbs a {
      flex-shrink: 0;
    }

    .tool-eyebrow [aria-current] {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>
