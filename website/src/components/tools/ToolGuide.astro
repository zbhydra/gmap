---
/** 工具用法区（Place ID Finder 以外的工具）：howTo 三节逐字作为 SEO 正文，与 HowTo 结构化数据同源。 */
import type { ProductSectionHeadMessage, ToolHowToSectionMessage } from '../../i18n/schema'
import ProductSectionHead from '../product/ProductSectionHead.astro'

interface Props {
  head: ProductSectionHeadMessage
  sections: readonly ToolHowToSectionMessage[]
}

const { head, sections } = Astro.props
---

<section class="section band tool-guide" id="guide">
  <div class="container">
    <ProductSectionHead head={head} />
    <ol class="guide-grid" role="list" data-stagger="100" data-spotlight-group>
      {sections.map((section, index) => (
        <li class="card guide-card" data-spotlight data-reveal>
          <span class="guide-num">{String(index + 1).padStart(2, '0')}</span>
          <h3>{section.heading}</h3>
          <p>{section.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(40px, 5vw, 64px);
  }

  .guide-card {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 24px;
  }

  .guide-num {
    color: var(--primary-text);
    font-family: var(--font-mono);
    font-variant-ligatures: none;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .guide-card h3 {
    font-size: var(--fs-lead);
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .guide-card p {
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.7;
  }

  @media (max-width: 960px) {
    .guide-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
