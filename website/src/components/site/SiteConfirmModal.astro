---
/**
 * Website 通用确认弹窗（原生 <dialog class="modal dlg">）。
 *
 * 页面脚本通过 site/confirm.ts 写入标题、正文和按钮文案；组件只提供稳定 DOM，
 * 版式走组件目录的 .dlg（基础层），模态焦点与 Esc 由原生 dialog 负责。
 */
import { getContent, type Locale } from '../../i18n/content'

interface Props {
  locale?: Locale
}

const { locale = 'en-US' } = Astro.props as Props
const copy = getContent(locale).common
---

<dialog
  class="modal dlg"
  data-site-confirm-modal
  aria-labelledby="site-confirm-title"
  aria-describedby="site-confirm-message"
>
  <div class="dlg-body">
    <button
      type="button"
      class="icon-btn icon-btn--sm dlg-close"
      data-site-confirm-cancel
      aria-label={copy.cancel}
    >
      <svg class="icon" aria-hidden="true"><use href="/img/icons.svg#i-x" /></svg>
    </button>
    <span class="dlg-icon" aria-hidden="true">
      <svg class="icon"><use href="/img/icons.svg#i-alert" /></svg>
    </span>
    <div class="dlg-copy">
      <h2 class="dlg-title" id="site-confirm-title" data-site-confirm-title></h2>
      <p class="dlg-msg" id="site-confirm-message" data-site-confirm-message></p>
    </div>
    <div class="dlg-actions">
      <button type="button" class="btn btn-secondary btn-sm" data-site-confirm-cancel data-site-confirm-dismiss>
        {copy.cancel}
      </button>
      <button type="button" class="btn btn-primary btn-sm" data-site-confirm-submit>
        {copy.continue}
      </button>
    </div>
  </div>
</dialog>

<script>
  import '../../scripts/site/confirm'
</script>
