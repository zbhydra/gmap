# 生产环境变量（占位：正式域名/项目确定后回填，部署时经 deploy.sh 显式注入构建）
PUBLIC_API_BASE_URL="https://api.mapexporter.app"
PUBLIC_GOOGLE_CLIENT_ID=
PUBLIC_SHARED_COOKIE_DOMAIN="mapexporter.app"
# GA4 measurement ID（G- 开头，hydra 后配）；为空时全站零注入 gtag
PUBLIC_GA4_MEASUREMENT_ID=
PUBLIC_ALI_SLS_PROJECT=gmap
PUBLIC_ALI_SLS_HOST=ap-northeast-1.log.aliyuncs.com
PUBLIC_ALI_SLS_LOGSTORE=gmap-mark-logs
PUBLIC_ALI_SLS_TOPIC=mark-log

PUBLIC_SITE_URL="https://mapexporter.app"
DEPLOY_SERVER_HOST="8.216.50.123"
DEPLOY_SERVER_PORT="22"
DEPLOY_SERVER_USER="root"
DEPLOY_SERVER_ROOT="/data/mapexporter-web"
DEPLOY_NGINX_REMOTE_CONF="/usr/local/nginx/vhost/mapexporter.conf"
