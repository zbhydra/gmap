---
/**
 * Bulk Keywords Generator 工具页（W4，关键词 × 地点组合批量生成）。
 */
import ToolShell from '../../components/tools/ToolShell.astro'
import { getContent } from '../../i18n/content'

const t = getContent('en-US')
const tool = t.pages.tools.bulkKeywords
const copyJson = JSON.stringify({ common: t.pages.tools.common, content: tool })
---

<ToolShell
  toolId="bulk-keywords-generator"
  seo={tool.seo}
  hero={tool.hero}
  howTo={tool.howTo}
  faq={tool.faq}
  cta={tool.cta}
  copyJson={copyJson}
  commonCopy={t.pages.tools.common}
>
  <form class="tool-field" data-tool-form>
    <label for="keywords-input">{tool.form.keywordsLabel}</label>
    <textarea
      class="tool-textarea"
      id="keywords-input"
      data-keywords
      placeholder={tool.form.keywordsPlaceholder}
      spellcheck="false"></textarea>
    <label for="locations-input">{tool.form.locationsLabel}</label>
    <textarea
      class="tool-textarea"
      id="locations-input"
      data-locations
      placeholder={tool.form.locationsPlaceholder}
      spellcheck="false"></textarea>
    <label for="order-input">{tool.form.orderLabel}</label>
    <select class="tool-input" id="order-input" data-order>
      <option value="keyword-first" selected>{tool.form.keywordFirst}</option>
      <option value="location-first">{tool.form.locationFirst}</option>
    </select>
    <p class="tool-error" data-tool-error hidden></p>
    <div class="tool-actions">
      <button class="tool-button" type="submit" data-ga-event="tool_use" data-ga-tool-id="bulk-keywords">
        {tool.form.submit}
      </button>
    </div>
  </form>

  <section class="tool-result" data-tool-result hidden aria-label={t.pages.tools.common.resultHeading}>
    <h2>{t.pages.tools.common.resultHeading}</h2>
    <p class="tool-summary" data-count-summary></p>
    <textarea class="tool-textarea" data-combinations readonly spellcheck="false"></textarea>
    <div class="tool-actions">
      <button
        class="tool-secondary-button"
        type="button"
        data-copy-combinations
        data-ga-event="tool_copy"
        data-ga-tool-id="bulk-keywords"
      >
        {t.pages.tools.common.copy}
      </button>
      <button
        class="tool-secondary-button"
        type="button"
        data-download-combinations
        data-ga-event="tool_download"
        data-ga-tool-id="bulk-keywords"
      >
        {t.pages.tools.common.downloadCsv}
      </button>
    </div>
  </section>
</ToolShell>

<script src="../../scripts/tools/bulkKeywords.ts"></script>
