---
/**
 * Convert Lat Long to DMS 工具页（W4，十进制度 → 度分秒）。
 */
import ToolShell from '../../components/tools/ToolShell.astro'
import { getContent } from '../../i18n/content'

const t = getContent('en-US')
const tool = t.pages.tools.latLongToDms
const copyJson = JSON.stringify({ common: t.pages.tools.common, content: tool })
---

<ToolShell
  toolId="lat-long-to-dms"
  seo={tool.seo}
  hero={tool.hero}
  howTo={tool.howTo}
  faq={tool.faq}
  cta={tool.cta}
  copyJson={copyJson}
  commonCopy={t.pages.tools.common}
>
  <form class="tool-field" data-tool-form>
    <label for="latitude-input">{tool.form.latitudeLabel}</label>
    <input
      class="tool-input"
      id="latitude-input"
      name="latitude"
      type="text"
      inputmode="decimal"
      placeholder={tool.form.placeholder}
      autocomplete="off"
      spellcheck="false"
      data-latitude
    />
    <label for="longitude-input">{tool.form.longitudeLabel}</label>
    <input
      class="tool-input"
      id="longitude-input"
      name="longitude"
      type="text"
      inputmode="decimal"
      placeholder="-122.419416"
      autocomplete="off"
      spellcheck="false"
      data-longitude
    />
    <p class="tool-error" data-tool-error hidden></p>
    <div class="tool-actions">
      <button class="tool-button" type="submit" data-ga-event="tool_use" data-ga-tool-id="lat-long-to-dms">
        {tool.form.submit}
      </button>
    </div>
  </form>

  <section class="tool-result" data-tool-result hidden aria-label={t.pages.tools.common.resultHeading}>
    <h2>{t.pages.tools.common.resultHeading}</h2>
    <div class="tool-result-row">
      <label for="dms-value">{tool.result.dms}</label>
      <div class="tool-output">
        <output class="tool-output-value" id="dms-value" data-dms-value></output>
        <button
          class="tool-secondary-button"
          type="button"
          data-copy-dms
          data-ga-event="tool_copy"
          data-ga-tool-id="lat-long-to-dms"
        >
          {t.pages.tools.common.copy}
        </button>
      </div>
    </div>
  </section>
</ToolShell>

<script src="../../scripts/tools/latLongToDms.ts"></script>
