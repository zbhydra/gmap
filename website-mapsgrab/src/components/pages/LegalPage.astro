---
/**
 * Legal document page.
 *
 * Render flow:
 * route -> legal content fallback -> semantic article/sections -> Layout SEO/schema.
 */
import Layout from '../../layouts/Layout.astro'
import { getLegalPageContent, type LegalPageKind } from '../../legal/legalContent'
import { type Locale } from '../../i18n/content'

interface Props {
  /** Current locale route. */
  locale?: Locale
  /** Which legal page to render. */
  pageKind: LegalPageKind
}

const { locale = 'en-US', pageKind } = Astro.props as Props
const page = getLegalPageContent(locale, pageKind)
const normalizePathname = (pathname: string) => {
  if (pathname === '' || pathname === '/') {
    return '/'
  }

  return pathname.endsWith('/') ? pathname : `${pathname}/`
}
const pageUrl = new URL(normalizePathname(Astro.url.pathname), Astro.site).href
const sectionAnchor = (title: string) => title.toLowerCase().replaceAll(/[^a-z0-9]+/g, '-')
const legalSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  url: pageUrl,
  name: page.title,
  description: page.seoDescription,
  // 正式法务内容的最后修改日期，与正文 updatedAt 同源（legalContent.updatedAtISO）。
  dateModified: page.updatedAtISO,
  publisher: {
    '@type': 'Organization',
    name: 'MapsGrab',
    url: new URL('/', Astro.site).href
  }
}
---

<Layout
  locale={locale}
  title={page.seoTitle}
  description={page.seoDescription}
  includeSoftwareApplicationSchema={false}
  structuredData={[legalSchema]}
>
  <article class="legal-page" data-legal-page data-legal-page-kind={pageKind}>
    <div class="container">
      <header class="legal-header">
        <p class="legal-eyebrow">{page.navLabel}</p>
        <h1>{page.title}</h1>
        <p class="legal-intro">{page.intro}</p>
        <p class="legal-updated">{page.updatedLabel}: <time datetime={page.updatedAtISO}>{page.updatedAt}</time></p>
      </header>

      <div class="legal-layout">
        <div class="legal-content">
          {page.sections.map(section => (
            <section class="legal-section" id={sectionAnchor(section.title)}>
              <h2>{section.title}</h2>
              {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
              {section.items && (
                <ul>
                  {section.items.map(item => <li>{item}</li>)}
                </ul>
              )}
            </section>
          ))}
        </div>

        <nav class="legal-toc" aria-label={page.navLabel}>
          {page.sections.map(section => (
            <a href={`#${sectionAnchor(section.title)}`}>{section.title}</a>
          ))}
        </nav>
      </div>
    </div>
  </article>
</Layout>

<style>
  .legal-page {
    padding: var(--space-16) 0 var(--space-24);
  }

  .legal-header {
    max-width: 820px;
    margin-bottom: var(--space-10);
  }

  .legal-eyebrow {
    color: var(--primary);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    line-height: 16px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .legal-header h1 {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: clamp(34px, 4.2vw, 50px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--text);
  }

  .legal-intro {
    max-width: 760px;
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.75;
  }

  .legal-updated {
    margin-top: var(--space-4);
    color: var(--text-2);
    font-size: 14px;
  }

  .legal-layout {
    display: grid;
    grid-template-columns: minmax(0, 820px) 240px;
    gap: var(--space-16);
    align-items: start;
  }

  .legal-content {
    display: grid;
    gap: var(--space-8);
  }

  .legal-section {
    padding-top: var(--space-8);
    border-top: 1px solid var(--border);
    scroll-margin-top: 110px;
  }

  .legal-section h2 {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 32px;
    letter-spacing: -0.015em;
    color: var(--text);
  }

  .legal-section p {
    margin-top: var(--space-3);
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.85;
  }

  .legal-section ul {
    margin-top: var(--space-3);
    padding-left: 20px;
  }

  .legal-section li {
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.85;
  }

  .legal-toc {
    position: sticky;
    top: 112px;
    display: grid;
    gap: var(--space-2);
    padding-left: var(--space-4);
    border-left: 1px solid var(--border);
  }

  .legal-toc a {
    color: var(--text-3);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.45;
  }

  .legal-toc a:hover,
  .legal-toc a:focus-visible {
    color: var(--link);
  }

  @media (max-width: 900px) {
    .legal-page {
      padding: var(--space-10) 0 var(--space-16);
    }

    .legal-layout {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .legal-toc {
      position: static;
      order: -1;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      padding: var(--space-3) 0 var(--space-4);
      border-left: 0;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
  }

  @media (max-width: 560px) {
    .legal-toc {
      grid-template-columns: 1fr;
    }
  }
</style>
