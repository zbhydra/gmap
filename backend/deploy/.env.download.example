# tg-download 下载节点部署环境配置模板。
#
# 用法：
#   cp backend/deploy/.env.download.example backend/deploy/.env.download
#   bash backend/deploy/download_init.sh backend/deploy/.env.download sg-1
#   bash backend/deploy/download_deploy.sh backend/deploy/.env.download
#   bash backend/deploy/download_deploy.sh backend/deploy/.env.download sg-1
#
# 真实 .env.download 含下载 token 公钥，不入 git。

###############################################################################
# 1. 下载节点数组
###############################################################################

# 每个 id 对应一个 DOWNLOAD_NODE_<id> 数组；变量名里的 - 写成 _。
# 例如 id=sg-1 对应 DOWNLOAD_NODE_sg_1。
DOWNLOAD_NODE_IDS=(
  "sg-1"
  "us-1"
)

DOWNLOAD_NODE_sg_1=(
  "server_host=203.0.113.10"
  "server_port=22"
  "server_user=root"
  "ssh_private_key_path="
  "app_name=tg-download-node-sg-1"
  "deploy_dir=/data/tg-download-node/sg-1/"
  "backup_dir=/data/tg-download-node/sg-1/.backups/"
  "keep_versions=5"
  "backend_port_py=9600"
  "nginx_server_name=dl-sg-1.example.com"
  "public_api_base_url=https://dl-sg-1.example.com"
  "public_website_base_url=https://telegramdownloadmedia.com"
  "redis_host=127.0.0.1"
  "redis_port=6379"
  "redis_password="
  "redis_key_prefix=tg-download-node-sg-1"
)

DOWNLOAD_NODE_us_1=(
  "server_host=203.0.113.11"
  "server_port=22"
  "server_user=root"
  "ssh_private_key_path="
  "app_name=tg-download-node-us-1"
  "deploy_dir=/data/tg-download-node/us-1/"
  "backup_dir=/data/tg-download-node/us-1/.backups/"
  "keep_versions=5"
  "backend_port_py=9600"
  "nginx_server_name=dl-us-1.example.com"
  "public_api_base_url=https://dl-us-1.example.com"
  "public_website_base_url=https://telegramdownloadmedia.com"
  "redis_host=127.0.0.1"
  "redis_port=6379"
  "redis_password="
  "redis_key_prefix=tg-download-node-us-1"
)

###############################################################################
# 2. Git 仓库
###############################################################################

REPO_URL="git@github.com:zbhydra/extension-tg-download.git"
BRANCH="main"

###############################################################################
# 3. 运行日志
###############################################################################

# 下载节点后端运行日志级别；正式环境建议 WARNING，避免普通 INFO 请求日志刷 supervisor。
# 如需单节点覆盖，可在 DOWNLOAD_NODE_<id> 数组里添加 "logger_level=INFO"。
LOGGER_LEVEL="WARNING"

###############################################################################
# 4. 下载 token 验签配置
###############################################################################

DOWNLOAD_TOKEN_ALGORITHM="EdDSA"
DOWNLOAD_TOKEN_PUBLIC_KEYS='
    - "-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEAUFmJ0+g9eYBq5C/GsuLQhHXd7jyCjzjfojZcfveDuxc=\n-----END PUBLIC KEY-----\n"
'
# 必须与 business 服务器的 RESOURCE_TOKEN_SECRET 完全一致。
RESOURCE_TOKEN_SECRET="3Da0lIT8iN9iMuf0dPOJNACbubPaQWc+C5gqwNyzMqYBR+Ksk9MU8qy86P+nGx5L"
# 必须与 business 服务器的 SERVICE_NODE_INTERNAL_AUTH_TOKEN 完全一致。
SERVICE_NODE_INTERNAL_AUTH_TOKEN="RmY0R2pJ7V6vQxk9x2Z6bQn9D2uYpLwSxkM8cAa1bTqE"

###############################################################################
# 5. Telegram API 使用 backend/config.download.yaml.example 模板值。
