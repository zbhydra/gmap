# gmap 生产部署配置。生产服务器/域名尚未确定，下面的 CHANGE_ME 必须全部回填后才可部署。
#
# 用法：
#   bash backend/deploy/init.sh   backend/deploy/.env.prod [--force]   # 首次初始化
#   bash backend/deploy/deploy.sh backend/deploy/.env.prod             # 日常发版
#   bash backend/deploy/health_check.sh backend/deploy/.env.prod
#
# 生产准备清单见 docs/项目初次发布需要完善内容.md。

###############################################################################
# 1. SSH 连接
###############################################################################

SERVER_HOST="8.216.50.123"
SERVER_PORT="22"
SERVER_USER="root"
SSH_PRIVATE_KEY_PATH=""

###############################################################################
# 2. Git 仓库
###############################################################################

REPO_URL="git@github.com:zbhydra/gmap.git"
BRANCH="main"

###############################################################################
# 3. 部署目录
###############################################################################

# 脚本按 <DEPLOY_DIR>/backend 使用。
DEPLOY_DIR="/data/gmap/"
BACKUP_DIR="/data/gmap/.backups/"
KEEP_VERSIONS="5"

###############################################################################
# 4. 数据库与 Redis
###############################################################################

DB_HOST=""
DB_USER=""
DB_PASSWD=""
DB_NAME=""
DB_POOL_SIZE="50"
DB_MAX_OVERFLOW="100"

# 生产必须使用独立 Redis 实例，不能与测试环境共用。
REDIS_HOST=""
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_POOL_SIZE="5000"

###############################################################################
# 5. 对外地址与 Google 登录
###############################################################################

APP_NAME="gmap-server"
APP_ENV="production"
EXPORT_RUN_CONCURRENCY="8"
LOGGER_LEVEL="WARNING"
# CHANGE_ME：回填生产域名后，MCP 公开地址与 Host/Origin 白名单由这两个值派生。
PUBLIC_API_BASE_URL="https://api.mapexporter.app"
PUBLIC_WEBSITE_BASE_URL="https://mapexporter.app"
# 每个环境独立生成；不得复用测试服或模板中的示例值。
JWT_SECRET_KEY=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

FEISHU_ALARM_ENABLED="false"
FEISHU_ALARM_WEBHOOK_URL=""

###############################################################################
# 6. SMTP
###############################################################################

SMTP_CONFIG=""

###############################################################################
# 7. 进程与 Nginx
###############################################################################

BACKEND_PORT_PY="9600"
# CHANGE_ME：回填生产 API 域名。
NGINX_SERVER_NAME="api.mapexporter.app"
