# tg-download deploy 环境配置模板（hydra 2026-04-30 决策：deploy 脚本接受 .env.* 参数）。
#
# 用法：
#   cp .env.example .env.test       # 测试环境
#   cp .env.example .env.prod       # 生产环境
#   # 填好下面的值后跑：
#   bash backend/deploy/init.sh   .env.test       # 首次部署
#   bash backend/deploy/deploy.sh .env.test       # Python 日常发版
#   bash backend/deploy/health_check.sh .env.test       # Python 健康检查
#
# 设计：纯 shell `KEY=VALUE` 风格（最简；deploy 脚本 `source` 直接读）；
# 不依赖 yq / jq；注释用 `#`；值含空格或特殊字符必须加引号。
#
# 安全：.env.test / .env.prod / .env.staging 等真实文件**不入 git**（.gitignore 已加）；
# 仅本模板 `.env.example` commit。secret 填在真实 .env 文件，由部署运维 1:1 与服务器同步。

###############################################################################
# 1. SSH 连接（init.sh / deploy.sh / health_check.sh 共用）
###############################################################################

# 服务器 IP 或域名
SERVER_HOST="149.71.241.52"

# SSH 端口
SERVER_PORT="2222"

# SSH 用户
SERVER_USER="root"

# SSH 私钥路径（绝对路径；优先级最高）；留空 → 走 ~/.ssh/id_ed25519 或 ~/.ssh/id_rsa
# 也可改用 SSH_PASSWORD（不推荐；详 backend/deploy/README.md）
SSH_PRIVATE_KEY_PATH=""

###############################################################################
# 2. Git 仓库（init.sh 用；deploy.sh 不调）
###############################################################################

REPO_URL="git@github.com:zbhydra/extension-tg-download.git"
BRANCH="main"

###############################################################################
# 3. 部署目录（init.sh / deploy.sh 共用）
###############################################################################

# 远端部署根目录（必带尾 /）
DEPLOY_DIR="/data/extension-tg-download/"

# 备份目录（deploy.sh 用）
BACKUP_DIR="/data/extension-tg-download/.backups/"

# 保留备份版本数
KEEP_VERSIONS="5"

###############################################################################
# 4. 数据库（init.sh / deploy.sh 写入 backend/config.yaml）
###############################################################################

DB_HOST="127.0.0.1"
DB_USER="gmap"
DB_PASSWD="1111111"
DB_NAME="gmap"

# Redis 连接（可选；缺省走本机 127.0.0.1:6379 无密码，写入 backend/config.yaml）。
# 多套环境共用同一 Redis 时，靠 APP_NAME 隔离 key 前缀，不要靠改 db 编号区分。
REDIS_HOST="127.0.0.1"
REDIS_PORT="6379"
REDIS_PASSWORD=""

###############################################################################
# 5. 对外地址与 Google 登录（init.sh / deploy.sh 写入 backend/config.yaml）
###############################################################################

APP_NAME="gmap-server"
# 后端运行日志级别；正式环境建议 WARNING，避免普通 INFO 请求日志刷 supervisor。
LOGGER_LEVEL="WARNING"
PUBLIC_API_BASE_URL="https://api.example.com"
PUBLIC_WEBSITE_BASE_URL="https://www.example.com"
GOOGLE_CLIENT_ID="691520581257-16u51bd6kdal9ms3jafamlu7n4jgr2rc.apps.googleusercontent.com"
# 可选：仅新自定义 Google 按钮 OAuth code flow 需要；留空不影响 One Tap 和旧 callback。
GOOGLE_CLIENT_SECRET=""

# Telegram Stars bot token、webhook secret、Bot API 地址和 webhook 公网地址不写在 .env。
# 请部署后写入 DB: config_payment_channel.channel_code='telegram_stars' 的 config_json，
# 再执行: cd backend && uv run python deploy/script/register_telegram_webhook.py



###############################################################################
# 7. SMTP（init.sh / deploy.sh 写入 backend/config.yaml）
###############################################################################

SMTP_CONFIG='
smtp:
  - host: "smtp.resend.com"
    port: 587
    username: "resend"
    password: "CHANGE_ME"
    use_tls: true
    from_email: "validation@example.com"
    from_name: "TG Download"
    timeout: 5
    weight: 100
  - host: "smtp.resend.com"
    port: 587
    username: "resend"
    password: "CHANGE_ME"
    use_tls: true
    from_email: "validation2@example.com"
    from_name: "TG Download"
    timeout: 5
    weight: 100
'

###############################################################################
# 8. 业务后端进程与 Nginx（init.sh / deploy.sh / health_check.sh 用）
###############################################################################

# Python uvicorn 端口。部署端口与本地开发端口（backend/config.yaml 的 7600）相互独立，
# 按服务器实际规划填写；部署脚本无默认值，漏填直接报错。
BACKEND_PORT_PY="9600"

# 业务 API Nginx 只监听 80，HTTPS 由外层 CL 代理终止。
NGINX_SERVER_NAME="tg-download-api.telegramdownloadmedia.com"
