app:
  name: "{APP_NAME}"
  version: "0.1.0"
  host: "0.0.0.0"
  port: {BACKEND_PORT_PY}
  debug: false
  env: "{APP_ENV}"
  export_run_concurrency: {EXPORT_RUN_CONCURRENCY}
  export_queue_limit: 1000
  public_api_base_url: "{PUBLIC_API_BASE_URL}"
  public_website_base_url: "{PUBLIC_WEBSITE_BASE_URL}"

database:
  host: "{DB_HOST}"
  port: 3306
  user: "{DB_USER}"
  password: "{DB_PASSWD}"
  database: "{DB_NAME}"
  pool_size: {DB_POOL_SIZE}
  max_overflow: {DB_MAX_OVERFLOW}

logging:
  level: "{LOGGER_LEVEL}"
  format: "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  file: "log/app.log"

api:
  title: "gmap-api"
  description: "API for gmap application"
  version: "0.1.0"
  docs_url: "/docs"
  redoc_url: "/redoc"

auth:
  jwt_secret_key: "{JWT_SECRET_KEY}"
  jwt_algorithm: "HS256"
  google_client_id: "{GOOGLE_CLIENT_ID}"
  # 可选：仅新自定义 Google 按钮 OAuth code flow 需要，留空不影响 One Tap 和旧 callback。
  google_client_secret: "{GOOGLE_CLIENT_SECRET}"
  access_token_expire: 2592000
  refresh_token_expire: 5184000
  refresh_token_remember_days: 30
  max_login_attempts: 5
  lock_duration_minutes: 30
  rate_limit_times: 10
  rate_limit_period: 60

admin:
  access_token_expire: 1800
  refresh_token_expire: 604800

redis:
  host: "{REDIS_HOST}"
  port: {REDIS_PORT}
  db: 0
  password: {REDIS_PASSWORD}
  pool_size: {REDIS_POOL_SIZE}
  pool_timeout: 5
  key_prefix: "gmapsexporter"
  socket_timeout: 5
  socket_connect_timeout: 5
  retry_on_timeout: true
  retry_attempts: 3

feishu_alarm:
  enabled: {FEISHU_ALARM_ENABLED}
  # 真实群机器人 webhook 由 .env 的 FEISHU_ALARM_WEBHOOK_URL 注入；远端 config.yaml 每次发布整份覆盖，
  # 不要在这里写字面量，也不要直接在服务器上改。留空时 send_feishu_alarm 静默跳过。
  webhook_url: "{FEISHU_ALARM_WEBHOOK_URL}"
  timeout_seconds: 5

{SMTP_CONFIG}
